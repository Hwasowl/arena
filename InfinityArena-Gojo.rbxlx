			<Item class="ModuleScript" referent="RBX4D517FF99E303DC30FE108C681D1C1E6">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Uchiha Itachi on the client: slim first-person hands with jointed fingers and purple nails inside wide Akatsuki
-- sleeves (red clouds, red lining), the seal / face / sleeve-grip / point poses, the Mangekyo overlay, camera work for
-- each technique (including the Susanoo cinematic), the crow-clone dissolve, and the victim's side: the Tsukuyomi
-- world (only on the victim's own screen) and the view from inside the Totsuka seal.
-- Gojo.client.luau owns input and the shared HUD; it forwards Itachi* events here and asks for the arm pose every
-- frame. All judgement stays on the server.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local UIS=game:GetService("UserInputService")
local Lighting=game:GetService("Lighting")
local I=require(RS:WaitForChild("ItachiConfig"))
local VFX=require(RS:WaitForChild("ItachiVFX"))
local COLORS=I.Colors
local player=Players.LocalPlayer
local smoothstep,window,bump=VFX.smoothstep,VFX.window,VFX.bump
local function clock() return workspace:GetServerTimeNow() end
local function lerp(a,b,t) return a+(b-a)*t end

local ItachiClient={}
local env
local cast=nil            -- own technique in progress: {kind, start, data}
local crow=nil            -- own crow clone in progress
local victim=nil          -- something being done to us: {kind="Tsukuyomi"|"Seal", start, owner}
local combo={untilTime=0,text="",key=nil}
local shake={untilTime=0,power=0,duration=.1}
local revealed={}

---------------------------------------------------------------- arms
-- Hand frame: origin at the wrist, +Y toward the knuckles, palm facing -Z. The sleeve hangs open around the wrist.
local arms={}
local SKIN,CLOAK,LINING,NAIL=COLORS.Skin,COLORS.Cloak,Color3.fromRGB(150,10,16),COLORS.Nail
local function vmPart(model,name,size,color,shape,material)
    local p=Instance.new("Part");p.Name=name;p.Size=size;p.Color=color;p.Shape=shape or Enum.PartType.Block
    p.Material=material or Enum.Material.SmoothPlastic;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
    p.CastShadow=false;p.Transparency=1;p.Parent=model
    return p
end
local FINGERS={{x=.052,a=.072,b=.05,c=.04},{x=.018,a=.078,b=.054,c=.042},{x=-.017,a=.074,b=.05,c=.04},{x=-.05,a=.062,b=.042,c=.035}}
local function buildArm(side)
    local m=Instance.new("Model");m.Name=side>0 and "ItachiRightArm" or "ItachiLeftArm";m.Parent=env.viewmodel
    local a={side=side,thumbSide=side>0 and -1 or 1,model=m,fingers={},order={},k=1}
    a.palm=vmPart(m,"Palm",Vector3.new(.15,.17,.06),SKIN)
    for i,f in FINGERS do
        local fp={def=f,a=vmPart(m,"Finger",Vector3.new(.034,f.a,.034),SKIN),b=vmPart(m,"Finger",Vector3.new(.031,f.b,.031),SKIN),
            c=vmPart(m,"Finger",Vector3.new(.028,f.c,.028),SKIN),nail=vmPart(m,"Nail",Vector3.new(.026,.016,.012),NAIL)}
        a.fingers[i]=fp
    end
    a.thumb={a=vmPart(m,"Thumb",Vector3.new(.038,.06,.038),SKIN),b=vmPart(m,"Thumb",Vector3.new(.034,.05,.034),SKIN),nail=vmPart(m,"Nail",Vector3.new(.03,.016,.012),NAIL)}
    a.wrist=vmPart(m,"Wrist",Vector3.new(.3,.11,.11),SKIN,Enum.PartType.Cylinder)
    a.sleeve=vmPart(m,"Sleeve",Vector3.new(.95,.4,.4),CLOAK,Enum.PartType.Cylinder)
    a.lining=vmPart(m,"SleeveLining",Vector3.new(.04,.37,.37),LINING,Enum.PartType.Cylinder)
    a.clouds={}
    for i=1,3 do
        table.insert(a.clouds,{rim=vmPart(m,"CloudRim",Vector3.new(.012,.15,.15),COLORS.CloudRim,Enum.PartType.Cylinder),
            red=vmPart(m,"Cloud",Vector3.new(.014,.12,.12),COLORS.Cloud,Enum.PartType.Cylinder),at=({-.25,-.48,-.66})[i],h=({.02,.07,-.05})[i]})
    end
    a.upper=vmPart(m,"UpperSleeve",Vector3.new(1,.42,.42),CLOAK,Enum.PartType.Cylinder)
    -- Dissolve order for the crow clone: fingertips first, the sleeve last.
    for i=4,1,-1 do table.insert(a.order,a.fingers[i].nail);table.insert(a.order,a.fingers[i].c) end
    table.insert(a.order,a.thumb.nail);table.insert(a.order,a.thumb.b)
    for i=4,1,-1 do table.insert(a.order,a.fingers[i].b) end
    table.insert(a.order,a.thumb.a);for i=4,1,-1 do table.insert(a.order,a.fingers[i].a) end
    for _,p in {a.palm,a.wrist,a.lining} do table.insert(a.order,p) end
    for _,c in a.clouds do table.insert(a.order,c.red);table.insert(a.order,c.rim) end
    table.insert(a.order,a.sleeve);table.insert(a.order,a.upper)
    return a
end
local function handFrame(position,fingerDir,palmNormal)
    local y=fingerDir.Unit
    local z=-(palmNormal-y*palmNormal:Dot(y))
    if z.Magnitude<.01 then z=Vector3.zAxis end
    z=z.Unit
    return CFrame.fromMatrix(position,y:Cross(z),y,z)
end
local ALONG=CFrame.Angles(0,0,math.pi/2)
-- pose: {frame, curl (number or per finger, thumb 5th), shoulder}
local function poseArm(a,pose,visible)
    local cam=workspace.CurrentCamera.CFrame
    local world=cam*pose.frame
    local shown={}
    local count=#a.order;local keep=math.floor(a.k*count+.5)
    for i,p in a.order do shown[p]=i>count-keep end
    local function put(p,cf) p.CFrame=cf;p.Transparency=(visible and shown[p]) and 0 or 1 end
    put(a.palm,world*CFrame.new(0,.085,0))
    for i,f in a.fingers do
        local d=f.def
        local c=math.clamp(type(pose.curl)=="table" and pose.curl[i] or pose.curl or 0,0,1)
        local base=world*CFrame.new(d.x*a.thumbSide,.17,0)
        local pa=base*CFrame.Angles(-c*1.45,0,0)
        put(f.a,pa*CFrame.new(0,d.a/2,0))
        local pb=pa*CFrame.new(0,d.a,0)*CFrame.Angles(-c*1.6,0,0)
        put(f.b,pb*CFrame.new(0,d.b/2,0))
        local pc=pb*CFrame.new(0,d.b,0)*CFrame.Angles(-c*1.1,0,0)
        put(f.c,pc*CFrame.new(0,d.c/2,0))
        put(f.nail,pc*CFrame.new(0,d.c-.008,.012))
    end
    local tc=math.clamp(type(pose.curl)=="table" and pose.curl[5] or pose.curl or 0,0,1)
    local thumb=world*CFrame.new(a.thumbSide*.075,.05,-.02)*CFrame.Angles(0,0,-a.thumbSide*(.8-.6*tc))*CFrame.Angles(-.3-tc*.7,0,0)
    put(a.thumb.a,thumb*CFrame.new(0,.03,0))
    local tip=thumb*CFrame.new(0,.06,0)*CFrame.Angles(-tc*.9,0,0)
    put(a.thumb.b,tip*CFrame.new(0,.025,0))
    put(a.thumb.nail,tip*CFrame.new(0,.042,.014))
    put(a.wrist,world*CFrame.new(0,-.1,0)*ALONG)
    -- The sleeve opens around the wrist (it never hides the hand) and runs back toward the elbow.
    local sleeve=world*CFrame.new(0,-.62,0)
    put(a.sleeve,sleeve*ALONG)
    put(a.lining,world*CFrame.new(0,-.15,0)*ALONG)
    for _,c in a.clouds do
        local at=world*CFrame.new(a.side*.2,c.at,c.h)
        put(c.rim,at*CFrame.Angles(0,0,0))
        put(c.red,at*CFrame.new(a.side*.003,0,0))
    end
    local elbow=(world*CFrame.new(0,-1.08,0)).Position
    local shoulder=(cam*CFrame.new(pose.shoulder or Vector3.new(a.side*.85,-1.15,.2))).Position
    local span=shoulder-elbow
    if span.Magnitude>.05 then
        a.upper.Size=Vector3.new(span.Magnitude+.15,.42,.42)
        put(a.upper,CFrame.lookAt(elbow+span*.5,shoulder)*CFrame.Angles(0,math.pi/2,0))
    else put(a.upper,CFrame.new(0,-5000,0)) end
end
local function pose(position,fingers,palm,curl,shoulder)
    return {frame=handFrame(position,fingers,palm),curl=curl or .3,shoulder=shoulder}
end
local function blend(p,q,t)
    if t<=0 then return p elseif t>=1 then return q end
    local curl
    if type(p.curl)=="table" or type(q.curl)=="table" then
        curl={}
        for i=1,5 do
            local x=type(p.curl)=="table" and p.curl[i] or p.curl
            local y=type(q.curl)=="table" and q.curl[i] or q.curl
            curl[i]=x+(y-x)*t
        end
    else curl=p.curl+(q.curl-p.curl)*t end
    local sp=p.shoulder or Vector3.zero;local sq=q.shoulder or Vector3.zero
    return {frame=p.frame:Lerp(q.frame,t),curl=curl,shoulder=(p.shoulder and q.shoulder) and sp:Lerp(sq,t) or q.shoulder or p.shoulder}
end
-- Poses (camera space). Idle: both hands low and relaxed, at the bottom edge of the screen.
local function REST(side,breathe) return pose(Vector3.new(side*.5,-.9+(breathe or 0),-.9),Vector3.new(-side*.08,.2,-1),Vector3.new(-side,-.3,0),.35) end
local function LOW(side) return pose(Vector3.new(side*.56,-1.25,-.72),Vector3.new(-side*.05,-.2,-1),Vector3.new(-side,0,0),.25) end
local function KNIFE(side) return pose(Vector3.new(side*.1,-.34,-1.42),Vector3.new(0,.08,-1),Vector3.new(-side,0,0),{0,0,0,0,.35},Vector3.new(side*.62,-.98,-.2)) end
local function SEAL(side) return pose(Vector3.new(side*.055,-.44,-.78),Vector3.new(-side*.05,1,-.18),Vector3.new(-side,0,0),{0,0,.85,.85,.3},Vector3.new(side*.8,-1.1,0)) end
local FACE=pose(Vector3.new(.16,-.14,-.62),Vector3.new(-.22,1,.08),Vector3.new(-1,0,.15),{0,0,.85,.85,.45},Vector3.new(.78,-1.0,.05))
local GRIP=pose(Vector3.new(.14,-.62,-.86),Vector3.new(1,.25,-.25),Vector3.new(0,-1,0),.8,Vector3.new(-.8,-1.1,.1))
local POINT=pose(Vector3.new(.24,-.34,-1.18),Vector3.new(-.04,.12,-1),Vector3.new(-1,0,0),{0,1,1,1,.7},Vector3.new(.74,-1,-.12))

---------------------------------------------------------------- screen
local overlay={}
local function frame(parent,name,size,position,color,z)
    local f=Instance.new("Frame");f.Name=name;f.Size=size;f.Position=position or UDim2.new();f.BackgroundColor3=color or Color3.new()
    f.BackgroundTransparency=1;f.BorderSizePixel=0;f.ZIndex=z or 4;f.Parent=parent
    return f
end
local function round(f) local c=Instance.new("UICorner");c.CornerRadius=UDim.new(.5,0);c.Parent=f;return f end
local function buildOverlay()
    local root=frame(env.gui,"ItachiOverlay",UDim2.fromScale(1,1));overlay.root=root
    overlay.edges={}
    for i,spec in {{UDim2.fromScale(1,.34),UDim2.fromScale(0,0),90},{UDim2.fromScale(1,.34),UDim2.fromScale(0,.66),-90},{UDim2.fromScale(.28,1),UDim2.fromScale(0,0),0},{UDim2.fromScale(.28,1),UDim2.fromScale(.72,0),180}} do
        local e=frame(root,"Edge",spec[1],spec[2],Color3.fromRGB(6,0,0))
        local g=Instance.new("UIGradient");g.Rotation=spec[3];g.Transparency=NumberSequence.new(0,1);g.Parent=e
        overlay.edges[i]=e
    end
    overlay.red=frame(root,"Red",UDim2.fromScale(1,1),nil,Color3.fromRGB(150,0,6),5)
    overlay.lid=frame(root,"Lid",UDim2.fromScale(.5,1),UDim2.fromScale(0,0),Color3.new(),6)   -- one eye closing
    -- Mangekyo Sharingan: red disc, black ring, three curved pinwheel blades, black pupil; spun from code.
    local eye=frame(root,"Sharingan",UDim2.fromOffset(260,260),UDim2.fromScale(.5,.5),COLORS.Red,7);eye.AnchorPoint=Vector2.new(.5,.5);round(eye)
    local ring=frame(eye,"Ring",UDim2.fromScale(.92,.92),UDim2.fromScale(.5,.5),Color3.new(),7);ring.AnchorPoint=Vector2.new(.5,.5);round(ring)
    local inner=frame(ring,"Inner",UDim2.fromScale(.9,.9),UDim2.fromScale(.5,.5),COLORS.Red,7);inner.AnchorPoint=Vector2.new(.5,.5);round(inner)
    overlay.blades={}
    for i=1,3 do
        local b=frame(inner,"Blade",UDim2.fromScale(.16,.5),UDim2.fromScale(.5,.5),Color3.new(),8);b.AnchorPoint=Vector2.new(.5,1);round(b)
        overlay.blades[i]=b
    end
    local pupil=frame(inner,"Pupil",UDim2.fromScale(.22,.22),UDim2.fromScale(.5,.5),Color3.new(),9);pupil.AnchorPoint=Vector2.new(.5,.5);round(pupil)
    overlay.eye=eye;overlay.eyeParts={eye,ring,inner,pupil}
    -- Cracks across the genjutsu world, and the vortex seen from inside the seal.
    overlay.cracks={}
    for i=1,9 do
        local c=frame(root,"Crack",UDim2.fromOffset(3,220+math.random(0,260)),UDim2.fromScale(.5,.5),Color3.fromRGB(255,235,235),8)
        c.AnchorPoint=Vector2.new(.5,0);c.Rotation=(i-1)*40+math.random(-12,12)
        overlay.cracks[i]=c
    end
    overlay.vortex={}
    for i=1,14 do
        local v=frame(root,"Vortex",UDim2.fromOffset(6,600),UDim2.fromScale(.5,.5),i%2==0 and COLORS.Gold or COLORS.Red,5)
        v.AnchorPoint=Vector2.new(.5,1);overlay.vortex[i]={f=v,angle=(i-1)/14*360}
    end
    local label=Instance.new("TextLabel");label.AnchorPoint=Vector2.new(.5,0);label.Position=UDim2.fromScale(.5,.12);label.Size=UDim2.fromOffset(520,30)
    label.BackgroundTransparency=1;label.Font=Enum.Font.GothamBold;label.TextSize=16;label.TextColor3=Color3.fromRGB(255,214,214)
    label.TextStrokeTransparency=.4;label.Text="";label.ZIndex=9;label.Parent=root
    overlay.label=label
    overlay.grade=Instance.new("ColorCorrectionEffect");overlay.grade.Name="ItachiGrade";overlay.grade.Parent=Lighting
end
local function setOverlay(o)
    for _,e in overlay.edges do e.BackgroundTransparency=1-math.clamp(o.vignette or 0,0,1) end
    overlay.red.BackgroundTransparency=1-math.clamp(o.red or 0,0,.85)
    overlay.lid.BackgroundTransparency=1-math.clamp(o.lid or 0,0,1)
    local n=clock();local eye=math.clamp(o.eye or 0,0,1)
    for _,p in overlay.eyeParts do p.BackgroundTransparency=1-eye*(p.Name=="Sharingan" and .55 or .65) end
    overlay.eye.Rotation=(n*420)%360;overlay.eye.Size=UDim2.fromOffset(260*(1.25-.25*eye),260*(1.25-.25*eye))
    for i,b in overlay.blades do b.Rotation=(i-1)*120+20;b.BackgroundTransparency=1-eye*.7 end
    for _,c in overlay.cracks do c.BackgroundTransparency=1-math.clamp(o.crack or 0,0,1) end
    local vortex=math.clamp(o.vortex or 0,0,1)
    for _,v in overlay.vortex do v.f.Rotation=(v.angle+n*140)%360;v.f.BackgroundTransparency=1-vortex*.55 end
    overlay.label.Text=o.label or "";overlay.label.TextTransparency=o.label and 0 or 1;overlay.label.TextStrokeTransparency=o.label and .4 or 1
    local world=math.clamp(o.world or 0,0,1)
    overlay.grade.Saturation=-world;overlay.grade.Contrast=.45*world;overlay.grade.Brightness=-.18*world
    overlay.grade.TintColor=Color3.new(1,1,1):Lerp(Color3.fromRGB(255,110,110),world)
end
local function kick(power,duration) if power>=shake.power or clock()>shake.untilTime then shake.power=power;shake.untilTime=clock()+duration;shake.duration=duration end end

---------------------------------------------------------------- the Tsukuyomi world (victim's screen only)
local world=nil
local function clearWorld()
    if not world then return end
    for _,p in world.parts do p:Destroy() end
    world=nil
end
local function silhouette(parent)
    local m=Instance.new("Model");m.Name="ItachiShadow";m.Parent=parent
    local function sp(name,size,cf,shape)
        local p=VFX.part(name,size,COLORS.Black,cf,shape,Enum.Material.SmoothPlastic);p.Parent=m;return p
    end
    local parts={
        {sp("Legs",Vector3.new(1.6,2.2,1),CFrame.new(0,1.1,0)),CFrame.new(0,1.1,0)},
        {sp("Cloak",Vector3.new(2.4,3.2,1.4),CFrame.new(0,3.2,0)),CFrame.new(0,3.2,0)},
        {sp("Head",Vector3.new(1.2,1.2,1.2),CFrame.new(0,5.4,0),Enum.PartType.Ball),CFrame.new(0,5.4,0)},
        {sp("Hair",Vector3.new(1.3,.5,1.3),CFrame.new(0,5.9,.1)),CFrame.new(0,5.9,.1)},
    }
    for _,x in {-.25,.25} do
        local e=VFX.part("ShadowEye",Vector3.new(.2,.1,.05),COLORS.Red,CFrame.new(),nil,Enum.Material.Neon);e.Parent=m
        table.insert(parts,{e,CFrame.new(x,5.45,-.6)})
    end
    return {model=m,parts=parts}
end
local function buildWorld(casterModel)
    world={parts={},shadows={}}
    local moon=VFX.part("TsukuyomiMoon",Vector3.one*60,COLORS.Moon,CFrame.new(0,-5000,0),Enum.PartType.Ball,Enum.Material.Neon)
    local floor=VFX.part("TsukuyomiFloor",Vector3.new(.2,140,140),Color3.fromRGB(10,4,4),CFrame.new(0,-5000,0),Enum.PartType.Cylinder,Enum.Material.SmoothPlastic)
    floor.Transparency=1;moon.Transparency=1
    world.moon=moon;world.floor=floor;table.insert(world.parts,moon);table.insert(world.parts,floor)
    for i=1,6 do
        local s=silhouette(VFX.folder);s.ang=(i-3.5)*.36;s.rad=7+(i%3)*3;s.next=0
        table.insert(world.shadows,s);table.insert(world.parts,s.model)
    end
    world.caster=casterModel
end
local function updateWorld(a,k,me)
    if not world then return end
    local cfg=I.Tsukuyomi
    local caster=VFX.rootOf(world.caster)
    local myRoot=VFX.rootOf(me)
    if not myRoot then return end
    local toCaster=caster and Vector3.new(caster.Position.X-myRoot.Position.X,0,caster.Position.Z-myRoot.Position.Z) or -myRoot.CFrame.LookVector
    if toCaster.Magnitude<.1 then toCaster=-myRoot.CFrame.LookVector end
    toCaster=toCaster.Unit
    local feet=myRoot.Position-Vector3.yAxis*3
    world.moon.CFrame=CFrame.new(feet+toCaster*260+Vector3.yAxis*110);world.moon.Size=Vector3.one*(60+30*k)
    world.moon.Transparency=1-k
    world.floor.CFrame=CFrame.new(feet+Vector3.yAxis*.06)*CFrame.Angles(0,0,math.pi/2);world.floor.Transparency=1-.85*k
    local base=math.atan2(toCaster.Z,toCaster.X)
    for _,s in world.shadows do
        if a>.9 and a<1.5 and clock()>s.next then
            s.next=clock()+.08+math.random()*.12
            if math.random()<.5 then
                VFX.feathers(s.model:GetPivot().Position+Vector3.yAxis*3,4,1.5,.8)
                s.ang=math.clamp(s.ang+(math.random()-.5)*1.4,-1.2,1.2);s.rad=6+math.random()*8
            end
        end
        local ang=base+s.ang
        local pos=feet+Vector3.new(math.cos(ang),0,math.sin(ang))*s.rad
        local cf=CFrame.lookAt(pos,Vector3.new(feet.X,pos.Y,feet.Z))
        local show=k>.3 and a<1.62
        for _,entry in s.parts do entry[1].CFrame=cf*entry[2];entry[1].Transparency=show and 0 or 1 end
    end
    if a>=1.62 and not world.scattered then
        world.scattered=true
        for _,s in world.shadows do VFX.feathers(s.model:GetPivot().Position+Vector3.yAxis*3,12,3,1.4) end
    end
end

---------------------------------------------------------------- events
local function ownerOf(data)
    local owner=Players:GetPlayerByUserId(data.owner)
    return owner and owner.Character,owner==player
end
function ItachiClient.onEvent(kind,data)
    local model,mine=ownerOf(data)
    local me=player.Character
    if kind=="ItachiCrow" then
        if model then VFX.crowClone(model,data) end
        if mine then crow={start=data.start};combo={untilTime=data.start+2.5,text="까마귀 분신 · 지금 Q 츠쿠요미로 반격",key="Q"} end
    elseif kind=="ItachiTsukuyomi" then
        if model then VFX.tsukuyomi(model,data) end
        if mine then cast={kind="Tsukuyomi",start=data.start,target=data.target}
            combo={untilTime=data.start+I.Tsukuyomi.End+1,text="츠쿠요미 · 구속 중에 E 아마테라스로 연계",key="E",from=data.start+I.Tsukuyomi.Wave} end
        if data.target==me and me then
            victim={kind="Tsukuyomi",start=data.start,caster=model}
            clearWorld();buildWorld(model)
            VFX.sound("Genjutsu",me:GetPivot().Position,.8,3)
        end
    elseif kind=="ItachiTsukuyomiFail" then
        if mine then cast={kind="TsukuyomiFail",start=clock()};env.announce("츠쿠요미","35스터드 · 12° 안에 보이는 대상이 없습니다") end
    elseif kind=="ItachiTsukuyomiEnd" then
        if data.target==me and victim and victim.kind=="Tsukuyomi" and data.reason~="done" then victim=nil;clearWorld() end
    elseif kind=="ItachiAmaterasu" then
        VFX.amaterasu(data)
        if mine then cast={kind="Amaterasu",start=data.start,center=data.center}
            combo={untilTime=data.start+I.Amaterasu.BurnEnd,text="흑염이 타는 중 · R 스사노오로 연계",key="R",from=data.start+I.Amaterasu.Spread} end
    elseif kind=="ItachiAmaterasuFail" then
        if mine then
            local why=({blocked="적이 시야를 가리고 있습니다 · 바닥을 바라보세요",wall="벽이나 가파른 면에는 붙지 않습니다",range="65스터드 안의 지면을 바라보세요"})[data.reason] or "유효한 지면이 아닙니다"
            env.announce("아마테라스",why)
        end
    elseif kind=="ItachiAmaterasuEnd" then
        VFX.endAmaterasu(data.owner,data.start)
    elseif kind=="ItachiSusanoo" then
        if model then VFX.susanoo(model,data) end
        if mine then cast={kind="Susanoo",start=data.start,direction=data.direction};combo.untilTime=0 end
    elseif kind=="ItachiSusanooSmash" then
        VFX.susanooSmash(data.owner,data.index,data.point,data.targets)
        if mine then kick(data.index==3 and .3 or .18,.25) end
        for _,t in data.targets or {} do if t==me and me then kick(.22,.25) end end
    elseif kind=="ItachiSusanooThrust" then
        VFX.susanooThrust(data.owner,data.target)
        if mine and cast and cast.kind=="Susanoo" then cast.target=data.target end
    elseif kind=="ItachiSusanooHit" then
        VFX.susanooHit(data.owner,data.point)
        if mine then kick(.25,.3) end
        if data.target==me and me then victim={kind="Seal",start=data.start,caster=model} end
    elseif kind=="ItachiSusanooMiss" then
        VFX.susanooMiss(data.owner)
        if mine then env.announce("토츠카의 검","빗나감 · 봉인 없음") end
    elseif kind=="ItachiSusanooSealed" then
        VFX.sound("Seal",data.point,.8,2)
    elseif kind=="ItachiSusanooEnd" then
        VFX.susanooEnd(data.owner,data.reason~="done")
        if mine and cast and cast.kind=="Susanoo" then cast.ended=clock() end
        if victim and victim.kind=="Seal" and victim.caster==model then victim=nil end
    elseif kind=="ItachiMirrorHit" then
        VFX.mirrorHit(data.owner)
    end
end

---------------------------------------------------------------- render
local function lookToward(camera,point,k)
    local d=camera.CFrame:VectorToObjectSpace((point-camera.CFrame.Position).Unit)
    local yaw=math.atan2(-d.X,-d.Z);local pitch=math.atan2(d.Y,math.sqrt(d.X*d.X+d.Z*d.Z))
    return CFrame.Angles(0,yaw*k,0)*CFrame.Angles(pitch*k,0,0)
end
local function revealBody(m,on)
    if on and m then
        for _,v in m:GetDescendants() do
            if v:IsA("BasePart") and v.Name~="HumanoidRootPart" then v.LocalTransparencyModifier=0;revealed[v]=true end
        end
    else
        for v in revealed do if v.Parent then v.LocalTransparencyModifier=1 end end
        table.clear(revealed)
    end
end
local cinemaParams=RaycastParams.new();cinemaParams.FilterType=Enum.RaycastFilterType.Exclude;cinemaParams.RespectCanCollide=true
-- A shot around the caster that never goes through walls: swings to the clearest angle when blocked.
local function shot(camera,me,offset,look)
    local list={VFX.folder,camera}
    for _,p in Players:GetPlayers() do if p.Character then table.insert(list,p.Character) end end
    cinemaParams.FilterDescendantsInstances=list
    local from=me.Position+Vector3.yAxis*1.5
    local best,bestLen=nil,-1
    for _,ang in {0,.45,-.45,.9,-.9,1.4,-1.4} do
        local want=CFrame.Angles(0,ang,0)*offset
        local hit=workspace:Raycast(from,want,cinemaParams)
        local len=hit and math.max(1.5,hit.Distance-1) or want.Magnitude
        if len>bestLen+.01 then best=want.Unit;bestLen=len end
        if len>=want.Magnitude*.85 then break end
    end
    return CFrame.lookAt(from+best*bestLen,look)
end
-- info: {isItachi, melee, sliding, moving, alive}. Returns {fov, fovAdd, combo, ready} for Gojo.client.
function ItachiClient.render(dt,info)
    local n=clock()
    local camera=workspace.CurrentCamera
    if not arms.right then return end
    ItachiClient.updateVictims(n)
    local m=player.Character
    local o={vignette=0,red=0,eye=0,lid=0,crack=0,vortex=0,world=0,label=nil}
    local out={fov=72,fovAdd=0}
    -- Things done to us show for every kit.
    if victim then
        local a=n-victim.start
        if victim.kind=="Tsukuyomi" then
            local cfg=I.Tsukuyomi
            if a>cfg.End+.05 then victim=nil;clearWorld()
            else
                local k=a>=cfg.Eye and smoothstep(window(a,cfg.Eye,cfg.World))*(1-smoothstep(window(a,1.6,1.95))) or 0
                o.world=k;o.vignette=.7*k;o.label=k>.05 and "츠쿠요미 · 환술 세계 · 1.4초 구속" or nil
                o.crack=a>=cfg.Crack and smoothstep(window(a,cfg.Crack,1.75))*(1-smoothstep(window(a,1.75,1.95))) or 0
                if a>=cfg.Wave and not victim.hit then victim.hit=true;o.red=1;kick(.12,.25) end
                if victim.hit then o.red=math.max(o.red,.6*(1-window(a,cfg.Wave,cfg.Wave+.4))) end
                updateWorld(a,k,m)
                local caster=VFX.rootOf(victim.caster)
                if caster and k>0 then env.commonLook(lookToward(camera,caster.Position+Vector3.yAxis*1.2,.85*k)*CFrame.Angles(-.08*k,0,math.sin(n*2)*.03*k)) end
                out.fov=72-10*k;out.victim=true
            end
        elseif victim.kind=="Seal" then
            local cfg=I.Susanoo
            if a>cfg.End+.2 then victim=nil
            else
                local sealedNow=m and (m:GetAttribute("ItachiSealedUntil") or 0)>n
                local caster=VFX.rootOf(victim.caster)
                if caster then env.commonLook(lookToward(camera,caster.Position+Vector3.yAxis*11,.9)) end
                o.vortex=sealedNow and 1 or smoothstep(window(a,cfg.StrikeEnd,cfg.Seal))
                o.red=sealedNow and .75 or .25;o.vignette=.8
                o.label=sealedNow and "토츠카의 검 · 봉인 중" or "토츠카의 검에 끌려 들어가는 중"
                out.fov=82;out.victim=true
            end
        end
    end
    if not info.isItachi then
        poseArm(arms.right,REST(1),false);poseArm(arms.left,REST(-1),false)
        cast=nil;crow=nil;revealBody(nil,false)
        setOverlay(o)
        return out.victim and out or nil
    end
    local visible=info.alive
    local breathe=math.sin(n*1.4)*.01
    local swing=info.moving and math.sin(n*8) or 0
    local R,L=REST(1,breathe+.03*swing),REST(-1,breathe-.03*swing)
    -- Idle Mangekyo: always faintly on.
    VFX.eyeGlow(m,.15)
    -- Basic attack: quick knife-hand jabs, alternating hands, fingers straight, no big wind-up.
    if info.melee and not cast then
        local me=info.melee;local a=n-me.start
        local wind=smoothstep(a/me.windup);local strike=1-(1-window(a,me.windup,me.windup+me.swing))^3
        local back=smoothstep((a-me.windup-me.swing)/math.max(.05,me.duration-me.windup-me.swing))
        local side=me.combo%2==0 and -1 or 1
        local rest=side>0 and R or L
        local cock=blend(rest,KNIFE(side),.25);cock.frame=cock.frame*CFrame.new(0,-.1,.15)
        local p=blend(blend(blend(rest,cock,wind),KNIFE(side),strike),rest,back)
        if side>0 then R=p else L=p end
        out.fovAdd+=2*strike*(1-back)
    end
    if info.sliding then R.frame=R.frame*CFrame.new(0,-.1,.1);L.frame=L.frame*CFrame.new(0,-.1,.1) end
    if not info.alive then cast=nil;crow=nil end
    -- Crow clone: flinch, the hands dissolve fingertips-first into the crows, then come back.
    arms.right.k,arms.left.k=1,1
    if crow then
        local cfg=I.CrowClone;local a=n-crow.start
        if a>cfg.Total then crow=nil
        else
            local gone=smoothstep(window(a,cfg.Break,cfg.MoveFrom))*(1-smoothstep(window(a,cfg.MoveTo,cfg.Reform)))
            arms.right.k,arms.left.k=1-gone,1-gone
            out.fov=72-8*bump(a,0,.25)+6*bump(a,cfg.MoveFrom,cfg.MoveTo)
            o.vignette=math.max(o.vignette,.5*bump(a,0,cfg.Reform));o.eye=math.max(o.eye,.5*bump(a,cfg.Reform-.05,cfg.Total))
            if a<cfg.Break then env.commonLook(CFrame.Angles(.04*bump(a,0,cfg.Break),0,-.03*bump(a,0,cfg.Break))) end
        end
    end
    local cinematic,shotCF=0,nil
    if cast then
        local a=n-cast.start
        if cast.kind=="TsukuyomiFail" then
            if a>.45 then cast=nil else env.commonLook(CFrame.Angles(-.05*bump(a,0,.45),0,0));o.eye=.3*bump(a,0,.45) end
        elseif cast.kind=="Tsukuyomi" then
            ---------------------------------------------------------------- Q
            local cfg=I.Tsukuyomi
            if a>cfg.End+.05 then cast=nil
            else
                -- 0-.3 the head dips, the right hand rises to the face and the left grips the right sleeve;
                -- .3-.55 the Mangekyo spins; .9-1.5 the right hand extends toward the victim; then everything lowers.
                local up=smoothstep(window(a,0,cfg.Prep))*(1-smoothstep(window(a,1.55,1.95)))
                local reach=smoothstep(window(a,1.05,1.3))*(1-smoothstep(window(a,1.5,1.75)))
                R=blend(blend(R,FACE,up),POINT,reach);L=blend(L,GRIP,up*(1-reach))
                env.commonLook(CFrame.Angles(-.12*bump(a,0,.6),0,0))
                out.fov=72-8*smoothstep(window(a,0,cfg.Prep))*(1-smoothstep(window(a,1.5,1.95)))
                o.vignette=.55*up;o.eye=math.max(o.eye,bump(a,cfg.Prep,cfg.Eye+.25)*.9);o.red=.25*bump(a,cfg.Prep,cfg.Eye+.2)
                VFX.eyeGlow(m,.3+.7*up)
                if a>=cfg.Wave and not cast.waved then cast.waved=true;kick(.04,.15) end
            end
        elseif cast.kind=="Amaterasu" then
            ---------------------------------------------------------------- E
            local cfg=I.Amaterasu
            if a>cfg.Full+.1 then cast=nil
            else
                -- .2-.55 the head dips, one eye closes then opens on the Mangekyo; the arms barely move.
                env.commonLook(CFrame.Angles(-.07*bump(a,.1,.9),0,0))
                o.lid=bump(a,.2,.42);o.eye=math.max(o.eye,bump(a,.38,.62)*.85);o.vignette=.45*bump(a,.15,1)
                out.fov=72-6*bump(a,.2,.8)
                R=blend(R,blend(R,SEAL(1),.12),bump(a,.15,.7))
                VFX.eyeGlow(m,.3+.7*bump(a,.2,.9))
                -- Heat haze: a short shake while the flames spread, stronger when close.
                local d=cast.center and m and m:GetPivot().Position and (cast.center-m:GetPivot().Position).Magnitude or 99
                if a>=cfg.Spread and a<cfg.Full and d<40 then kick(.03*(1-d/40)+.01,.1) end
            end
        elseif cast.kind=="Susanoo" then
            ---------------------------------------------------------------- R
            local cfg=I.Susanoo
            if a>cfg.End+.1 or (cast.ended and n-cast.ended>.3) then cast=nil;revealBody(nil,false)
            else
                -- 0-.6 head down, arms lowered slowly, both eyes Mangekyo, red pressure. They stay low.
                local low=smoothstep(window(a,0,.6))*(1-smoothstep(window(a,cfg.End-.4,cfg.End)))
                R=blend(R,LOW(1),low);L=blend(L,LOW(-1),low)
                env.commonLook(CFrame.Angles(-.16*smoothstep(window(a,0,.6))*(1-smoothstep(window(a,.6,1.1)))-.1*bump(a,cfg.End-.4,cfg.End),0,0))
                o.vignette=.6*low;o.red=.35*bump(a,.1,1.2)+.25*bump(a,cfg.Aim,cfg.StrikeEnd);o.eye=math.max(o.eye,.45*bump(a,.3,.75))
                VFX.eyeGlow(m,1)
                out.fov=72-6*smoothstep(window(a,cfg.Aim,cfg.Thrust))*(1-window(a,cfg.Thrust,cfg.Tip))+10*bump(a,cfg.Thrust,cfg.StrikeEnd)
                -- Cinematic: rear shot while Susanoo rises, over the shoulder for the mirror, a flank shot ahead of
                -- the striking arm for the three smashes, side shot of the blade,
                -- first person to aim and thrust, a side shot of the seal, then first person again.
                local root=VFX.rootOf(m)
                local dir=cast.direction or Vector3.new(0,0,-1)
                local side=dir:Cross(Vector3.yAxis).Unit
                if root then
                    local shots={
                        {cfg.Upper,cfg.Mirror,-dir*15+Vector3.yAxis*9+side*2.5,root.Position+Vector3.yAxis*8+dir*3},
                        {cfg.Mirror,cfg.Smash,-dir*5.5-side*3+Vector3.yAxis*3,root.Position+Vector3.yAxis*5+dir*14},
                        {cfg.Smash,cfg.Blade,side*22+dir*8+Vector3.yAxis*8,root.Position+Vector3.yAxis*5+dir*10},
                        {cfg.Blade,cfg.Aim,side*17+dir*2.5+Vector3.yAxis*4,root.Position+Vector3.yAxis*7+dir*3},
                    }
                    if cast.target and a>=cfg.Tip then
                        local tr=VFX.rootOf(cast.target)
                        local mid=tr and root.Position:Lerp(tr.Position,.55) or root.Position+dir*10
                        table.insert(shots,{cfg.StrikeEnd,cfg.SealEnd+.2,side*18+Vector3.yAxis*5+(mid-root.Position)*.5,mid+Vector3.yAxis*3})
                    end
                    for _,s in shots do
                        local k=smoothstep(window(a,s[1]-.05,s[1]+.2))*(1-smoothstep(window(a,s[2]-.2,s[2]+.05)))
                        if k>cinematic then cinematic=k;shotCF=shot(camera,root,s[3],s[4]) end
                    end
                end
            end
        end
    end
    if cinematic>.001 and shotCF then
        local blended=camera.CFrame:Lerp(shotCF,smoothstep(cinematic))
        env.commonLook(camera.CFrame:Inverse()*blended)
        revealBody(m,cinematic>.25)
        if cinematic>.25 then visible=false end
        out.fov=lerp(out.fov,64,cinematic)
    elseif next(revealed) then revealBody(nil,false) end
    if n<shake.untilTime then
        local k=(shake.untilTime-n)/math.max(.01,shake.duration);local p=shake.power*k
        env.commonLook(CFrame.new((math.random()-.5)*p*4,(math.random()-.5)*p*4,0)*CFrame.Angles((math.random()-.5)*p,(math.random()-.5)*p,0))
    end
    local squeeze=math.min(1,camera.ViewportSize.X/math.max(1,camera.ViewportSize.Y))
    local function narrow(p)
        local f=p.frame
        p.frame=CFrame.new(f.Position*Vector3.new(math.max(.72,squeeze),1,1))*f.Rotation
        if p.shoulder then p.shoulder=p.shoulder*Vector3.new(math.max(.8,squeeze),1,1) end
        return p
    end
    poseArm(arms.right,narrow(R),visible and not out.victim)
    poseArm(arms.left,narrow(L),visible and not out.victim)
    setOverlay(o)
    -- Never draw our own eyes or sleeves into the first-person view (the cinematic shows the whole body).
    if m and cinematic<=.25 then
        for _,v in m:GetChildren() do if v:IsA("BasePart") and string.sub(v.Name,1,6)=="Itachi" then v.LocalTransparencyModifier=1 end end
    end
    if n<combo.untilTime and n>=(combo.from or 0) then out.combo=combo.text;out.ready=combo.key end
    return out
end
-- Victim side: a sealed body is carried by the server and does not fight it; binds stop jumping.
local heldApplied=false
function ItachiClient.updateVictims(n)
    local m=player.Character;local h=m and m:FindFirstChildOfClass("Humanoid")
    if not h then return end
    local sealedNow=(m:GetAttribute("ItachiSealedUntil") or 0)>n or (victim and victim.kind=="Seal" and (m:GetAttribute("ItachiHeldUntil") or 0)>n)
    if sealedNow~=heldApplied then
        heldApplied=sealedNow
        h.PlatformStand=sealedNow
        if not sealedNow then h:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end
    if (m:GetAttribute("ItachiHeldUntil") or 0)>n or (m:GetAttribute("ItachiLockUntil") or 0)>n then
        h:SetStateEnabled(Enum.HumanoidStateType.Jumping,false)
    end
end
function ItachiClient.busy() return cast~=nil or crow~=nil end
function ItachiClient.reset()
    cast=nil;crow=nil;victim=nil;combo={untilTime=0,text=""};shake.untilTime=0
    clearWorld();revealBody(nil,false)
    if overlay.root then setOverlay({}) end
end
function ItachiClient.init(environment)
    env=environment
    arms.right=buildArm(1);arms.left=buildArm(-1)
    buildOverlay()
    UIS.WindowFocusReleased:Connect(function() shake.untilTime=0 end)
end
return ItachiClient
]]></ProtectedString>
					<string name="ScriptGuid">{F6DC28D2-DF46-A8DB-B584-F6FA35CA4337}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">ItachiClient</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">3b1ce979ecc6178c581e8c51ef86a192</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXAF873F2CD214EA455499439334232D47">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- All Might on the client: huge first-person arms (blue suit, red/white bands, muscled forearms, yellow gloves with
-- jointed fingers), camera work for each technique (including the short Plus Ultra cinematic), screen overlays
-- and shouts, the buff timer, and the local side of being smashed, carried or launched.
-- Gojo.client.luau owns input and the shared HUD; it forwards AllMight* events here and asks for the arm pose every
-- frame. All judgement stays on the server.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local UIS=game:GetService("UserInputService")
local Lighting=game:GetService("Lighting")
local A=require(RS:WaitForChild("AllMightConfig"))
local VFX=require(RS:WaitForChild("AllMightVFX"))
local COLORS=A.Colors
local player=Players.LocalPlayer
local smoothstep=VFX.smoothstep
local function clock() return workspace:GetServerTimeNow() end
local function easeOut(x,power) x=math.clamp(x,0,1);return 1-(1-x)^(power or 2) end
local function window(a,from,to) return math.clamp((a-from)/(to-from),0,1) end

local AllMightClient={}
local env
local cast=nil            -- the local player's own technique in progress
local buffStart,buffUntil,fatigueUntil=0,0,0
local auras={}            -- [owner userId] = buff aura effect
local heldApplied=false
local shake={untilTime=0,power=0,duration=.1}
local freeze={at=0,length=0}   -- hitstop: local animation time stops for `length` at `at`
local comboUntil=0
local revealed={}         -- own body parts shown during the cinematic

---------------------------------------------------------------- arms
-- Hand frame: origin at the wrist, +Y toward the knuckles, palm facing -Z, back of the hand +Z.
-- The forearm runs from the wrist along -Y; the upper arm joins the elbow to a shoulder point in camera space.
local arms={}
local GLOVE,BLUE,MUSCLE=COLORS.Glove,COLORS.Blue,Color3.fromRGB(64,106,218)
local function vmPart(model,name,size,color,shape,material)
    local p=Instance.new("Part");p.Name=name;p.Size=size;p.Color=color;p.Shape=shape or Enum.PartType.Block
    p.Material=material or Enum.Material.SmoothPlastic;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
    p.CastShadow=false;p.Transparency=1;p.Parent=model
    return p
end
local FINGERS={ -- x along the knuckles from the thumb side; three phalanx lengths
    {x=.078,a=.1,b=.07,c=.056},{x=.027,a=.108,b=.076,c=.06},{x=-.024,a=.102,b=.072,c=.056},{x=-.072,a=.086,b=.06,c=.05},
}
local FOREARM=.95
local MUSCLES={ -- forearm bulges in the hand frame (x is mirrored by side): extensor, brachioradialis, flexor
    {at=Vector3.new(.03,-.38,.1),size=Vector3.new(.25,.46,.2)},
    {at=Vector3.new(.1,-.66,.07),size=Vector3.new(.3,.56,.27)},
    {at=Vector3.new(-.08,-.6,-.06),size=Vector3.new(.27,.52,.24)},
}
local function buildArm(side)
    local m=Instance.new("Model");m.Name=side>0 and "AllMightRightArm" or "AllMightLeftArm";m.Parent=env.viewmodel
    local a={side=side,thumbSide=side>0 and -1 or 1,model=m,fingers={},muscles={}}
    a.palm=vmPart(m,"Glove",Vector3.new(.25,.25,.13),GLOVE)
    a.cuff=vmPart(m,"GloveCuff",Vector3.new(.2,.32,.32),GLOVE,Enum.PartType.Cylinder)
    a.knuckles=vmPart(m,"Knuckles",Vector3.new(.25,.06,.11),Color3.fromRGB(240,190,30))
    for i,f in FINGERS do
        a.fingers[i]={def=f,a=vmPart(m,"Finger",Vector3.new(.058,f.a,.058),GLOVE),b=vmPart(m,"Finger",Vector3.new(.054,f.b,.054),GLOVE),
            c=vmPart(m,"Finger",Vector3.new(.05,f.c,.05),GLOVE)}
    end
    a.thumb={a=vmPart(m,"Thumb",Vector3.new(.064,.09,.064),GLOVE),b=vmPart(m,"Thumb",Vector3.new(.058,.075,.058),GLOVE)}
    a.forearm=vmPart(m,"Forearm",Vector3.new(FOREARM,.27,.27),BLUE,Enum.PartType.Cylinder)
    a.white=vmPart(m,"WhiteBand",Vector3.new(.07,.31,.31),COLORS.White,Enum.PartType.Cylinder)
    a.red=vmPart(m,"RedBand",Vector3.new(.06,.3,.3),COLORS.Red,Enum.PartType.Cylinder)
    for i,spec in MUSCLES do a.muscles[i]={spec=spec,p=vmPart(m,"ForearmMuscle",spec.size,MUSCLE,Enum.PartType.Ball)} end
    a.elbow=vmPart(m,"Elbow",Vector3.one*.33,BLUE,Enum.PartType.Ball)
    a.upper=vmPart(m,"UpperArm",Vector3.new(1,.4,.4),BLUE,Enum.PartType.Cylinder)
    a.bicep=vmPart(m,"Bicep",Vector3.new(.5,.46,.6),MUSCLE,Enum.PartType.Ball)
    a.stripe=vmPart(m,"RedStripe",Vector3.new(.08,.44,.44),COLORS.Red,Enum.PartType.Cylinder)
    a.deltoid=vmPart(m,"Deltoid",Vector3.new(.8,.72,.8),BLUE,Enum.PartType.Ball)
    a.glow=Instance.new("PointLight");a.glow.Color=COLORS.Gold;a.glow.Range=3;a.glow.Brightness=0;a.glow.Parent=a.palm
    return a
end
local function handFrame(position,fingerDir,palmNormal)
    local y=fingerDir.Unit
    local z=-(palmNormal-y*palmNormal:Dot(y))
    if z.Magnitude<.01 then z=Vector3.zAxis end
    z=z.Unit
    return CFrame.fromMatrix(position,y:Cross(z),y,z)
end
-- pose: {frame, curl (0..1 or per finger, thumb 5th), flex 0..1, shoulder Vector3, glow 0..1}
local ALONG=CFrame.Angles(0,0,math.pi/2)
local function poseArm(a,pose,visible)
    local cam=workspace.CurrentCamera.CFrame
    local world=cam*pose.frame
    local function put(p,cf) p.CFrame=cf;p.Transparency=visible and 0 or 1 end
    local flex=math.clamp(pose.flex or 0,0,1)
    put(a.palm,world*CFrame.new(0,.12,0))
    put(a.cuff,world*CFrame.new(0,-.07,0)*ALONG)
    put(a.knuckles,world*CFrame.new(0,.25,.01))
    for i,f in a.fingers do
        local d=f.def
        local c=math.clamp(type(pose.curl)=="table" and pose.curl[i] or pose.curl or 0,0,1)
        local base=world*CFrame.new(d.x*a.thumbSide,.25,0)
        local pa=base*CFrame.Angles(-c*1.5,0,0)
        put(f.a,pa*CFrame.new(0,d.a/2,0))
        local pb=pa*CFrame.new(0,d.a,0)*CFrame.Angles(-c*1.65,0,0)
        put(f.b,pb*CFrame.new(0,d.b/2,0))
        local pc=pb*CFrame.new(0,d.b,0)*CFrame.Angles(-c*1.1,0,0)
        put(f.c,pc*CFrame.new(0,d.c/2,0))
    end
    local tc=math.clamp(type(pose.curl)=="table" and pose.curl[5] or pose.curl or 0,0,1)
    local thumb=world*CFrame.new(a.thumbSide*.11,.07,-.03)*CFrame.Angles(0,0,-a.thumbSide*(.85-.7*tc))*CFrame.Angles(-.3-tc*.75,0,0)
    put(a.thumb.a,thumb*CFrame.new(0,.045,0))
    local tip=thumb*CFrame.new(0,.09,0)*CFrame.Angles(-tc*.9,a.thumbSide*tc*.5,0)
    put(a.thumb.b,tip*CFrame.new(0,.037,0))
    -- Forearm with the suit's white and red bands; the muscles swell as the fist clenches.
    put(a.forearm,world*CFrame.new(0,-FOREARM/2-.05,0)*ALONG)
    put(a.white,world*CFrame.new(0,-.2,0)*ALONG)
    put(a.red,world*CFrame.new(0,-.28,0)*ALONG)
    for _,mu in a.muscles do
        mu.p.Size=mu.spec.size*(1+.2*flex)
        put(mu.p,world*CFrame.new(mu.spec.at.X*a.side,mu.spec.at.Y,mu.spec.at.Z*(1+.25*flex)))
    end
    local elbow=(world*CFrame.new(0,-FOREARM-.05,0)).Position
    local shoulder=(cam*CFrame.new(pose.shoulder or Vector3.new(a.side*.95,-1.05,.12))).Position
    put(a.elbow,CFrame.new(elbow))
    local span=shoulder-elbow
    local mid=elbow+span*.5
    if span.Magnitude>.05 then
        a.upper.Size=Vector3.new(span.Magnitude+.12,.4,.4)
        put(a.upper,CFrame.lookAt(mid,shoulder)*CFrame.Angles(0,math.pi/2,0))
        local side=cam.RightVector*a.side
        a.bicep.Size=Vector3.new(.5,.46,.62)*(1+.22*flex)
        put(a.bicep,CFrame.lookAt(elbow+span*.42+cam.UpVector*.1,shoulder)*CFrame.new(0,0,0)*CFrame.Angles(0,math.pi/2,0)*CFrame.new(0,.06,0))
        put(a.stripe,CFrame.lookAt(elbow+span*.72,shoulder)*CFrame.Angles(0,math.pi/2,0))
        put(a.deltoid,CFrame.new(shoulder+side*.05+cam.UpVector*(.06+.06*flex)))
    end
    a.glow.Brightness=(pose.glow or 0)*3
end
local function fist(position,forward,palm,curl,flex,shoulder,glow)
    return {frame=handFrame(position,forward,palm),curl=curl or 1,flex=flex or 0,shoulder=shoulder,glow=glow}
end
-- Blends two poses (positions, directions, curls, shoulder).
local function blend(p,q,t)
    if t<=0 then return p elseif t>=1 then return q end
    local curl
    if type(p.curl)=="table" or type(q.curl)=="table" then
        curl={}
        for i=1,5 do
            local x=type(p.curl)=="table" and p.curl[i] or p.curl
            local y=type(q.curl)=="table" and q.curl[i] or q.curl
            curl[i]=x+(y-x)*t
        end
    else curl=p.curl+(q.curl-p.curl)*t end
    local sp=p.shoulder or Vector3.zero;local sq=q.shoulder or Vector3.zero
    return {frame=p.frame:Lerp(q.frame,t),curl=curl,flex=(p.flex or 0)+((q.flex or 0)-(p.flex or 0))*t,
        shoulder=(p.shoulder and q.shoulder) and sp:Lerp(sq,t) or q.shoulder or p.shoulder,glow=(p.glow or 0)+((q.glow or 0)-(p.glow or 0))*t}
end
-- Fingers close one after another: index first, then middle, ring, little, thumb last.
local function rollingCurl(k,from,to)
    local out={}
    for i=1,5 do out[i]=from+(to-from)*smoothstep((k-(i-1)*.12)/.5) end
    return out
end

---------------------------------------------------------------- screen
local overlay={}
local function makeShout(parent,size,color,stroke)
    local l=Instance.new("TextLabel");l.AnchorPoint=Vector2.new(.5,.5);l.Position=UDim2.fromScale(.5,.42);l.Size=UDim2.fromScale(1,.2)
    l.BackgroundTransparency=1;l.Font=Enum.Font.GothamBlack;l.TextScaled=true;l.TextColor3=color;l.TextStrokeColor3=stroke
    l.TextStrokeTransparency=0;l.TextTransparency=1;l.ZIndex=7;l.Text="";l.Parent=parent
    local c=Instance.new("UITextSizeConstraint");c.MaxTextSize=size;c.Parent=l
    return l
end
local function buildOverlay()
    local frame=Instance.new("Frame");frame.Name="AllMightOverlay";frame.Size=UDim2.fromScale(1,1);frame.BackgroundTransparency=1;frame.ZIndex=4;frame.Parent=env.gui
    overlay.root=frame
    overlay.edges={}
    for i,spec in {{UDim2.fromScale(1,.32),UDim2.fromScale(0,0),90},{UDim2.fromScale(1,.32),UDim2.fromScale(0,.68),-90},{UDim2.fromScale(.26,1),UDim2.fromScale(0,0),0},{UDim2.fromScale(.26,1),UDim2.fromScale(.74,0),180}} do
        local e=Instance.new("Frame");e.Size=spec[1];e.Position=spec[2];e.BackgroundColor3=Color3.fromRGB(8,6,4);e.BorderSizePixel=0;e.BackgroundTransparency=1;e.ZIndex=4;e.Parent=frame
        local g=Instance.new("UIGradient");g.Rotation=spec[3];g.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)});g.Parent=e
        overlay.edges[i]=e
    end
    -- Speed lines: thin bars around the centre that slide outward.
    overlay.lines={}
    for i=1,28 do
        local l=Instance.new("Frame");l.AnchorPoint=Vector2.new(.5,.5);l.BorderSizePixel=0;l.BackgroundColor3=COLORS.Wind
        l.BackgroundTransparency=1;l.ZIndex=5;l.Size=UDim2.fromOffset(3,120);l.Parent=frame
        overlay.lines[i]={f=l,angle=(i-1)/28*math.pi*2+math.random()*.15,seed=math.random()}
    end
    overlay.flash=Instance.new("Frame");overlay.flash.Size=UDim2.fromScale(1,1);overlay.flash.BackgroundColor3=Color3.new(1,1,1)
    overlay.flash.BackgroundTransparency=1;overlay.flash.BorderSizePixel=0;overlay.flash.ZIndex=6;overlay.flash.Parent=frame
    overlay.shout=makeShout(frame,110,COLORS.Gold,Color3.fromRGB(120,40,8))
    overlay.sub=makeShout(frame,40,Color3.new(1,1,1),Color3.fromRGB(30,40,90));overlay.sub.Position=UDim2.fromScale(.5,.56);overlay.sub.Size=UDim2.fromScale(1,.07)
    overlay.grade=Instance.new("ColorCorrectionEffect");overlay.grade.Name="AllMightGrade";overlay.grade.Parent=Lighting
end
local shoutState={text="",start=0,life=0,sub=""}
local function shout(text,life,sub,color)
    shoutState={text=text,start=clock(),life=life,sub=sub or "",color=color or COLORS.Gold}
end
local function setOverlay(vignette,lines,linesColor,flash,flashColor,contrast,lineCenter)
    for _,e in overlay.edges do e.BackgroundTransparency=1-math.clamp(vignette,0,1) end
    local vp=workspace.CurrentCamera.ViewportSize
    local n=clock()
    local cx,cy=(lineCenter or Vector2.new(.5,.5)).X,(lineCenter or Vector2.new(.5,.5)).Y
    for _,l in overlay.lines do
        if lines>.01 then
            local travel=(n*2.2+l.seed)%1
            local radius=(.28+.5*travel)*math.max(vp.X,vp.Y)*.5
            local x=cx*vp.X+math.cos(l.angle)*radius;local y=cy*vp.Y+math.sin(l.angle)*radius
            l.f.Position=UDim2.fromOffset(x,y);l.f.Rotation=math.deg(l.angle)+90
            l.f.Size=UDim2.fromOffset(2+3*lines,60+160*lines*travel)
            l.f.BackgroundColor3=linesColor or COLORS.Wind
            l.f.BackgroundTransparency=1-math.clamp(lines*(1-travel)*.9,0,1)
        else l.f.BackgroundTransparency=1 end
    end
    overlay.flash.BackgroundColor3=flashColor or Color3.new(1,1,1)
    overlay.flash.BackgroundTransparency=1-math.clamp(flash,0,.95)
    overlay.grade.Contrast=contrast or 0;overlay.grade.Saturation=(contrast or 0)*.3
    -- Shouts punch in big and settle.
    local age=n-shoutState.start
    if shoutState.text~="" and age<shoutState.life then
        local inK=easeOut(age/.12,3);local out=smoothstep((age-shoutState.life+.35)/.35)
        overlay.shout.Text=shoutState.text;overlay.shout.TextColor3=shoutState.color
        overlay.shout.Size=UDim2.fromScale(1,.2*(1.6-.6*inK));overlay.shout.TextTransparency=out;overlay.shout.TextStrokeTransparency=out
        overlay.sub.Text=shoutState.sub;overlay.sub.TextTransparency=shoutState.sub~="" and out or 1;overlay.sub.TextStrokeTransparency=overlay.sub.TextTransparency
    else
        overlay.shout.TextTransparency=1;overlay.shout.TextStrokeTransparency=1;overlay.sub.TextTransparency=1;overlay.sub.TextStrokeTransparency=1
    end
end
local function kick(power,duration) if power>=shake.power or clock()>shake.untilTime then shake.power=power;shake.untilTime=clock()+duration;shake.duration=duration end end
local function stop(at,length) freeze.at=at;freeze.length=length end
-- Local animation time with hitstop applied: the pose holds still during a freeze.
local function animTime(n,start)
    local a=n-start
    local fa=freeze.at-start
    if a>fa and fa>=0 then a=math.max(fa,a-freeze.length) end
    return a
end

---------------------------------------------------------------- events
local function ownerOf(data)
    local owner=Players:GetPlayerByUserId(data.owner)
    return owner and owner.Character,owner==player
end
local function rootOf(model) return model and model:FindFirstChild("HumanoidRootPart") end
function AllMightClient.onEvent(kind,data)
    local model,mine=ownerOf(data)
    local root=rootOf(model)
    if kind=="AllMightPowerCast" then
        VFX.powerCast(model,data)
        if root then VFX.sound("Heartbeat",root.Position,.6,1.2) end
        if mine then cast={kind="Power",start=data.start,prep=data.prep,open=data.open} end
    elseif kind=="AllMightPowerOn" then
        if auras[data.owner] then auras[data.owner].dead=true end
        auras[data.owner]=VFX.powerAura(model,data.untilTime)
        if mine then buffStart=data.start;buffUntil=data.untilTime end
    elseif kind=="AllMightPowerOff" then
        if auras[data.owner] then auras[data.owner].dead=true;auras[data.owner]=nil end
        VFX.powerOff(model)
        if mine then
            buffUntil=0
            if data.fatigue>0 then fatigueUntil=clock()+data.fatigue;env.announce("ONE FOR ALL","힘이 빠진다 · 이동 속도 -15% "..data.fatigue.."초") end
        end
    elseif kind=="AllMightSmashCast" then
        VFX.smashCast(model,data)
        if mine then cast={kind="Smash",start=data.start,buffed=data.buffed} end
    elseif kind=="AllMightSmashDash" then
        VFX.smashDash(model,data)
    elseif kind=="AllMightSmashContact" then
        if mine and cast and cast.kind=="Smash" then cast.contact=data.target end
    elseif kind=="AllMightSmashBump" then
        VFX.bump(data)
        if mine and cast and cast.kind=="Smash" then cast.bump=data.start;kick(.05,.2) end
    elseif kind=="AllMightSmashImpact" then
        VFX.smashImpact(data)
        if mine and cast and cast.kind=="Smash" then
            cast.impact=data.start;cast.hit=data.hit
            if data.hit then
                stop(data.start,.08);kick(.12,.4);comboUntil=data.start+A.UnitedStatesOfSmash.PunchEnd+A.UnitedStatesOfSmash.Hold+A.UnitedStatesOfSmash.Return-A.UnitedStatesOfSmash.Impact
                shout("SMASH!",1,"UNITED STATES OF SMASH",data.buffed and COLORS.Gold or Color3.new(1,1,1))
                VFX.sound("VoiceSmash",data.position,1,2)
            else kick(.03,.15) end
        else
            local me=rootOf(player.Character)
            if me and (me.Position-data.position).Magnitude<40 then kick(.04,.3) end
        end
    elseif kind=="AllMightSmashEnd" then
        if mine and cast and cast.kind=="Smash" then cast.ended=clock() end
    elseif kind=="AllMightKnock" then
        VFX.knockTrail(data.model,data.duration,data.heavy)
        if data.model==player.Character then kick(data.heavy and .08 or .03,.3) end
    elseif kind=="AllMightWallHit" then
        VFX.wallHit(data.position,data.normal)
    elseif kind=="AllMightUltraCast" then
        VFX.ultraCast(model,data)
        if root then VFX.sound("Rumble",root.Position,.6,1.2,1.4) end
        if mine then cast={kind="Ultra",start=data.start,direction=data.direction,buffed=data.buffed};comboUntil=0 end
    elseif kind=="AllMightUltraDash" then
        VFX.ultraDash(model,data)
        if mine and cast and cast.kind=="Ultra" then cast.dash=data.start end
    elseif kind=="AllMightUltraFail" then
        VFX.ultraFail(data)
        if mine and cast and cast.kind=="Ultra" then cast.fail=data.start;env.announce("PLUS ULTRA","돌진 경로에 적이 없다 · 재사용 대기 30초") end
    elseif kind=="AllMightUltraContact" then
        if mine and cast and cast.kind=="Ultra" then cast.contact=data.start;cast.target=data.target end
        VFX.ultraChase(model,data.target,A.PlusUltra.Uppercut,data.start+A.PlusUltra.Lift)
    elseif kind=="AllMightUltraPunch" then
        VFX.ultraPunch(data)
        if mine then
            if data.index==1 then kick(.1,.35);stop(data.start,.05) else kick(.05,.2) end
        end
    elseif kind=="AllMightUltraUppercut" then
        VFX.ultraUppercut(data,data.target)
        if mine and cast and cast.kind=="Ultra" then
            cast.uppercut=data.start;cast.apex=data.apex
            stop(data.start,.12);kick(.16,.55)
            shout("PLUS ULTRA!!!",1.6,"",COLORS.Gold)
            VFX.sound("VoiceUltra",data.position,1,3)
        else
            local me=rootOf(player.Character)
            if me and (me.Position-data.position).Magnitude<90 then kick(.07,.5) end
        end
    elseif kind=="AllMightUltraApex" then
        VFX.ultraApex(data.position)
        if mine and cast and cast.kind=="Ultra" then cast.apexAt=data.start end
    elseif kind=="AllMightUltraLand" then
        VFX.ultraLand(data.position)
        if mine then kick(.06,.3) end
    elseif kind=="AllMightUltraLost" or kind=="AllMightUltraEnd" then
        if mine and cast and cast.kind=="Ultra" and data.reason~="finished" then cast.ended=clock() end
    end
end

---------------------------------------------------------------- per frame
local function lookToward(camera,point,k,maxPitch)
    local d=camera.CFrame:VectorToObjectSpace((point-camera.CFrame.Position).Unit)
    local yaw=math.atan2(-d.X,-d.Z);local pitch=math.clamp(math.atan2(d.Y,math.sqrt(d.X*d.X+d.Z*d.Z)),-maxPitch,maxPitch)
    return CFrame.Angles(0,yaw*k,0)*CFrame.Angles(pitch*k,0,0)
end
-- Shows (or hides again) the caster's own body for the cinematic shots.
local function revealBody(m,on)
    if on and m then
        for _,v in m:GetDescendants() do
            if v:IsA("BasePart") and v.Name~="HumanoidRootPart" then v.LocalTransparencyModifier=0;revealed[v]=true end
        end
    else
        for v in revealed do if v.Parent then v.LocalTransparencyModifier=1 end end
        table.clear(revealed)
    end
end
local cinemaParams=RaycastParams.new();cinemaParams.FilterType=Enum.RaycastFilterType.Exclude;cinemaParams.RespectCanCollide=true
-- A pulled-back side view framing both bodies; the camera never goes through walls.
local function cinematicFrame(camera,me,target,direction)
    local mid=(me.Position+target.Position)/2
    local side=direction:Cross(Vector3.yAxis).Unit
    local want=me.Position+side*9-direction*7+Vector3.yAxis*2
    local list={VFX.folder,camera}
    for _,p in Players:GetPlayers() do if p.Character then table.insert(list,p.Character) end end
    table.insert(list,target.Parent)
    cinemaParams.FilterDescendantsInstances=list
    local from=me.Position+Vector3.yAxis*1.5
    local hit=workspace:Raycast(from,want-from,cinemaParams)
    if hit then want=from+(want-from).Unit*math.max(1.5,hit.Distance-1) end
    return CFrame.lookAt(want,mid+Vector3.yAxis*1.5)
end
-- info: {isAllMight, melee, sliding, moving, alive}. Returns {fov, fovAdd, combo, rReady} for Gojo.client.
function AllMightClient.render(dt,info)
    local n=clock()
    local camera=workspace.CurrentCamera
    if not arms.right then return end
    AllMightClient.updateVictims(n)
    local m=player.Character
    if not info.isAllMight then
        poseArm(arms.right,fist(Vector3.zero,Vector3.yAxis,-Vector3.zAxis),false);poseArm(arms.left,fist(Vector3.zero,Vector3.yAxis,-Vector3.zAxis),false)
        setOverlay(0,0,nil,0,nil,0);cast=nil;revealBody(nil,false)
        return nil
    end
    local out={fov=72,fovAdd=0}
    local vignette,lines,linesColor,flash,flashColor,contrast=0,0,nil,0,nil,0
    local lineCenter=nil
    local buffed=n<buffUntil
    local visible=info.alive
    -- Idle: loosely clenched fists low at both sides, a slow breath. Running: the body leans and the arms pump.
    local t=n
    local swing=info.moving and math.sin(t*(buffed and 11 or 9)) or 0
    local breathe=math.sin(t*1.6)*.012
    local run=info.moving and 1 or 0
    local function restFor(side)
        local s=swing*side
        local pos=Vector3.new(side*.56,-.66+breathe-.05*run+.06*math.max(0,s)*run,-.98-.24*s*run)
        return fist(pos,Vector3.new(-side*.12,.42+.2*s*run,-1),Vector3.new(-side,-.25,0),.72,.15,Vector3.new(side*.98,-1.06+.04*run,.14+.12*s*run))
    end
    local R,L=restFor(1),restFor(-1)
    if info.moving and not cast then env.commonLook(CFrame.new(0,-.12*run,0)*CFrame.Angles(-.035*run,0,swing*.006)) end
    if buffed then
        R.glow=.6+.3*math.sin(n*14);L.glow=R.glow
        out.fovAdd=7*smoothstep((n-buffStart)/.4)*smoothstep((buffUntil-n)/.4)
        vignette=.08
    end
    -- Shared M1 punches: heavy straight punches, alternating fists, with the shoulder driving through.
    if info.melee and not cast then
        local me=info.melee;local a=n-me.start
        local wind=smoothstep(a/me.windup);local strike=smoothstep((a-me.windup)/me.swing)
        local back=smoothstep((a-me.windup-me.swing)/math.max(.05,me.duration-me.windup-me.swing))
        local side=me.combo%2==0 and -1 or 1
        local rest=side>0 and R or L
        local cock=fist(Vector3.new(side*.7,-.6,-.62),Vector3.new(-side*.15,.2,-1),Vector3.new(-side*.3,-1,0),1,.7,Vector3.new(side*1.05,-1.0,.3))
        local hit=fist(Vector3.new(side*.12,-.3,-1.5),Vector3.new(0,.05,-1),Vector3.new(0,-1,0),1,1,Vector3.new(side*.78,-.86,-.25))
        local pose=blend(blend(blend(rest,cock,wind),hit,strike),rest,back)
        if side>0 then R=pose else L=pose end
        out.fovAdd+=5*strike*(1-back)
    end
    if info.sliding then
        R.frame=R.frame*CFrame.new(0,-.1,.1);L.frame=L.frame*CFrame.new(0,-.1,.1)
    end
    if cast and not info.alive then cast=nil end
    local cinematic=0
    if cast then
        local a=animTime(n,cast.start)
        if cast.kind=="Power" then
            ---------------------------------------------------------------- Q
            local cfg=A.OneForAll
            local gather=easeOut(a/cfg.Open,2.2)
            local open=easeOut((a-cfg.Open)/.18,3)
            local settle=smoothstep((a-cfg.Prep)/.35)
            -- 0–0.45: right fist to the chest, left fist to the waist, fingers closing one by one.
            local chestR=fist(Vector3.new(.2,-.4,-.66),Vector3.new(-.6,.5,-.45),Vector3.new(-.4,-.1,-1),rollingCurl(gather,.7,1),gather,Vector3.new(.82,-.98,.02))
            local waistL=fist(Vector3.new(-.42,-.86,-.72),Vector3.new(.2,.6,-.7),Vector3.new(.9,-.2,0),rollingCurl(gather,.7,1),gather,Vector3.new(-.82,-1.1,.05))
            -- 0.45–0.85: arms thrown wide, chest open.
            local wideR=fist(Vector3.new(1.05,-.36,-.86),Vector3.new(.6,.55,-.55),Vector3.new(0,-.6,-1),1,1,Vector3.new(1.08,-.95,.2),1)
            local wideL=fist(Vector3.new(-1.05,-.36,-.86),Vector3.new(-.6,.55,-.55),Vector3.new(0,-.6,-1),1,1,Vector3.new(-1.08,-.95,.2),1)
            R=blend(blend(blend(R,chestR,gather),wideR,open),R,settle)
            L=blend(blend(blend(L,waistL,gather),wideL,open),L,settle)
            local tremble=(1-open)*gather*.006
            R.frame=CFrame.new(math.sin(n*57)*tremble,math.cos(n*49)*tremble,0)*R.frame
            -- Camera: dips while gathering, rises and widens fast when the chest opens.
            local dip=gather*(1-open)
            env.commonLook(CFrame.new(0,-.35*dip+.25*open*(1-settle),0)*CFrame.Angles(-.08*dip+.05*open*(1-settle),0,0))
            out.fov=72-6*dip+24*open*(1-smoothstep((a-cfg.Open-.15)/.5))+7*settle
            vignette=.5*dip+.15*open*(1-settle)
            flash=.35*open*(1-smoothstep((a-cfg.Open)/.25));flashColor=COLORS.Gold
            lines=open*(1-settle)*.8;linesColor=COLORS.Gold
            if a>=cfg.Open and not cast.roared then
                cast.roared=true;kick(.06,.35)
                shout("ONE FOR ALL — FULL POWER",1.6,"10초 · 이동 +35% · 기본공격 +25% · E +20% · 받는 피해 -15%")
            end
            if a>cfg.Prep+.4 then cast=nil end
        elseif cast.kind=="Smash" then
            ---------------------------------------------------------------- E
            local cfg=A.UnitedStatesOfSmash
            local crouch=easeOut(a/cfg.Crouch,2)
            local dash=window(a,cfg.Crouch,cfg.DashEnd)
            local draw=easeOut((a-cfg.DashEnd)/(cfg.WindEnd-cfg.DashEnd),2)
            local punch=easeOut((a-cfg.WindEnd)/(cfg.Impact-cfg.WindEnd),3.2)
            local holdEnd=cfg.PunchEnd+cfg.Hold
            local back=smoothstep((a-holdEnd)/cfg.Return)
            local gold=cast.buffed and 1 or .6
            -- Right arm cocked back with the fist at the screen's right; left arm forward as a guard.
            local cocked=fist(Vector3.new(.74,-.4,-.62),Vector3.new(-.25,.35,-1),Vector3.new(-.3,-1,0),1,.8,Vector3.new(1.08,-.98,.32),.5*gold)
            local drawn=fist(Vector3.new(.92,-.3,-.4),Vector3.new(-.4,.4,-.9),Vector3.new(-.2,-1,0),1,1,Vector3.new(1.15,-.92,.45),gold)
            local thrown=fist(Vector3.new(.04,-.2,-1.55),Vector3.new(0,.06,-1),Vector3.new(0,-1,0),1,1,Vector3.new(.62,-.82,-.42),gold)
            local guard=fist(Vector3.new(-.36,-.5,-1.0),Vector3.new(.25,.5,-1),Vector3.new(.8,-.4,0),.9,.5,Vector3.new(-.95,-1.04,.05))
            local tuck=fist(Vector3.new(-.62,-.72,-.6),Vector3.new(.2,.6,-.7),Vector3.new(.9,-.2,0),1,.6,Vector3.new(-1.0,-1.0,.3))
            R=blend(blend(blend(blend(R,cocked,crouch),drawn,draw),thrown,punch),R,back)
            L=blend(blend(blend(L,guard,crouch),tuck,punch),L,back)
            -- Camera: low crouch, narrow view; the dash widens it; the wind-up twists right; the punch swings left.
            local low=crouch*(1-back)
            local twist=.14*draw*(1-punch)-.1*punch*(1-back)
            env.commonLook(CFrame.new(0,-.9*low,0)*CFrame.Angles(-.03*low,twist,-.05*draw*(1-punch)+.04*punch*(1-back)))
            out.fov=72-8*crouch*(1-dash)+16*dash*(1-draw)-6*draw*(1-punch)+18*punch*(1-smoothstep((a-cfg.Impact)/.4))
            out.fov=out.fov*(1-back)+72*back
            vignette=.55*crouch*(1-dash)+.35*draw*(1-punch)
            lines=(dash>0 and dash<1 and not cast.bump) and .9 or 0
            if cast.impact and cast.hit then
                local k=1-smoothstep((n-cast.impact-.08)/.3)
                flash=math.max(flash,.85*k);lines=math.max(lines,k)
                contrast=.35*k
            end
            if a>=cfg.DashEnd+.02 and not cast.called and not cast.bump then
                cast.called=true
                shout("UNITED STATES OF...",cfg.Impact-cfg.DashEnd+.1,"",COLORS.Gold)
                if m and rootOf(m) then VFX.sound("VoiceSmashLead",rootOf(m).Position,.9,1.5) end
            end
            -- Steam off the extended arm while it is held out.
            if cast.impact and not cast.steamed then
                cast.steamed=true
                VFX.steam(function() return (camera.CFrame*CFrame.new(.1,-.2,-1.6)).Position end,cfg.Hold+.2,.05)
            end
            if cast.bump then
                local k=n-cast.bump
                R=blend(R,fist(Vector3.new(.3,-.35,-.9),Vector3.new(-.1,.3,-1),Vector3.new(0,-1,0),1,.6),smoothstep(k/.06)*(1-smoothstep((k-.1)/.3)))
                if k>.45 then cast=nil end
            elseif a>holdEnd+cfg.Return+.05 or (cast.ended and n-cast.ended>.3) then cast=nil end
        elseif cast.kind=="Ultra" then
            ---------------------------------------------------------------- R
            local cfg=A.PlusUltra
            local gather=easeOut(a/cfg.Windup,2)
            local dashK=cast.dash and window(n,cast.dash,cast.dash+cfg.DashTime) or 0
            local raised=fist(Vector3.new(.42,-.06,-.8),Vector3.new(-.15,.8,-.6),Vector3.new(-.8,-.1,-.5),rollingCurl(gather,.7,1),1,Vector3.new(.95,-.9,0),.8)
            local drawnBack=fist(Vector3.new(.84,-.42,-.42),Vector3.new(-.4,.35,-.9),Vector3.new(-.2,-1,0),1,1,Vector3.new(1.12,-.95,.42),1)
            R=blend(blend(R,raised,gather),drawnBack,easeOut(dashK/.4,2))
            L=blend(L,fist(Vector3.new(-.5,-.62,-.82),Vector3.new(.2,.5,-1),Vector3.new(.8,-.4,0),1,.7,Vector3.new(-1,-1.02,.1)),gather)
            local look=CFrame.Angles(-.12*gather*(1-dashK),0,0)
            out.fov=72-8*gather*(1-dashK)+22*easeOut(dashK,2)
            vignette=.45*gather*(1-dashK)
            lines=dashK>0 and dashK<1 and 1 or 0;linesColor=COLORS.Speed
            if cast.fail then
                local k=n-cast.fail
                R=blend(R,fist(Vector3.new(.3,-.7,-.7),Vector3.new(0,.2,-1),Vector3.new(0,-1,0),.8,.3),smoothstep(k/.2))
                look=look*CFrame.Angles(-.08*math.sin(math.clamp(k/.5,0,1)*math.pi),0,.05*math.sin(math.clamp(k/.5,0,1)*math.pi))
                lines=0
                if k>.7 then cast=nil end
            end
            if cast and cast.contact then
                local c=animTime(n,cast.contact)
                local targetRoot=rootOf(cast.target)
                local punch1=easeOut(c/cfg.Punch1,3)
                local chase=window(c,cfg.Lift,cfg.ChaseEnd)
                local wind=window(c,cfg.ChaseEnd,cfg.WindEnd)
                local upper=easeOut((c-cfg.WindEnd)/(cfg.Uppercut-cfg.WindEnd),3)
                local sky=window(c,cfg.Uppercut+.15,cfg.Settle)
                local lower=smoothstep((c-cfg.Settle-.35)/(cfg.End-cfg.Settle-.35))
                local first=fist(Vector3.new(.05,-.2,-1.5),Vector3.new(0,.08,-1),Vector3.new(0,-1,0),1,1,Vector3.new(.62,-.82,-.42),1)
                local under=fist(Vector3.new(.62,-1.0,-.62),Vector3.new(-.2,.9,-.3),Vector3.new(-.9,0,-.3),1,.8,Vector3.new(1.0,-1.15,.2),.8)
                local jab=fist(Vector3.new(.22,-.12,-1.3),Vector3.new(-.05,.55,-.8),Vector3.new(-.2,-.6,-.6),1,1,Vector3.new(.7,-.85,-.3),.9)
                local coiled=fist(Vector3.new(.88,-.72,-.36),Vector3.new(-.3,.7,-.6),Vector3.new(-.6,-.5,0),1,1,Vector3.new(1.18,-1.0,.45),1)
                local skyward=fist(Vector3.new(.24,.34,-.86),Vector3.new(-.05,1,-.15),Vector3.new(-.6,0,-.8),1,1,Vector3.new(.7,-.6,-.1),1)
                local jabK=math.sin(window(c,cfg.Punch2-.1,cfg.Punch2+.12)*math.pi)
                local pose=blend(R,first,punch1)
                pose=blend(pose,under,smoothstep(window(c,cfg.Lift-.1,cfg.Lift+.25)))
                pose=blend(pose,jab,jabK)
                pose=blend(pose,coiled,easeOut(wind/.6,2))
                pose=blend(pose,skyward,upper)
                pose=blend(pose,restFor(1),lower)
                R=pose
                L=blend(L,fist(Vector3.new(-.6,-.78,-.66),Vector3.new(.2,.6,-.7),Vector3.new(.9,-.2,0),1,.8,Vector3.new(-1.05,-1.0,.3)),math.min(1,punch1+wind))
                -- Camera: assist toward the target while chasing, a short cinematic for the wind-up and the
                -- uppercut, then first person again looking up as the target becomes a light in the sky.
                look=CFrame.identity
                local assist=smoothstep(window(c,cfg.Lift-.1,cfg.Lift+.3))*(1-smoothstep(window(c,cfg.Uppercut+.15,cfg.Uppercut+.45)))
                if targetRoot and assist>0 then look=lookToward(camera,targetRoot.Position+Vector3.yAxis*.5,.55*assist,1.1) end
                local skyLook=smoothstep(window(c,cfg.Uppercut+.1,cfg.Uppercut+.5))*(1-smoothstep(window(c,cfg.Settle+.2,cfg.End)))
                if skyLook>0 then
                    local point=targetRoot and targetRoot.Position or cast.apex
                    if cast.apexAt and cast.apex then point=cast.apex end
                    if point then look=look*lookToward(camera,point,skyLook,1.4) end
                end
                cinematic=smoothstep(window(c,cfg.ChaseEnd-.05,cfg.ChaseEnd+.3))*(1-smoothstep(window(c,cfg.Uppercut+.08,cfg.Uppercut+.42)))
                local fov=94-14*chase-14*wind+30*upper
                fov=fov*(1-sky)+76*sky
                out.fov=fov*(1-lower)+72*lower
                vignette=.4*wind*(1-upper)+.2*chase
                lines=math.max(chase*.7*(1-wind),upper*(1-sky))
                linesColor=c>=cfg.Uppercut and COLORS.Gold or COLORS.Wind
                if c>=cfg.Lift and c<cfg.ChaseEnd then lineCenter=Vector2.new(.5,.2) end
                local f1=1-smoothstep((c-cfg.Punch1)/.25)
                if c>=cfg.Punch1 then flash=math.max(flash,.75*f1);flashColor=Color3.new(1,1,1);lines=math.max(lines,f1) end
                if cast.uppercut then
                    local k=1-smoothstep((n-cast.uppercut-.12)/.4)
                    flash=math.max(flash,.95*k);flashColor=Color3.fromRGB(255,240,190);contrast=.5*k
                end
                if c>=cfg.ChaseEnd and not cast.plus then
                    cast.plus=true
                    shout("PLUS...",cfg.Uppercut-cfg.ChaseEnd+.05,"",COLORS.Gold)
                    if m and rootOf(m) then VFX.sound("Heartbeat",rootOf(m).Position,.9,1.2);VFX.sound("VoicePlus",rootOf(m).Position,.9,1.5) end
                end
                if cast.uppercut and not cast.steamed then
                    cast.steamed=true
                    VFX.steam(function() return (camera.CFrame*CFrame.new(.24,.3,-.9)).Position end,cfg.End-cfg.Uppercut,.06)
                end
                if c>cfg.End+.1 then cast=nil end
            end
            if cast then env.commonLook(look) end
            if cast and cast.ended and n-cast.ended>.4 then cast=nil end
        end
    end
    -- The cinematic shot blends from the first-person camera and back; the body is shown only while it lasts.
    if cinematic>.001 and cast and cast.target and m and rootOf(m) and rootOf(cast.target) then
        local shot=cinematicFrame(camera,rootOf(m),rootOf(cast.target),cast.direction or Vector3.new(0,0,-1))
        local blended=camera.CFrame:Lerp(shot,smoothstep(cinematic))
        env.commonLook(camera.CFrame:Inverse()*blended)
        revealBody(m,cinematic>.25)
        if cinematic>.25 then visible=false end
    elseif next(revealed) then revealBody(nil,false) end
    -- Camera shake, decaying over its duration.
    if n<shake.untilTime then
        local k=(shake.untilTime-n)/math.max(.01,shake.duration)
        local p=shake.power*k
        env.commonLook(CFrame.new((math.random()-.5)*p*4,(math.random()-.5)*p*4,0)*CFrame.Angles((math.random()-.5)*p,(math.random()-.5)*p,(math.random()-.5)*p*.6))
    end
    if n<fatigueUntil then vignette=math.max(vignette,.25*(fatigueUntil-n)/1.2) end
    -- Narrow screens squeeze the arms inward, as for the other kits.
    local squeeze=math.min(1,camera.ViewportSize.X/math.max(1,camera.ViewportSize.Y))
    local function narrow(pose)
        local f=pose.frame
        pose.frame=CFrame.new(f.Position*Vector3.new(math.max(.72,squeeze),1,1))*f.Rotation
        if pose.shoulder then pose.shoulder=pose.shoulder*Vector3.new(math.max(.8,squeeze),1,1) end
        return pose
    end
    poseArm(arms.right,narrow(R),visible)
    poseArm(arms.left,narrow(L),visible)
    setOverlay(vignette,lines,linesColor,flash,flashColor,contrast,lineCenter)
    -- Never draw our own hair or suit pieces into the first-person view (the cinematic shows the whole body).
    if m and cinematic<=.25 then
        for _,v in m:GetChildren() do if v:IsA("BasePart") and string.sub(v.Name,1,8)=="AllMight" then v.LocalTransparencyModifier=1 end end
    end
    local rWindow=n<comboUntil
    if rWindow then out.combo="SMASH 적중 · 지금 R  PLUS ULTRA로 연계"
    elseif buffed then out.combo=string.format("ONE FOR ALL  ·  FULL POWER   %.1f초",buffUntil-n) end
    out.rReady=rWindow
    return out
end
-- Victim side: the server moves the body; locally the humanoid stops fighting it.
function AllMightClient.updateVictims(n)
    local m=player.Character;local h=m and m:FindFirstChildOfClass("Humanoid")
    if not h then return end
    local held=(m:GetAttribute("AllMightHeldUntil") or 0)>n
    if held~=heldApplied then
        heldApplied=held
        h.PlatformStand=held
        h:SetStateEnabled(Enum.HumanoidStateType.Jumping,not held)
        if not held then h:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end
    -- Runs after PainClient each frame, so it decides jumping with every kit's locks in view.
    local locked=held or (m:GetAttribute("AllMightNoJumpUntil") or 0)>n or (m:GetAttribute("PainNoJumpUntil") or 0)>n or (m:GetAttribute("PainHeldUntil") or 0)>n
    h:SetStateEnabled(Enum.HumanoidStateType.Jumping,not locked)
end
function AllMightClient.busy() return cast~=nil end
function AllMightClient.buffed() return clock()<buffUntil end
function AllMightClient.reset()
    cast=nil;comboUntil=0;shake.untilTime=0;freeze.length=0;buffUntil=0;fatigueUntil=0
    revealBody(nil,false)
    if overlay.root then setOverlay(0,0,nil,0,nil,0) end
end
function AllMightClient.init(environment)
    env=environment
    arms.right=buildArm(1);arms.left=buildArm(-1)
    buildOverlay()
    UIS.WindowFocusReleased:Connect(function() shake.untilTime=0 end)
end
return AllMightClient
]]></ProtectedString>
					<string name="ScriptGuid">{08562B00-EA87-C9E1-B23E-CDBA3D30A03A}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">AllMightClient</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">8106f0ceb77e32d556109b0cad6d7340</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX986E4ABE680BCFEC581E9FD130CF8656">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Tendo Pain on the client: first-person Akatsuki arms (sleeves, red clouds, black nails, moving fingers),
-- camera work for each technique, screen overlays, and the local side of being pulled, thrown or sealed.
-- Gojo.client.luau owns input and the shared HUD; it forwards Pain* events here and asks for the arm pose
-- every frame. All judgement stays on the server.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local UIS=game:GetService("UserInputService")
local P=require(RS:WaitForChild("PainAbilityConfig"))
local VFX=require(RS:WaitForChild("PainVFX"))
local COLORS=P.Colors
local player=Players.LocalPlayer
local smoothstep=VFX.smoothstep
local function clock() return workspace:GetServerTimeNow() end

local PainClient={}
local env
local cast=nil          -- the local player's own technique in progress
local chibakuViews={}   -- [owner userId] = VFX handle
local sealed={}         -- [model] = true while hidden inside a sphere
local heldApplied=false
local comboUntil=0
local shake={untilTime=0,power=0}
local afterBlurUntil=0

---------------------------------------------------------------- arms
-- Hand frame: origin at the wrist, +Y toward the fingertips, palm facing -Z, back of the hand +Z.
-- The thumb sits on -X for the right hand and +X for the left (palm forward, as seen from behind).
local arms={}
local function vmPart(model,name,size,color,shape,material)
    local p=Instance.new("Part");p.Name=name;p.Size=size;p.Color=color;p.Shape=shape or Enum.PartType.Block
    p.Material=material or Enum.Material.SmoothPlastic;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
    p.CastShadow=false;p.Transparency=1;p.Parent=model
    return p
end
local FINGERS={ -- x offset along the knuckles from the thumb side, proximal/distal length, spread angle
    {x=.056,a=.078,b=.062,spread=.12},{x=.019,a=.084,b=.066,spread=.03},{x=-.019,a=.078,b=.062,spread=-.06},{x=-.054,a=.064,b=.05,spread=-.16},
}
local function buildArm(side)
    local m=Instance.new("Model");m.Name=side>0 and "PainRightArm" or "PainLeftArm";m.Parent=env.viewmodel
    local thumbSide=side>0 and -1 or 1
    local a={side=side,thumbSide=thumbSide,model=m,fingers={}}
    a.sleeve=vmPart(m,"Sleeve",Vector3.new(.86,.27,.27),COLORS.Sleeve,Enum.PartType.Cylinder)
    a.cuff=vmPart(m,"SleeveCuff",Vector3.new(.12,.34,.34),COLORS.Sleeve,Enum.PartType.Cylinder)
    a.lining=vmPart(m,"SleeveLining",Vector3.new(.02,.3,.3),Color3.fromRGB(150,22,32),Enum.PartType.Cylinder)
    a.clouds={}
    for i=1,2 do
        local rim,cloud={}, {}
        for j=1,3 do
            rim[j]=vmPart(m,"CloudRim",Vector3.new(.012,.085,.085),COLORS.CloudRim,Enum.PartType.Cylinder)
            cloud[j]=vmPart(m,"Cloud",Vector3.new(.014,.07,.07),COLORS.Cloud,Enum.PartType.Cylinder)
        end
        a.clouds[i]={rim=rim,cloud=cloud}
    end
    a.palm=vmPart(m,"Palm",Vector3.new(.17,.19,.06),COLORS.Skin)
    a.wrist=vmPart(m,"Wrist",Vector3.new(.13,.1,.075),COLORS.Skin)
    for i,f in FINGERS do
        a.fingers[i]={def=f,prox=vmPart(m,"Finger",Vector3.new(.036,f.a,.036),COLORS.Skin),dist=vmPart(m,"Finger",Vector3.new(.033,f.b,.033),COLORS.Skin),
            nail=vmPart(m,"Nail",Vector3.new(.03,.026,.01),COLORS.Nail,nil,Enum.Material.Glass)}
    end
    a.thumb={prox=vmPart(m,"Thumb",Vector3.new(.04,.07,.04),COLORS.Skin),dist=vmPart(m,"Thumb",Vector3.new(.036,.058,.036),COLORS.Skin),
        nail=vmPart(m,"Nail",Vector3.new(.032,.026,.01),COLORS.Nail,nil,Enum.Material.Glass)}
    return a
end
-- Builds a hand frame from where the fingers point and which way the palm faces.
local function handFrame(position,fingerDir,palmNormal)
    local y=fingerDir.Unit
    local z=-(palmNormal-y*palmNormal:Dot(y))
    if z.Magnitude<.01 then z=Vector3.zAxis end
    z=z.Unit
    local x=y:Cross(z)
    return CFrame.fromMatrix(position,x,y,z)
end
PainClient.handFrame=handFrame
-- curl: 0 straight .. 1 fist. claw bends only the fingertips. spread fans the fingers.
local function poseArm(a,frame,curl,claw,spread,visible,perFinger)
    local cam=workspace.CurrentCamera.CFrame
    local world=cam*frame
    local function put(p,cf) p.CFrame=cf;p.Transparency=visible and 0 or 1 end
    local alongArm=CFrame.Angles(0,0,math.pi/2)
    put(a.sleeve,world*CFrame.new(0,-.5,.02)*alongArm)
    put(a.cuff,world*CFrame.new(0,-.1,.01)*alongArm)
    put(a.lining,world*CFrame.new(0,-.035,.01)*alongArm)
    -- Two red clouds with white rims on the top of the sleeve (the side facing the camera).
    -- The discs face +Z of the hand frame; in the disc frame -X points into the sleeve.
    for i,c in a.clouds do
        local base=world*CFrame.new(a.side*(i==2 and .04 or -.02),-.3-i*.22,.137)*CFrame.Angles(0,math.pi/2,0)
        for j=1,3 do
            local offset=({Vector3.new(0,0,0),Vector3.new(0,.045,-.04),Vector3.new(0,-.035,.045)})[j]
            put(c.rim[j],base*CFrame.new(-.002,offset.Y,offset.Z))
            put(c.cloud[j],base*CFrame.new(-.009,offset.Y,offset.Z))
        end
    end
    put(a.wrist,world*CFrame.new(0,.0,0))
    put(a.palm,world*CFrame.new(0,.1,0))
    for i,f in a.fingers do
        local d=f.def
        local c=math.clamp(perFinger and perFinger[i] or curl,0,1)
        local base=world*CFrame.new(d.x*a.thumbSide,.195,0)
        local prox=base*CFrame.Angles(0,0,-a.thumbSide*d.spread*(spread or 0))*CFrame.Angles(-c*1.5,0,0)
        put(f.prox,prox*CFrame.new(0,d.a/2,0))
        local dist=prox*CFrame.new(0,d.a,0)*CFrame.Angles(-(c*1.25+(claw or 0)*.95),0,0)
        put(f.dist,dist*CFrame.new(0,d.b/2,0))
        put(f.nail,dist*CFrame.new(0,d.b-.014,.018))
    end
    local tc=math.clamp(perFinger and perFinger[5] or curl,0,1)
    local thumb=world*CFrame.new(a.thumbSide*.08,.06,-.015)*CFrame.Angles(0,0,-a.thumbSide*(.8-.55*tc))*CFrame.Angles(-.35-tc*.5,0,0)
    put(a.thumb.prox,thumb*CFrame.new(0,.035,0))
    local tip=thumb*CFrame.new(0,.07,0)*CFrame.Angles(-tc*.9,0,0)
    put(a.thumb.dist,tip*CFrame.new(0,.029,0))
    put(a.thumb.nail,tip*CFrame.new(0,.046,.02))
end
-- The chakra receiver: a black rod with ringed segments, held in the left fist.
local rod={}
local function buildRod()
    local m=Instance.new("Model");m.Name="ChakraReceiver";m.Parent=env.viewmodel
    rod.shaft=vmPart(m,"Shaft",Vector3.new(.034,.034,1.15),Color3.fromRGB(16,15,20),nil,Enum.Material.Metal)
    rod.tip=vmPart(m,"Tip",Vector3.new(.022,.022,.16),Color3.fromRGB(30,28,36),nil,Enum.Material.Metal)
    rod.rings={}
    for i=1,5 do rod.rings[i]=vmPart(m,"Ring",Vector3.new(.012,.05,.05),Color3.fromRGB(40,38,48),Enum.PartType.Cylinder,Enum.Material.Metal) end
end
local function poseRod(frame,grow,visible)
    local cam=workspace.CurrentCamera.CFrame
    local length=1.15*grow
    local function put(p,cf,t) p.CFrame=cam*cf;p.Transparency=visible and (t or 0) or 1 end
    rod.shaft.Size=Vector3.new(.034,.034,math.max(.01,length))
    put(rod.shaft,frame*CFrame.new(0,0,-length/2+.25))
    put(rod.tip,frame*CFrame.new(0,0,-length+.17))
    for i,r in rod.rings do put(r,frame*CFrame.new(0,0,.15-length*(i/6))*CFrame.Angles(0,math.pi/2,0),grow<i/6 and 1 or 0) end
end

---------------------------------------------------------------- screen
local overlay={}
local function buildOverlay()
    local gui=env.gui
    local frame=Instance.new("Frame");frame.Name="PainOverlay";frame.Size=UDim2.fromScale(1,1);frame.BackgroundTransparency=1;frame.ZIndex=4;frame.Parent=gui
    overlay.root=frame
    -- Vignette from four gradient edges.
    overlay.edges={}
    for i,spec in {{UDim2.fromScale(1,.3),UDim2.fromScale(0,0),90},{UDim2.fromScale(1,.3),UDim2.fromScale(0,.7),-90},{UDim2.fromScale(.25,1),UDim2.fromScale(0,0),0},{UDim2.fromScale(.25,1),UDim2.fromScale(.75,0),180}} do
        local e=Instance.new("Frame");e.Size=spec[1];e.Position=spec[2];e.BackgroundColor3=Color3.fromRGB(6,2,14);e.BorderSizePixel=0;e.BackgroundTransparency=1;e.ZIndex=4;e.Parent=frame
        local g=Instance.new("UIGradient");g.Rotation=spec[3];g.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)});g.Parent=e
        overlay.edges[i]=e
    end
    -- Faint Rinnegan rings over the whole view: the caster's eyes flaring.
    overlay.rings={}
    for i=1,4 do
        local r=Instance.new("Frame");r.AnchorPoint=Vector2.new(.5,.5);r.Position=UDim2.fromScale(.5,.5);r.SizeConstraint=Enum.SizeConstraint.RelativeYY
        r.Size=UDim2.fromScale(.35+i*.22,.35+i*.22);r.BackgroundTransparency=1;r.ZIndex=4;r.Parent=frame
        local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(.5,0);corner.Parent=r
        local stroke=Instance.new("UIStroke");stroke.Color=COLORS.Rinnegan;stroke.Thickness=2+i;stroke.Transparency=1;stroke.Parent=r
        overlay.rings[i]=stroke
    end
    overlay.flash=Instance.new("Frame");overlay.flash.Size=UDim2.fromScale(1,1);overlay.flash.BackgroundColor3=Color3.new(1,1,1)
    overlay.flash.BackgroundTransparency=1;overlay.flash.BorderSizePixel=0;overlay.flash.ZIndex=5;overlay.flash.Parent=frame
end
local function setOverlay(vignette,rings,flash)
    for _,e in overlay.edges do e.BackgroundTransparency=1-math.clamp(vignette,0,1) end
    for i,s in overlay.rings do s.Transparency=1-math.clamp(rings*(1.1-i*.18),0,1) end
    overlay.flash.BackgroundTransparency=1-math.clamp(flash,0,.9)
end
local function kick(power,duration) if power>=shake.power or clock()>shake.untilTime then shake.power=power;shake.untilTime=clock()+duration;shake.duration=duration end end

---------------------------------------------------------------- events
local function ownerModel(data)
    local owner=Players:GetPlayerByUserId(data.owner)
    return owner and owner.Character,owner==player
end
function PainClient.onEvent(kind,data)
    local model,mine=ownerModel(data)
    local root=model and model:FindFirstChild("HumanoidRootPart")
    if kind=="PainShinraCast" then
        VFX.eyeFlare(model,1,.9)
        if root then VFX.sound("Hum",root.Position,.8,2) end
        if mine then cast={kind="Shinra",start=data.start};env.announce("神羅天征","신라천정 · 반경 25 · 손바닥을 펴는 순간 밀어낸다") end
    elseif kind=="PainShinraWave" then
        VFX.shinraWave(data.position,data.radius,data.duration)
        if mine then kick(.05,.12) end
        local me=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not mine and me and (me.Position-data.position).Magnitude<data.radius*1.6 then kick(.02,.2) end
    elseif kind=="PainKnock" then
        VFX.knockTrail(data.model,data.duration)
        if data.model==player.Character then kick(.04,.25) end
    elseif kind=="PainWallHit" then
        VFX.wallHit(data.position,data.normal)
    elseif kind=="PainBanshoCast" then
        VFX.eyeFlare(model,1,.9)
        VFX.aimRings(data.target,.6)
        if root then VFX.sound("Whoosh",root.Position,.5,1.5) end
        if mine then cast={kind="Bansho",start=data.start,target=data.target,windup=data.windup};env.announce("万象天引","만상천인 · 대상을 끌어당겨 차크라 수신기로 찌른다") end
    elseif kind=="PainBanshoMiss" then
        if mine then cast={kind="BanshoMiss",start=data.start};env.announce("万象天引","조준 범위 안에 보이는 대상이 없다") end
    elseif kind=="PainBanshoPull" then
        VFX.pullField(data.target,model,data.duration+.15)
        if mine and cast and cast.kind=="Bansho" then cast.pullStart=data.start;cast.pullDuration=data.duration end
    elseif kind=="PainBanshoStrike" then
        local direction=root and (data.position-root.Position) or Vector3.zAxis
        VFX.stabImpact(data.position,direction)
        if mine and cast and cast.kind=="Bansho" then cast.strike=clock();kick(.035,.1);comboUntil=clock()+1.8 end
    elseif kind=="PainBanshoCancel" then
        if mine and cast and cast.kind=="Bansho" then cast.cancel=clock() end
    elseif kind=="PainChibakuCast" then
        VFX.eyeFlare(model,2,6.3)
        if chibakuViews[data.owner] then chibakuViews[data.owner].stop("replaced") end
        local originFn=nil
        if mine then
            cast={kind="Chibaku",start=data.start,core=data.core}
            originFn=function() return (workspace.CurrentCamera.CFrame*CFrame.new(0,-.28,-.66)).Position end
            env.announce("地爆天星","지폭천성 · 중력 핵 · 바위와 적을 끌어모아 봉인한다")
        end
        chibakuViews[data.owner]=VFX.chibaku(data,{originFn=originFn})
        if root then for i=0,2 do task.delay(i*.4,function() VFX.sound("Thud",root.Position,.8,1.5,.8) end) end end
    elseif kind=="PainChibakuCapture" then
        if data.target==player.Character then env.announce("地爆天星","중력장에 붙잡혔다 · 이동·점프 불가") end
    elseif kind=="PainChibakuBurst" then
        if mine then kick(.09,.45);if cast then cast.burst=clock() end end
        local me=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not mine and me and (me.Position-data.core).Magnitude<120 then kick(.04,.4) end
    elseif kind=="PainChibakuEnd" then
        local view=chibakuViews[data.owner]
        if view and data.reason~="finished" then view.stop(data.reason) end
        chibakuViews[data.owner]=nil
        if mine then afterBlurUntil=clock()+1;if cast and cast.kind=="Chibaku" and data.reason~="finished" then cast=nil end end
    end
end

---------------------------------------------------------------- per frame
local ZERO5={0,0,0,0,0}
local function restPose(side,bob,moving)
    local x=side*.36
    local sway=moving and math.sin(clock()*9)*.018*side or 0
    local pos=Vector3.new(x+sway*.5,-.6+bob,-.8)
    return handFrame(pos,Vector3.new(-side*.18,.82,-.55),Vector3.new(-side*.9,-.1,-.4)),.5,.15,0
end
-- Returns the screen-space look offset that turns the camera toward a world point by `k`.
local function lookToward(camera,point,k,maxPitch)
    local d=camera.CFrame:VectorToObjectSpace((point-camera.CFrame.Position).Unit)
    local yaw=math.atan2(-d.X,-d.Z);local pitch=math.clamp(math.atan2(d.Y,math.sqrt(d.X*d.X+d.Z*d.Z)),-maxPitch,maxPitch)
    return CFrame.Angles(0,yaw*k,0)*CFrame.Angles(pitch*k,0,0)
end
-- info: {melee, sliding, moving, alive, humanoid}. Returns {fov, lean, combo} for Gojo.client.
function PainClient.render(dt,info)
    local n=clock()
    local camera=workspace.CurrentCamera
    if not arms.right then return end
    local isPain=info.isPain
    local out={fov=72,lean=0}
    local vignette,ringGlow,flash=0,0,0
    -- Victims (any kit): sealed bodies are hidden, held bodies lose control locally.
    PainClient.updateVictims(n,info)
    if not isPain then
        poseArm(arms.right,CFrame.identity,0,0,0,false);poseArm(arms.left,CFrame.identity,0,0,0,false);poseRod(CFrame.identity,0,false)
        setOverlay(0,0,0);cast=nil
        return nil
    end
    local bob=info.moving and math.abs(math.sin(n*9))*.025 or math.sin(n*1.8)*.006
    local rF,rCurl,rClaw,rSpread=restPose(1,bob,info.moving)
    local lF,lCurl,lClaw,lSpread=restPose(-1,bob,info.moving)
    local rStagger,lStagger=nil,nil
    local rodFrame,rodGrow=nil,0
    local visible=info.alive
    -- Shared M1 punches and the slide still work: fists follow Gojo.client's melee timing.
    if info.melee then
        local m=info.melee;local a=n-m.start
        local wind=smoothstep(a/m.windup);local strike=smoothstep((a-m.windup)/m.swing)
        local recovery=smoothstep((a-m.windup-m.swing)/(m.duration-m.windup-m.swing))
        local sign=m.combo%2==0 and -1 or 1
        local guard=Vector3.new(sign*.42,-.42,-.78);local prep=Vector3.new(sign*.6,m.combo==3 and -.7 or -.38,-.5)
        local contact=Vector3.new(sign*.06,m.combo==3 and -.1 or -.26,-1.35)
        local fist=guard:Lerp(prep,wind):Lerp(contact,strike):Lerp(guard,recovery)
        local frame=handFrame(fist,Vector3.new(-sign*.1,.25,-1),Vector3.new(-sign*.6,-.8,0))
        if sign>0 then rF=frame;rCurl=1;rClaw=0 else lF=frame;lCurl=1;lClaw=0 end
    end
    if info.sliding then
        rF=rF*CFrame.new(0,-.1,.08)*CFrame.Angles(.4,0,0);lF=lF*CFrame.new(0,-.1,.08)*CFrame.Angles(.4,0,0)
    end
    if cast and not info.alive then cast=nil end
    if cast then
        local a=n-cast.start
        if cast.kind=="Shinra" then
            local cfg=P.ShinraTensei
            local raise=smoothstep(a/cfg.Windup)
            local push=smoothstep((a-cfg.Windup)/.07)
            local settle=smoothstep((a-cfg.Windup-cfg.WaveTime)/cfg.Recovery)
            -- Chest height, palm turning forward, then a hard push and a slow lowering.
            local chest=Vector3.new(.2,-.36,-.6);local thrust=Vector3.new(.12,-.24,-1.05)
            local restPos=rF.Position
            local pos=restPos:Lerp(chest,raise):Lerp(thrust,push)
            pos=pos:Lerp(restPos,settle)
            local fingers=Vector3.new(-.18,.82,-.55):Lerp(Vector3.new(0,1,-.12),raise):Lerp(Vector3.new(0,1,.05),push)
            local palm=Vector3.new(-.9,-.1,-.4):Lerp(Vector3.new(0,0,-1),raise)
            if settle>0 then fingers=fingers:Lerp(Vector3.new(-.18,.82,-.55),settle);palm=palm:Lerp(Vector3.new(-.9,-.1,-.4),settle) end
            rF=handFrame(pos,fingers,palm)
            -- Fingers open one by one: index, middle, ring, pinky, then the thumb; the push spreads them flat.
            rStagger={}
            for i=1,5 do
                local open=smoothstep((a-.06-.07*(i-1))/.1)
                rStagger[i]=(.85-.65*open)*(1-push)*(1-settle)+.5*settle
            end
            rCurl=.5;rClaw=0;rSpread=math.min(1,raise*.5+push)*(1-settle)
            lF=lF*CFrame.new(-.03,-.06*raise*(1-settle),.04)
            -- Head bows, the view narrows and darkens until the push, then a kick and a slow recovery.
            local bow=raise*(1-settle)
            env.commonLook(CFrame.Angles(-math.rad(6)*bow,0,0))
            out.fov=72-8*raise+22*push*(1-smoothstep((a-cfg.Windup)/.35))
            if a>=cfg.Windup then out.fov=math.max(out.fov,72+20*(1-smoothstep((a-cfg.Windup)/.35))) end
            vignette=.45*raise*(1-push*.6)*(1-settle);ringGlow=raise*(1-settle)*.6+push*(1-settle)*.4
            flash=.18*(1-smoothstep((a-cfg.Windup)/.12))*push
            if a>cfg.Windup+cfg.WaveTime+cfg.Recovery+.1 then cast=nil end
        elseif cast.kind=="Bansho" or cast.kind=="BanshoMiss" then
            local cfg=P.BanshoTenin
            local target=cast.target and cast.target:FindFirstChild("HumanoidRootPart")
            local toward=target and camera.CFrame:VectorToObjectSpace((target.Position-camera.CFrame.Position).Unit) or Vector3.new(0,0,-1)
            local reach=smoothstep(a/(cast.kind=="BanshoMiss" and .14 or cfg.Windup))
            local retract=0
            if cast.kind=="BanshoMiss" then retract=smoothstep((a-.18)/.17)
            elseif cast.cancel then retract=smoothstep((n-cast.cancel)/.25)
            elseif cast.strike then retract=smoothstep((n-cast.strike-.15)/.35) end
            -- Right arm shoots out toward the target, palm open and fingers bent to grab.
            local out1=Vector3.new(.24,-.2,-.98)+Vector3.new(toward.X,toward.Y,0)*.25
            local held=Vector3.new(.3,-.27,-.74)
            local pullK=cast.pullStart and smoothstep((n-cast.pullStart)/(cast.pullDuration or .6)) or 0
            local pos=rF.Position:Lerp(out1,reach):Lerp(held,pullK*.6)
            pos=pos:Lerp(rF.Position,retract)
            local tremble=cast.pullStart and not cast.strike and Vector3.new(math.sin(n*61),math.cos(n*53),0)*.006 or Vector3.zero
            rF=handFrame(pos+tremble,(toward+Vector3.new(0,.9,0)):Lerp(Vector3.new(-.18,.82,-.55),retract),toward:Lerp(Vector3.new(-.9,-.1,-.4),retract))
            rCurl=.1+.25*pullK+.25*retract;rClaw=(.55+.25*pullK)*(1-retract);rSpread=1-retract
            env.commonLook(CFrame.new(0,0,-.28*reach*(1-pullK)*(1-retract)))
            out.fov=72-4*reach+6*pullK
            ringGlow=.35*reach*(1-retract)
            -- Left hand: the receiver forms as the body arrives, then a straight stab forward.
            if cast.kind=="Bansho" and cast.pullStart and not cast.cancel then
                local arriveAt=cast.pullStart+(cast.pullDuration or .6)
                local form=smoothstep((n-(arriveAt-.3))/.25)
                local stab=cast.strike and smoothstep((n-cast.strike)/.07) or 0
                local back=cast.strike and smoothstep((n-cast.strike-.12)/.3) or 0
                local gone=cast.strike and smoothstep((n-cast.strike-.3)/.2) or 0
                local ready=Vector3.new(-.32,-.36,-.68);local hit=Vector3.new(-.06,-.24,-1.18)
                local lp=lF.Position:Lerp(ready,form):Lerp(hit,stab):Lerp(lF.Position,back)
                lF=handFrame(lp,Vector3.new(.25,.15,-1):Lerp(Vector3.new(.05,.25,-1),stab),Vector3.new(1,-.2,0))
                lCurl=.95;lClaw=0;lSpread=0
                rodFrame=CFrame.lookAt(lp+Vector3.new(.01,.07,0),lp+Vector3.new(.01,.07,0)+Vector3.new(.08,.04,-1):Lerp(Vector3.new(.03,.06,-1),stab))
                rodGrow=form*(1-gone)
                if stab>0 then env.commonLook(CFrame.new(0,0,-.32*stab*(1-back))) end
                if cast.strike then out.fov=out.fov+8*stab*(1-back) end
            end
            local done=(cast.kind=="BanshoMiss" and a>.4) or (cast.cancel and n-cast.cancel>.3) or (cast.strike and n-cast.strike>.6) or a>3
            if done then cast=nil end
        elseif cast.kind=="Chibaku" then
            local cfg=P.ChibakuTensei
            local gather=smoothstep(a/cfg.Gather)
            local lift=smoothstep((a-cfg.Gather)/(cfg.Launch-cfg.Gather))
            local lower=smoothstep((a-cfg.Burst)/.9)
            local strain=smoothstep((a-cfg.FieldStart)/1.5)*(1-lower)
            local tremble=Vector3.new(math.sin(n*47),math.cos(n*41),0)*.006*strain
            -- Both hands come up and cup the forming core, then lift it to the sky and stay raised.
            local cupR,cupL=Vector3.new(.11,-.33,-.62),Vector3.new(-.11,-.33,-.62)
            local upR,upL=Vector3.new(.24,-.02,-.66),Vector3.new(-.24,-.02,-.66)
            local rp=rF.Position:Lerp(cupR,gather):Lerp(upR,lift)
            local lp=lF.Position:Lerp(cupL,gather):Lerp(upL,lift)
            rp=rp:Lerp(rF.Position,lower);lp=lp:Lerp(lF.Position,lower)
            local fingersCup=Vector3.new(0,.6,-.8);local fingersUp=Vector3.new(0,.35,-1)
            rF=handFrame(rp+tremble,fingersCup:Lerp(fingersUp,lift):Lerp(Vector3.new(-.18,.82,-.55),lower),Vector3.new(-1,0,0):Lerp(Vector3.new(-.2,1,-.3),lift):Lerp(Vector3.new(-.9,-.1,-.4),lower))
            lF=handFrame(lp-tremble,fingersCup:Lerp(fingersUp,lift):Lerp(Vector3.new(.18,.82,-.55),lower),Vector3.new(1,0,0):Lerp(Vector3.new(.2,1,-.3),lift):Lerp(Vector3.new(.9,-.1,-.4),lower))
            rCurl=.35*(1-lift)+.12*lift+.38*lower;lCurl=rCurl;rClaw=.3+.4*strain;lClaw=rClaw;rSpread=lift*(1-lower);lSpread=rSpread
            -- Look up slowly while gathering, follow the core into the sky, come back to aiming at 1.9 s.
            local look=CFrame.Angles(math.rad(7)*gather*(1-lift),0,0)
            local follow=math.sin(math.clamp((a-cfg.Gather)/1.1,0,1)*math.pi)
            if follow>0 and cast.core then look=look*lookToward(camera,cast.core,follow*.85,1.2) end
            local shakeRoll=strain*.004*math.sin(n*31)
            env.commonLook(look*CFrame.Angles(shakeRoll,0,shakeRoll))
            out.fov=72-6*gather*(1-lift)+4*strain
            if a>=cfg.FieldStart and not cast.waveKick then cast.waveKick=true;kick(.03,.25) end
            vignette=.25*gather+.2*strain-.4*lower;ringGlow=.5*gather+.4*strain
            if cast.burst then flash=.6*(1-smoothstep((n-cast.burst)/.35)) end
            if a>cfg.Duration+.2 then cast=nil end
        end
    end
    if n<afterBlurUntil then
        local k=(afterBlurUntil-n)
        env.blur.Size=math.max(env.blur.Size,10*k);vignette=math.max(vignette,.3*k)
    end
    -- Camera shake (positional and angular), decaying over its duration.
    if n<shake.untilTime then
        local k=(shake.untilTime-n)/math.max(.01,shake.duration or .1)
        local p=shake.power*k
        env.commonLook(CFrame.new((math.random()-.5)*p*4,(math.random()-.5)*p*4,0)*CFrame.Angles((math.random()-.5)*p,(math.random()-.5)*p,(math.random()-.5)*p))
    end
    -- Narrow screens squeeze the arms inward, as for the other kits.
    local squeeze=math.min(1,camera.ViewportSize.X/math.max(1,camera.ViewportSize.Y))
    local function narrow(f) return CFrame.new(f.Position*Vector3.new(math.max(.72,squeeze),1,1))*f.Rotation end
    poseArm(arms.right,narrow(rF),rCurl,rClaw,rSpread,visible,rStagger)
    poseArm(arms.left,narrow(lF),lCurl,lClaw,lSpread,visible,lStagger)
    poseRod(rodFrame and narrow(rodFrame) or CFrame.identity,rodGrow,visible and rodFrame~=nil and rodGrow>.01)
    setOverlay(vignette,ringGlow,flash)
    out.combo=n<comboUntil and "만상천인 적중 · 이어서 Q 신라천정 / R 지폭천성" or nil
    return out
end
-- Victim side: the server moves the body; locally we stop the humanoid from fighting it.
function PainClient.updateVictims(n,info)
    local m=player.Character;local h=m and m:FindFirstChildOfClass("Humanoid")
    if h then
        local held=(m:GetAttribute("PainHeldUntil") or 0)>n
        if held~=heldApplied then
            heldApplied=held
            h.PlatformStand=held
            h:SetStateEnabled(Enum.HumanoidStateType.Jumping,not held)
            if not held then h:ChangeState(Enum.HumanoidStateType.GettingUp) end
        end
        local noJump=(m:GetAttribute("PainNoJumpUntil") or 0)>n
        if not held then h:SetStateEnabled(Enum.HumanoidStateType.Jumping,not noJump) end
    end
    -- Bodies sealed inside a Chibaku sphere are hidden from everyone else; the server still owns them normally.
    for _,model in workspace:GetChildren() do
        if model:IsA("Model") and model~=player.Character then
            local hide=(model:GetAttribute("PainSealedUntil") or 0)>n
            if hide~=(sealed[model]==true) then
                sealed[model]=hide or nil
                for _,v in model:GetDescendants() do if v:IsA("BasePart") or v:IsA("Decal") then v.LocalTransparencyModifier=hide and 1 or 0 end end
            end
        end
    end
    for model in sealed do if not model.Parent then sealed[model]=nil end end
    -- Never draw our own Rinnegan or sleeves into the first-person view.
    if m and info and info.isPain then
        for _,v in m:GetChildren() do if v:IsA("BasePart") and (v.Name=="PainRinnegan" or v.Name=="PainSleeve" or v.Name=="PainCloud" or v.Name=="PainCloudRim" or v.Name=="PainNails") then v.LocalTransparencyModifier=1 end end
    end
end
function PainClient.busy() return cast~=nil end
function PainClient.reset()
    cast=nil;comboUntil=0;shake.untilTime=0;afterBlurUntil=0
    if overlay.root then setOverlay(0,0,0) end
end
function PainClient.init(environment)
    env=environment
    arms.right=buildArm(1);arms.left=buildArm(-1)
    buildRod();buildOverlay()
    UIS.WindowFocusReleased:Connect(function() shake.untilTime=0 end)
end
return PainClient

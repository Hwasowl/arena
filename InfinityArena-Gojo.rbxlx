    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">GojoConfig</string>
        <string name="Source"><![CDATA[-- Shared tuning; all combat decisions are made by Combat.server.luau.
return {
    MaxEnergy = 100, EnergyRegen = 6, MaxHealth = 200,
    -- Skills each character may request; the server rejects anything outside the player's kit.
    Kits = {
        Gojo = { "Blue", "Red", "Domain", "Dash" },
        Zenitsu = { "Breath", "Thunderclap", "FlameGod", "Dash" },
        Reze = { "Rampage", "Kick", "BombDevil", "Detonation", "Dash" },
        Levi = { "Anchor", "Reel", "Spin", "Burst" },
    },
    Blue = { Cost = 18, Cooldown = 5, Windup = 0.65, Duration = 8, Range = 24, Radius = 14, PullSpeed = 10 },
    Red = { Cost = 22, Cooldown = 7, Windup = 0.45, Damage = 65, Speed = 100, Radius = 3.5, Range = 140 },
    -- Blue and Red are held for up to Hold.Duration before they fire; the other one during the hold makes Purple.
    Hold = { Duration = 3 },
    Purple = { Windup = 1.2, Damage = 180, Speed = 105, Radius = 7, Range = 170 },
    Domain = { Cost = 55, Cooldown = 28, Windup = 2, Duration = 7, Radius = 28, Tick = 0.5, Damage = 8 },
    Dash = { Cost = 8, Cooldown = 2.5, Distance = 16 },
    -- Zenitsu: Breath grants Charges instant Thunderclaps (no windup, cost or cooldown) for ChargeWindow seconds.
    Thunderclap = { Cost = 18, Cooldown = 6, Windup = 2, InstantWindup = 0.05, Distance = 36, Width = 5, Damage = 70 },
    Breath = { Cost = 20, Cooldown = 14, Windup = 2, Charges = 3, ChargeWindow = 12 },
    -- Seventh form: a draw-dash ten times faster than Thunderclap. Victims are hit HitDelay after the pass;
    -- the user pays SelfDamage (never lethal) and moves at SlowFactor speed with Dash locked for SlowDuration.
    FlameGod = { Cost = 50, Cooldown = 25, Windup = 0.8, Duration = 1.6, Distance = 60, Width = 7, Damage = 150, HitDelay = 0.25, SelfDamage = 30, SlowDuration = 4, SlowFactor = 0.4 },
    -- Reze. Human form: only Dash and BombDevil. Pulling the choker pin transforms her with no time limit and heals
    -- Heal of max HP (never past full); Rampage and Kick then work, each costing HpCost of max HP (never lethal).
    -- R again is Detonation: Windup seconds later a huge blast goes off, it costs 12% HP, and she turns human again.
    -- BombDevil can be used again Recharge seconds after she reverts.
    BombDevil = { Cost = 0, Cooldown = 0, Recharge = 20, Windup = 1, Blackout = 2, Heal = 0.2, Radius = 16, Damage = 90, Knockback = 110, Lift = 55 },
    Detonation = { Cost = 0, Cooldown = 0, Windup = 4, HpCost = 0.12, Radius = 30, Damage = 170, Knockback = 130, Lift = 60 },
    -- Rampage: a blast under the feet launches her forward; anyone on the path is blown upward, and the gunpowder
    -- left along the path detonates TrailDelay seconds later.
    Rampage = { Cost = 0, HpCost = 0.03, Cooldown = 5, Windup = 0.12, SlideSpeed = 55, Distance = 30, Width = 5, Damage = 45, Launch = 70, TrailDelay = 1, TrailRadius = 5.5, TrailDamage = 35, TrailLift = 45 },
    -- Kick: a roundhouse. The right foot is raised for most of Windup, then whips right to left. Alone it goes off Reach studs in front of her; used within ComboWindow seconds of
    -- Rampage it continues the Rampage direction as a ComboDistance dash ending in a bigger blast.
    Kick = { Cost = 0, HpCost = 0.03, Cooldown = 4, Windup = 0.38, Reach = 5, Radius = 6, Damage = 45, Knockback = 32, Lift = 28, ComboWindow = 1.3, ComboDistance = 18, Width = 4.5, ComboRadius = 8, ComboDamage = 85, ComboKnockback = 70, ComboLift = 36 },
    -- Levi (ODM gear). Energy is his gas: it refills GasGroundRegen times faster while standing on something.
    -- Anchor: a ray from the crosshair; it holds on walls, pillars and enemies (never the floor). A miss wastes the gas
    -- and locks Anchor for MissCooldown. Reel: pulls the user to the anchor, and opens the Spin window until Grace seconds
    -- after the flight ends. Spin only works inside that window; afterwards the user is rooted for Recovery seconds.
    -- Burst cuts the wire and throws the user along the aim. ThirdPerson pulls the camera out for the spin only.
    GasGroundRegen = 2.5,
    Anchor = { Cost = 10, Cooldown = 1.5, MissCooldown = 3.5, Windup = 0.2, Range = 140, Duration = 7, WireSpeed = 450 },
    Reel = { Cost = 15, Cooldown = 0.6, Windup = 0.05, Speed = 110, Ramp = 0.28, MaxTime = 2.2, StopDistance = 5, ArrivalDamage = 30, ArrivalRadius = 9 },
    Spin = { Cost = 30, Cooldown = 8, Windup = 0.25, Rotation = 0.45, Radius = 22, Damage = 110, Knockback = 70, Lift = 45, Recovery = 0.7, Grace = 0.25, Coast = 0.5, ThirdPerson = false },
    Burst = { Cost = 10, Cooldown = 2.5, Windup = 0.05, Impulse = 95, Lift = 0.15 },
    Colors = { Blue = Color3.fromRGB(35, 180, 255), Red = Color3.fromRGB(255, 54, 94), Purple = Color3.fromRGB(171, 95, 255), Thunder = Color3.fromRGB(255, 210, 63), Bomb = Color3.fromRGB(255, 122, 46), Gas = Color3.fromRGB(176, 226, 200) },
}
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="3">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="4">
      <Properties>
        <string name="Name">Arena</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Config = require(game.ReplicatedStorage:WaitForChild("GojoConfig"))
local arena = Instance.new("Folder")
arena.Name = "InfinityArena"
arena.Parent = workspace
local function part(name, size, cf, color, material, parent)
    local p = Instance.new("Part")
    p.Name, p.Size, p.CFrame = name, size, cf
    p.Color, p.Material = color, material or Enum.Material.Slate
    p.Anchored, p.TopSurface, p.BottomSurface = true, Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.Parent = parent or arena
    return p
end
local dark = Color3.fromRGB(27, 33, 47)
local cyan = Color3.fromRGB(57, 170, 215)
part("Foundation", Vector3.new(150, 4, 150), CFrame.new(0,-3,0), dark)
for x=-7,7 do
    for z=-7,7 do
        local shade = 31 + ((x*7+z*3)%5)*2
        part("StoneTile", Vector3.new(9.88,.35,9.88), CFrame.new(x*10,-.825,z*10), Color3.fromRGB(shade,shade+6,shade+13),Enum.Material.Concrete)
    end
end
for _,radius in {22,42,66} do
    for i=1,100 do
        local a = i*math.pi*2/100
        local p=part("RuneCircle",Vector3.new(.10,.03,radius*.064),CFrame.new(math.cos(a)*radius,-.63,math.sin(a)*radius)*CFrame.Angles(0,-a,0),cyan,Enum.Material.Neon)
        p.CanCollide=false
    end
end
for i=0,11 do
    local a = i*math.pi/6
    local cf=CFrame.new(math.sin(a)*61,0,math.cos(a)*61)*CFrame.Angles(0,a,0)
    for _,side in {-1,1} do
        part("GatePillar",Vector3.new(3,16,3),cf*CFrame.new(side*4,7,0),dark)
        part("LightInset",Vector3.new(.12,11,3.04),cf*CFrame.new(side*4,7,0),cyan,Enum.Material.Neon).CanCollide=false
    end
    part("GateLintel",Vector3.new(13,2,4),cf*CFrame.new(0,15,0),dark)
end
local spawn=Instance.new("SpawnLocation")
spawn.Name="Entry";spawn.Size=Vector3.new(8,.2,8);spawn.CFrame=CFrame.new(0,-.5,23)
spawn.Anchored=true;spawn.Transparency=1;spawn.Neutral=true;spawn.Duration=0;spawn.Parent=arena
local atmosphere=Instance.new("Atmosphere")
atmosphere.Density=.32;atmosphere.Offset=.15;atmosphere.Color=Color3.fromRGB(106,124,164);atmosphere.Decay=Color3.fromRGB(30,38,66);atmosphere.Parent=Lighting
local bloom=Instance.new("BloomEffect")
bloom.Intensity=.65;bloom.Size=28;bloom.Threshold=1.2;bloom.Parent=Lighting
local grade=Instance.new("ColorCorrectionEffect")
grade.Contrast=.13;grade.Saturation=-.1;grade.TintColor=Color3.fromRGB(219,232,255);grade.Parent=Lighting

local function dummy(pos,index)
    local m=Instance.new("Model");m.Name="Training Target "..index
    local root=part("HumanoidRootPart",Vector3.new(2,2,1),CFrame.new(pos),dark,nil,m);root.Transparency=1;root.CanCollide=false
    local h=Instance.new("Humanoid");h.RequiresNeck=false;h.BreakJointsOnDeath=false;h.MaxHealth=250;h.Health=250;h.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.Viewer;h.Parent=m
    local pieces={
        {"Torso",Vector3.new(2,2,1),Vector3.new(0,0,0)},
        {"Head",Vector3.new(1.4,1.4,1.4),Vector3.new(0,1.7,0)},
        {"Left Arm",Vector3.new(.7,2,.8),Vector3.new(-1.5,0,0)},
        {"Right Arm",Vector3.new(.7,2,.8),Vector3.new(1.5,0,0)},
        {"Left Leg",Vector3.new(.8,2,.8),Vector3.new(-.6,-2,0)},
        {"Right Leg",Vector3.new(.8,2,.8),Vector3.new(.6,-2,0)},
    }
    for _,v in pieces do
        local p=part(v[1],v[2],CFrame.new(pos+v[3]),Color3.fromRGB(71,88,113),Enum.Material.Metal,m)
        p.Anchored=false;p.CanCollide=false;p.Massless=true
        local weld=Instance.new("WeldConstraint");weld.Part0=root;weld.Part1=p;weld.Parent=p
    end
    local core=part("Core",Vector3.new(.7,.7,.12),CFrame.new(pos+Vector3.new(0,.15,.56)),cyan,Enum.Material.Neon,m)
    core.Anchored=false;core.CanCollide=false
    local weld=Instance.new("WeldConstraint");weld.Part0=root;weld.Part1=core;weld.Parent=core
    m.PrimaryPart=root;m:SetAttribute("TrainingTarget",true);m.Parent=workspace
    h.Died:Connect(function() task.delay(3,function() m:Destroy();dummy(pos,index) end) end)
end
dummy(Vector3.new(0,3,-12),1);dummy(Vector3.new(-13,3,-20),2);dummy(Vector3.new(13,3,-26),3)

-- Levi's anchors: pillars and low walls to swing between. Same layout as the browser preview (scaled up for studs).
-- Anchors hold on any wall face or pillar side, so they are plain collidable parts; the floor itself never holds a wire.
local stoneTrim=Color3.fromRGB(99,115,132)
local function pillar(x,z,width,height)
    local base=-.65
    part("AnchorPillar",Vector3.new(width,height,width),CFrame.new(x,base+height/2,z),dark,Enum.Material.Concrete)
    part("AnchorPillarCap",Vector3.new(width+.8,1,width+.8),CFrame.new(x,base+height-.5,z),stoneTrim,Enum.Material.Metal)
    local inset=part("AnchorPillarLight",Vector3.new(.15,height*.7,width*.35),CFrame.new(x,base+height*.45,z+width/2+.02),cyan,Enum.Material.Neon)
    inset.CanCollide=false;inset.CanQuery=false
end
local function wall(x,z,sizeX,sizeZ,height)
    part("AnchorWall",Vector3.new(sizeX,height,sizeZ),CFrame.new(x,-.65+height/2,z),dark,Enum.Material.Concrete)
    part("AnchorWallCap",Vector3.new(sizeX+.6,.8,sizeZ+.6),CFrame.new(x,-.65+height-.4,z),stoneTrim,Enum.Material.Metal)
end
for _,v in {{-26,-8,5,35},{26,-12,5,40},{-34,-34,5,30},{36,-28,5,34},{0,-46,6,45},{-20,16,4.5,26},{22,18,4.5,30}} do pillar(v[1],v[2],v[3],v[4]) end
wall(-12,2,20,2,12);wall(14,-3,2,18,12)

-- Only each character's signature piece is added; the rest of the player's own avatar is left untouched.
-- Gojo: blindfold. Zenitsu: sheathed katana. Reze: choker, replaced by the Bomb Devil head while transformed.
-- Levi: hip gas canisters and a white cravat.
-- Parts tagged "Outfit" are rebuilt whenever the character or transformation changes.
local function outfit(character,kind,fresh)
    local h=character:WaitForChild("Humanoid");h.MaxHealth=Config.MaxHealth
    if fresh then h.Health=Config.MaxHealth end
    local head=character:WaitForChild("Head")
    local root=character:WaitForChild("HumanoidRootPart")
    for _,v in character:GetChildren() do if v:GetAttribute("Outfit") then v:Destroy() end end
    -- Undo anything hidden by a previous Bomb Devil head.
    for _,v in character:GetDescendants() do
        local original=v:GetAttribute("OutfitHidden")
        if original~=nil then v.Transparency=original;v:SetAttribute("OutfitHidden",nil) end
    end
    local function attach(anchor,name,size,offset,color,material,shape)
        local p=part(name,size,anchor.CFrame*offset,color,material or Enum.Material.SmoothPlastic,character)
        if shape then p.Shape=shape end
        p.Anchored=false;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Massless=true;p:SetAttribute("Outfit",true)
        local weld=Instance.new("WeldConstraint");weld.Part0=anchor;weld.Part1=p;weld.Parent=p
        return p
    end
    local function hide(v)
        if v:GetAttribute("OutfitHidden")==nil then v:SetAttribute("OutfitHidden",v.Transparency) end
        v.Transparency=1
    end
    local neck=-head.Size.Y/2-.08
    if kind=="Zenitsu" then
        -- Sheathed katana at the left hip, edge up, hilt forward.
        attach(root,"ZenitsuSaya",Vector3.new(.22,.28,3.4),CFrame.new(-1.15,-.9,.6)*CFrame.Angles(.25,.12,0),Color3.fromRGB(43,34,51))
        attach(root,"ZenitsuTsuba",Vector3.new(.5,.5,.08),CFrame.new(-1.05,-.62,-1.0)*CFrame.Angles(.25,.12,0),Color3.fromRGB(42,37,34),Enum.Material.Metal)
        attach(root,"ZenitsuTsuka",Vector3.new(.18,.22,1.1),CFrame.new(-1.0,-.5,-1.55)*CFrame.Angles(.25,.12,0),Color3.fromRGB(241,234,216))
    elseif kind=="Reze" then
        local transformed=(character:GetAttribute("BombDevilUntil") or 0)>workspace:GetServerTimeNow()
        if transformed then
            -- Bomb Devil: the real head and anything worn on it disappear under a bomb-shaped head with fuse hair.
            hide(head)
            for _,v in head:GetChildren() do if v:IsA("Decal") then hide(v) end end
            for _,accessory in character:GetChildren() do
                local handle=accessory:IsA("Accessory") and accessory:FindFirstChild("Handle")
                local weld=handle and handle:FindFirstChildWhichIsA("Weld")
                if weld and (weld.Part0==head or weld.Part1==head) then hide(handle) end
            end
            local metal=Color3.fromRGB(46,44,48)
            local bomb=attach(head,"BombHead",Vector3.one*1.7,CFrame.new(0,.15,0),metal,Enum.Material.Metal,Enum.PartType.Ball)
            attach(head,"BombBand",Vector3.new(1.76,.28,1.76),CFrame.new(0,-.05,0)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(24,22,26),Enum.Material.Metal,Enum.PartType.Cylinder)
            attach(head,"BombCap",Vector3.new(.3,.55,.55),CFrame.new(0,1.05,0)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(120,112,104),Enum.Material.Metal,Enum.PartType.Cylinder)
            for i=-2,2 do
                attach(head,"BombTooth",Vector3.new(.16,.2,.08),CFrame.new(i*.19,-.38,-.8)*CFrame.Angles(0,i*.18,0),Color3.fromRGB(240,236,226))
            end
            for _,x in {-.34,.34} do
                attach(head,"BombEye",Vector3.new(.34,.09,.08),CFrame.new(x,.22,-.82)*CFrame.Angles(0,x*.5,x>0 and -.2 or .2),Color3.new(1,.55,.2),Enum.Material.Neon)
            end
            -- Fuse cords hang from the back and sides like hair, each with a lit tip.
            for i=0,6 do
                local a=math.pi*.15+i*math.pi*.7/6
                local offset=CFrame.new(math.cos(a)*.75,.25,math.sin(a)*.75)*CFrame.Angles(.35*math.sin(a),0,-.35*math.cos(a))
                attach(head,"Fuse",Vector3.new(.1,1.3,.1),offset*CFrame.new(0,-.55,0),Color3.fromRGB(84,62,44))
                local tip=attach(head,"FuseTip",Vector3.one*.16,offset*CFrame.new(0,-1.25,0),Config.Colors.Bomb,Enum.Material.Neon,Enum.PartType.Ball)
                if i%2==0 then local sparks=Instance.new("Sparkles");sparks.SparkleColor=Config.Colors.Bomb;sparks.Parent=tip end
            end
            local light=Instance.new("PointLight");light.Color=Config.Colors.Bomb;light.Brightness=2;light.Range=10;light.Parent=bomb
        else
            -- Choker with the grenade pin ring at the front of the throat.
            attach(head,"RezeChoker",Vector3.new(.24,.92,.92),CFrame.new(0,neck,0)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(16,16,20),Enum.Material.SmoothPlastic,Enum.PartType.Cylinder)
            attach(head,"RezePin",Vector3.new(.06,.3,.3),CFrame.new(0,neck-.12,-.5)*CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(200,204,210),Enum.Material.Metal,Enum.PartType.Cylinder)
        end
    elseif kind=="Levi" then
        -- 3D-maneuver gear: a gas canister on each hip, and the white cravat at the throat.
        for _,side in {-1,1} do
            attach(root,"LeviCanister",Vector3.new(1.3,.55,.55),CFrame.new(side*1.1,-.55,.55)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(70,76,84),Enum.Material.Metal,Enum.PartType.Cylinder)
            attach(root,"LeviCanisterCap",Vector3.new(.2,.62,.62),CFrame.new(side*1.1,.15,.55)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(176,226,200),Enum.Material.Neon,Enum.PartType.Cylinder)
        end
        attach(head,"LeviCravat",Vector3.new(.95,.5,.3),CFrame.new(0,neck+.04,-.52),Color3.fromRGB(240,238,230))
    else
        attach(head,"GojoBlindfold",Vector3.new(head.Size.X*1.04,.42,head.Size.Z*1.08),CFrame.new(0,.1,0),Color3.fromRGB(12,14,23))
    end
end
local function joined(p)
    local function dress(c,fresh) outfit(c,p:GetAttribute("Character") or "Gojo",fresh) end
    p.CharacterAdded:Connect(function(c)
        c:GetAttributeChangedSignal("BombDevilUntil"):Connect(function() dress(c) end)
        dress(c,true)
    end)
    p:GetAttributeChangedSignal("Character"):Connect(function() if p.Character then task.spawn(dress,p.Character) end end)
    if p.Character then
        p.Character:GetAttributeChangedSignal("BombDevilUntil"):Connect(function() dress(p.Character) end)
        task.spawn(dress,p.Character,true)
    end
end
Players.PlayerAdded:Connect(joined);for _,p in Players:GetPlayers() do joined(p) end
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="5">
      <Properties>
        <string name="Name">Combat</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local RS=game:GetService("ReplicatedStorage")
local C=require(RS:WaitForChild("GojoConfig"))
local remote=Instance.new("RemoteEvent");remote.Name="GojoAction";remote.Parent=RS
local fx=Instance.new("RemoteEvent");fx.Name="GojoFX";fx.Parent=RS
local selectRemote=Instance.new("RemoteEvent");selectRemote.Name="SelectCharacter";selectRemote.Parent=RS
local states, blues, projectiles, domains, flights={},{},{},{},{}
local kits={}
for name,list in C.Kits do kits[name]={};for _,skill in list do kits[name][skill]=true end end
local function kitOf(p) local name=p:GetAttribute("Character");return kits[name] and name or "Gojo" end
local BASE_SPEED=game:GetService("StarterPlayer").CharacterWalkSpeed
local now=workspace.GetServerTimeNow
local function clock() return now(workspace) end
local function character(p)
    local m=p.Character
    local h=m and m:FindFirstChildOfClass("Humanoid")
    local r=m and m:FindFirstChild("HumanoidRootPart")
    if h and r and h.Health>0 then return m,h,r end
end
local function targets(exclude)
    local out={}
    for _,m in workspace:GetChildren() do
        if m:IsA("Model") and m~=exclude then
            local h=m:FindFirstChildOfClass("Humanoid");local r=m:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health>0 then table.insert(out,{m=m,h=h,r=r}) end
        end
    end
    return out
end
local function sendState(p,s)
    if p.Parent then remote:FireClient(p,{energy=s.energy,cooldowns=s.cooldowns,blueUntil=s.blueUntil or 0,charges=s.charges,chargesUntil=s.chargesUntil,comboUntil=s.comboUntil or 0,anchorUntil=s.anchor and s.anchor.untilTime or 0,holdKind=s.hold and s.hold.kind or "",holdUntil=s.hold and s.hold.untilTime or 0}) end
end
local function validVector(v)
    return typeof(v)=="Vector3" and v.X==v.X and v.Y==v.Y and v.Z==v.Z and v.Magnitude>.9 and v.Magnitude<1.1
end
local function rayParams(m)
    local p=RaycastParams.new();p.FilterType=Enum.RaycastFilterType.Exclude;p.FilterDescendantsInstances={m};return p
end
local function damage(owner,t,amount)
    if not t.m.Parent or t.h.Health<=0 then return end
    t.h:TakeDamage(amount);fx:FireAllClients("Hit",{position=t.r.Position,damage=amount,owner=owner.UserId})
end
local function cancelBlue(p,s)
    s.blueUntil=0
    if blues[p] then blues[p]=nil;fx:FireAllClients("BlueEnd",{owner=p.UserId}) end
end
-- WalkSpeed is derived from timed attributes so overlapping roots and slows never leave a stale speed behind.
local function updateSpeed(m,h)
    local n=clock();local speed=BASE_SPEED
    if (m:GetAttribute("SlowedUntil") or 0)>n then speed*=C.FlameGod.SlowFactor end
    if (m:GetAttribute("RootedUntil") or 0)>n then speed=0 end
    h.WalkSpeed=speed
end
local function setTimed(m,h,attribute,duration)
    m:SetAttribute(attribute,math.max(m:GetAttribute(attribute) or 0,clock()+duration));updateSpeed(m,h)
    task.delay(duration+.05,function() if m.Parent and h.Parent then updateSpeed(m,h) end end)
end
-- Shared by Thunderclap and FlameGod: dash along `flat`, stopping short of walls, and return who stood on the path.
local function dashStrike(m,r,flat,distance,width)
    local start=r.Position
    local result=workspace:Blockcast(r.CFrame,Vector3.new(3,4,3),flat*distance,rayParams(m))
    local travelled=result and math.max(0,result.Distance-.5) or distance
    local finish=start+flat*travelled
    r.CFrame=CFrame.lookAt(finish,finish+flat)
    local victims={}
    for _,t in targets(m) do
        local along=math.clamp((t.r.Position-start):Dot(flat),0,travelled)
        if (start+flat*along-t.r.Position).Magnitude<=width then table.insert(victims,t) end
    end
    return start,finish,victims
end
-- Knockback. Players own their own physics, so their client applies the impulse; anchored training targets
-- follow a server-simulated arc in the Heartbeat loop; any other unanchored rig takes the velocity directly.
local function launch(t,velocity)
    local victim=Players:GetPlayerFromCharacter(t.m)
    if victim then fx:FireClient(victim,"Knockback",{velocity=velocity})
    elseif t.r.Anchored then
        local f=flights[t.m]
        flights[t.m]={t=t,velocity=velocity,ground=f and f.ground or t.r.Position.Y}
    else t.r.AssemblyLinearVelocity=velocity end
end
local function outward(from,t,fallback)
    local delta=t.r.Position-from;delta=Vector3.new(delta.X,0,delta.Z)
    return delta.Magnitude>.1 and delta.Unit or fallback
end
local function devil(m) return (m:GetAttribute("BombDevilUntil") or 0)>clock() end
local function delayed(p,s,m,delaySeconds,callback)
    local generation=s.generation
    task.delay(delaySeconds,function()
        local current=character(p)
        if states[p]==s and generation==s.generation and current==m and (m:GetAttribute("DomainLockedUntil") or 0)<=clock() then callback() end
    end)
end
-- Starts a technique whose cost and cooldown are already paid: windup, busy time, the Cast broadcast, then the effect.
local function perform(p,s,m,h,r,kind,direction,instant)
    local n=clock()
    local windup=instant and C.Thunderclap.InstantWindup or C[kind].Windup or .2
    s.busyUntil=n+(kind=="FlameGod" and C.FlameGod.Duration or kind=="BombDevil" and windup+C.BombDevil.Blackout or windup)
    fx:FireAllClients("Cast",{owner=p.UserId,kind=kind,position=r.Position,direction=direction,start=n,windup=windup})
    if kind=="Blue" then
        cancelBlue(p,s)
        local desired=r.Position+direction*C.Blue.Range
        local result=workspace:Raycast(r.Position,direction*C.Blue.Range,rayParams(m))
        if result then desired=result.Position-direction*2 end
        desired=Vector3.new(desired.X,math.max(2,desired.Y),desired.Z)
        delayed(p,s,m,C.Blue.Windup,function()
            s.blueUntil=clock()+C.Blue.Duration;blues[p]={position=desired,untilTime=s.blueUntil,model=m}
            fx:FireAllClients("Blue",{owner=p.UserId,position=desired,duration=C.Blue.Duration});sendState(p,s)
        end)
    elseif kind=="Red" or kind=="Purple" then
        if kind=="Purple" then h:ChangeState(Enum.HumanoidStateType.Jumping);r.AssemblyLinearVelocity=Vector3.new(r.AssemblyLinearVelocity.X,42,r.AssemblyLinearVelocity.Z) end
        delayed(p,s,m,C[kind].Windup,function()
            local cfgShot=C[kind];local origin=r.Position+direction*3
            local id=tostring(p.UserId)..":"..tostring(clock())
            table.insert(projectiles,{id=id,owner=p,model=m,position=origin,direction=direction,kind=kind,distance=0,hit={}})
            fx:FireAllClients("Projectile",{id=id,owner=p.UserId,position=origin,direction=direction,kind=kind,speed=cfgShot.Speed,range=cfgShot.Range})
        end)
    elseif kind=="Domain" then
        delayed(p,s,m,C.Domain.Windup,function()
            local flat=Vector3.new(direction.X,0,direction.Z)
            if flat.Magnitude<.05 then flat=Vector3.new(0,0,-1) end
            local center=r.Position+flat.Unit*14
            local d={owner=p,model=m,center=center,expires=clock()+C.Domain.Duration,nextTick=clock(),captured={}}
            for _,t in targets(m) do
                if (t.r.Position-center).Magnitude<C.Domain.Radius then
                    table.insert(d.captured,t)
                    t.m:SetAttribute("DomainLockedUntil",math.max(t.m:GetAttribute("DomainLockedUntil") or 0,d.expires))
                end
            end
            table.insert(domains,d)
            fx:FireAllClients("Domain",{owner=p.UserId,position=center,radius=C.Domain.Radius,duration=C.Domain.Duration})
        end)
    elseif kind=="Dash" then
        local flat=Vector3.new(direction.X,0,direction.Z)
        if flat.Magnitude<.05 then flat=r.CFrame.LookVector*Vector3.new(1,0,1) end
        flat=flat.Unit
        local result=workspace:Blockcast(r.CFrame,Vector3.new(3,4,3),flat*C.Dash.Distance,rayParams(m))
        local distance=result and math.max(0,result.Distance-.5) or C.Dash.Distance
        r.CFrame+=flat*distance
    elseif kind=="Thunderclap" then
        local cfg=C.Thunderclap
        local flat=Vector3.new(direction.X,0,direction.Z)
        if flat.Magnitude<.05 then flat=r.CFrame.LookVector*Vector3.new(1,0,1) end
        flat=flat.Unit
        -- Crouched stance: rooted in place during the long windup.
        if windup>.1 then setTimed(m,h,"RootedUntil",windup) end
        delayed(p,s,m,windup,function()
            local start,finish,victims=dashStrike(m,r,flat,cfg.Distance,cfg.Width)
            for _,t in victims do damage(p,t,cfg.Damage) end
            fx:FireAllClients("Thunderclap",{owner=p.UserId,from=start,to=finish})
        end)
    elseif kind=="Breath" then
        delayed(p,s,m,C.Breath.Windup,function()
            s.charges=C.Breath.Charges;s.chargesUntil=clock()+C.Breath.ChargeWindow;sendState(p,s)
            fx:FireAllClients("Strike",{position=r.Position-Vector3.new(0,3,0),big=true})
        end)
    elseif kind=="FlameGod" then
        local cfg=C.FlameGod
        local flat=Vector3.new(direction.X,0,direction.Z)
        if flat.Magnitude<.05 then flat=r.CFrame.LookVector*Vector3.new(1,0,1) end
        flat=flat.Unit
        setTimed(m,h,"RootedUntil",windup)
        delayed(p,s,m,windup,function()
            local start,finish,victims=dashStrike(m,r,flat,cfg.Distance,cfg.Width)
            fx:FireAllClients("FlameGod",{owner=p.UserId,from=start,to=finish})
            -- Too fast to see: the cuts land only after the user is already past.
            task.delay(cfg.HitDelay,function()
                for _,t in victims do damage(p,t,cfg.Damage) end
            end)
            -- Recoil: the legs give out. Self-damage never kills.
            if h.Health>1 then h.Health=math.max(1,h.Health-cfg.SelfDamage) end
            setTimed(m,h,"SlowedUntil",cfg.SlowDuration)
            fx:FireClient(p,"Recoil",{damage=cfg.SelfDamage,duration=cfg.SlowDuration})
        end)
    elseif kind=="BombDevil" then
        local cfg=C.BombDevil
        -- Rooted from the pin pull until her own sight returns.
        setTimed(m,h,"RootedUntil",windup+cfg.Blackout)
        delayed(p,s,m,windup,function()
            local center=r.Position
            -- No time limit: the transformation lasts until Detonation (or death) ends it.
            m:SetAttribute("BombDevilUntil",1e12)
            local healed=math.max(0,math.min(h.MaxHealth,h.Health+h.MaxHealth*cfg.Heal)-h.Health)
            if healed>0 then h.Health+=healed end
            fx:FireAllClients("BombDevil",{owner=p.UserId,position=center+Vector3.new(0,1.5,0),blackout=cfg.Blackout,healed=math.floor(healed+.5)})
            for _,t in targets(m) do
                local distance=(t.r.Position-center).Magnitude
                if distance<=cfg.Radius then
                    damage(p,t,cfg.Damage)
                    local power=1-.5*distance/cfg.Radius
                    launch(t,outward(center,t,r.CFrame.LookVector)*cfg.Knockback*power+Vector3.new(0,cfg.Lift*power,0))
                end
            end
        end)
    elseif kind=="Detonation" then
        local cfg=C.Detonation
        -- The fuse hair burns down for Windup seconds (free to move, other skills locked), then everything goes off.
        delayed(p,s,m,windup,function()
            local center=r.Position
            fx:FireAllClients("Detonation",{owner=p.UserId,position=center,radius=cfg.Radius})
            for _,t in targets(m) do
                local distance=(t.r.Position-center).Magnitude
                if distance<=cfg.Radius then
                    damage(p,t,cfg.Damage)
                    local power=1-.55*distance/cfg.Radius
                    launch(t,outward(center,t,r.CFrame.LookVector)*cfg.Knockback*power+Vector3.new(0,cfg.Lift*power,0))
                end
            end
            -- Back to human; the transformation can be used again after the recharge.
            m:SetAttribute("BombDevilUntil",0)
            s.cooldowns.BombDevil=clock()+C.BombDevil.Recharge
            sendState(p,s)
        end)
    elseif kind=="Rampage" then
        local cfg=C.Rampage
        local flat=Vector3.new(direction.X,0,direction.Z)
        if flat.Magnitude<.05 then flat=r.CFrame.LookVector*Vector3.new(1,0,1) end
        flat=flat.Unit
        delayed(p,s,m,windup,function()
            local start,finish,victims=dashStrike(m,r,flat,cfg.Distance,cfg.Width)
            for _,t in victims do
                damage(p,t,cfg.Damage);launch(t,flat*14+Vector3.new(0,cfg.Launch,0))
            end
            -- Missed everything: she skids on a little further instead of stopping dead.
            local slide=#victims==0
            if slide then r.AssemblyLinearVelocity=flat*cfg.SlideSpeed end
            fx:FireAllClients("Rampage",{owner=p.UserId,from=start,to=finish,delay=cfg.TrailDelay,slide=slide})
            s.comboDir=flat;s.comboUntil=clock()+C.Kick.ComboWindow;sendState(p,s)
            -- The gunpowder left on the path goes off on its own, even if Reze has moved on or died.
            local length=(finish-start).Magnitude
            task.delay(cfg.TrailDelay,function()
                for _,t in targets(m) do
                    local along=math.clamp((t.r.Position-start):Dot(flat),0,length)
                    if (start+flat*along-t.r.Position).Magnitude<=cfg.TrailRadius then
                        damage(p,t,cfg.TrailDamage);launch(t,Vector3.new(0,cfg.TrailLift,0))
                    end
                end
            end)
        end)
    elseif kind=="Anchor" then
        local cfg=C.Anchor
        -- The wire is shot along the crosshair. Level geometry is found with a raycast (floors never hold); enemies are
        -- found by how close the ray passes to them, because training rigs are not collidable. The nearer of the two wins.
        local origin=r.Position+Vector3.new(0,1.5,0)
        local params=rayParams(m);params.RespectCanCollide=true
        local world=workspace:Raycast(origin,direction*cfg.Range,params)
        local limit=world and world.Distance or cfg.Range
        local point,distance,victim
        if world and world.Normal.Y<.85 then point=world.Position;distance=world.Distance end
        for _,t in targets(m) do
            local to=t.r.Position+Vector3.new(0,.5,0)-origin
            local along=to:Dot(direction)
            if along>0 and along<=limit and (distance==nil or along<distance) and (to-direction*along).Magnitude<=3 then
                point=t.r.Position;distance=along;victim=t
            end
        end
        s.reel=nil;s.anchor=nil;s.comboUntil=0
        delayed(p,s,m,cfg.Windup,function()
            if point then
                s.anchor={point=point,victim=victim,untilTime=clock()+cfg.Duration}
            else
                -- Nothing to hold: the gas is gone and the next attempt has to wait.
                s.cooldowns.Anchor=clock()+cfg.MissCooldown
            end
            fx:FireAllClients("Anchor",{owner=p.UserId,from=origin,point=point or origin+direction*cfg.Range,hit=point~=nil,speed=cfg.WireSpeed})
            sendState(p,s)
        end)
    elseif kind=="Reel" then
        local cfg=C.Reel
        local a=s.anchor
        local distance=(a.point-r.Position).Magnitude
        local travel=math.max(.3,(distance-cfg.StopDistance)/(cfg.Speed*.82))
        local untilTime=n+math.min(cfg.MaxTime,travel+.4)
        s.reel={point=a.point,victim=a.victim,untilTime=untilTime}
        -- The Spin window: from the first pull until Grace seconds after the flight ends.
        s.comboUntil=untilTime+C.Spin.Grace
        fx:FireAllClients("Reel",{owner=p.UserId,point=a.point,speed=cfg.Speed,ramp=cfg.Ramp,stop=cfg.StopDistance,maxTime=cfg.MaxTime})
    elseif kind=="Spin" then
        local cfg=C.Spin
        -- The wire is let go; the client keeps the flight's momentum through the whole turn.
        s.reel=nil;s.anchor=nil;s.comboUntil=0
        s.busyUntil=n+windup+cfg.Rotation+cfg.Recovery
        delayed(p,s,m,windup,function()
            fx:FireAllClients("Spin",{owner=p.UserId,position=r.Position,radius=cfg.Radius,rotation=cfg.Rotation})
        end)
        delayed(p,s,m,windup+cfg.Rotation*.9,function()
            local center=r.Position
            local struck=0
            for _,t in targets(m) do
                if (t.r.Position-center).Magnitude<=cfg.Radius then
                    struck+=1
                    damage(p,t,cfg.Damage);launch(t,outward(center,t,r.CFrame.LookVector)*cfg.Knockback+Vector3.new(0,cfg.Lift,0))
                end
            end
            fx:FireAllClients("SpinHit",{owner=p.UserId,position=center,radius=cfg.Radius,struck=struck})
            -- Landing stagger: all that spinning leaves the user rooted for a moment.
            setTimed(m,h,"RootedUntil",cfg.Recovery)
        end)
    elseif kind=="Burst" then
        local cfg=C.Burst
        s.reel=nil;s.anchor=nil;s.comboUntil=0
        fx:FireAllClients("Burst",{owner=p.UserId,position=r.Position,direction=direction})
        fx:FireClient(p,"Impulse",{velocity=direction*cfg.Impulse+Vector3.new(0,cfg.Impulse*cfg.Lift,0)})
    elseif kind=="Kick" then
        local cfg=C.Kick
        -- Combo: Rampage ended moments ago, so the kick keeps flying along its direction.
        local combo=(s.comboUntil or 0)>n and s.comboDir~=nil
        local flat=Vector3.new(direction.X,0,direction.Z)
        if flat.Magnitude<.05 then flat=r.CFrame.LookVector*Vector3.new(1,0,1) end
        flat=combo and s.comboDir or flat.Unit
        s.comboUntil=0
        delayed(p,s,m,windup,function()
            local struck={}
            local from=r.Position
            local center,radius,damageAmount,knock,lift
            if combo then
                local _,finish,victims=dashStrike(m,r,flat,cfg.ComboDistance,cfg.Width)
                for _,t in victims do struck[t.m]=t end
                center=finish+flat*2.5;radius=cfg.ComboRadius;damageAmount=cfg.ComboDamage;knock=cfg.ComboKnockback;lift=cfg.ComboLift
            else
                center=from+flat*cfg.Reach;radius=cfg.Radius;damageAmount=cfg.Damage;knock=cfg.Knockback;lift=cfg.Lift
            end
            for _,t in targets(m) do
                if (t.r.Position-center).Magnitude<=radius then struck[t.m]=t end
            end
            fx:FireAllClients("Kick",{owner=p.UserId,from=from,to=center,combo=combo,radius=radius})
            for _,t in struck do
                damage(p,t,damageAmount);launch(t,flat*knock+Vector3.new(0,lift,0))
            end
        end)
    end
end
remote.OnServerEvent:Connect(function(p,skill,aim)
    local s=states[p];if not s then return end
    local n=clock()
    if n-s.lastRequest<.1 then return end;s.lastRequest=n
    if type(skill)~="string" or not kits[kitOf(p)][skill] or not validVector(aim) then return end
    local m,h,r=character(p);if not m then return end
    if (m:GetAttribute("DomainLockedUntil") or 0)>n then return end
    -- During a hold: the other of Blue/Red fuses both into Purple (paying its own cost), the same one fires at once.
    local hold=s.hold
    if hold and (skill=="Blue" or skill=="Red") then
        if s.busyUntil>n then return end
        if skill~=hold.kind then
            if (s.cooldowns[skill] or 0)>n or s.energy<C[skill].Cost then return end
            s.energy-=C[skill].Cost;s.cooldowns[skill]=n+C[skill].Cooldown
        end
        s.hold=nil
        perform(p,s,m,h,r,skill==hold.kind and skill or "Purple",aim.Unit,false)
        sendState(p,s);return
    end
    if hold and skill~="Dash" then return end
    if s.busyUntil>n then return end
    if (skill=="Rampage" or skill=="Kick" or skill=="Detonation") and not devil(m) then return end
    if skill=="BombDevil" and devil(m) then return end
    if skill=="Dash" and (m:GetAttribute("SlowedUntil") or 0)>n then return end
    -- Levi: Reel needs a held anchor, and Spin only works while flying on one (the window Reel opens).
    if skill=="Reel" and not (s.anchor and s.anchor.untilTime>n) then return end
    if skill=="Spin" and (s.comboUntil or 0)<=n then return end
    local cfg=C[skill]
    local instant=skill=="Thunderclap" and s.charges>0 and s.chargesUntil>n
    if instant then
        s.charges-=1
    else
        if (s.cooldowns[skill] or 0)>n or s.energy<cfg.Cost then return end
        s.energy-=cfg.Cost;s.cooldowns[skill]=n+cfg.Cooldown
    end
    -- Reze pays in health, never lethally.
    if cfg.HpCost and h.Health>1 then h.Health=math.max(1,h.Health-h.MaxHealth*cfg.HpCost) end
    -- Gojo: Blue and Red are held with an arm raised for up to Hold.Duration seconds instead of firing at once.
    if skill=="Blue" or skill=="Red" then
        local hold={kind=skill,untilTime=n+C.Hold.Duration}
        s.hold=hold
        fx:FireAllClients("Hold",{owner=p.UserId,kind=skill,position=r.Position,duration=C.Hold.Duration})
        local generation=s.generation
        task.delay(C.Hold.Duration,function()
            if s.hold~=hold or generation~=s.generation then return end
            s.hold=nil
            local cm,ch,cr=character(p)
            if cm==m and (m:GetAttribute("DomainLockedUntil") or 0)<=clock() then
                -- No fresh aim on a timeout: fire where the character faces (it turns with the first-person camera).
                perform(p,s,cm,ch,cr,skill,cr.CFrame.LookVector,false)
            end
            sendState(p,s)
        end)
        sendState(p,s);return
    end
    perform(p,s,m,h,r,skill,aim.Unit,instant)
    sendState(p,s)
end)
selectRemote.OnServerEvent:Connect(function(p,name)
    local s=states[p]
    if not s or type(name)~="string" or not kits[name] or kitOf(p)==name or s.busyUntil>clock() then return end
    s.generation+=1;s.cooldowns={};s.charges=0;s.chargesUntil=0;s.hold=nil;s.anchor=nil;s.reel=nil;s.comboUntil=0;cancelBlue(p,s)
    if p.Character then p.Character:SetAttribute("BombDevilUntil",0) end
    p:SetAttribute("Character",name);sendState(p,s)
end)
local sync=0
RunService.Heartbeat:Connect(function(dt)
    local n=clock();sync+=dt
    for p,s in states do
        local regen=C.EnergyRegen
        if kitOf(p)=="Levi" then
            -- Gas refills much faster on solid ground than in the air.
            local _,ch,cr=character(p)
            if ch and ch.FloorMaterial~=Enum.Material.Air then regen*=C.GasGroundRegen end
            local reel=s.reel
            if reel and cr then
                local distance=(reel.point-cr.Position).Magnitude
                if distance<=C.Reel.StopDistance+2 or n>=reel.untilTime then
                    s.reel=nil;s.anchor=nil;s.comboUntil=n+C.Spin.Grace
                    local arrived=distance<=C.Reel.StopDistance+3
                    local victim=reel.victim
                    if arrived and victim and victim.m.Parent and victim.h.Health>0 and (victim.r.Position-cr.Position).Magnitude<=C.Reel.ArrivalRadius then
                        damage(p,victim,C.Reel.ArrivalDamage);launch(victim,outward(cr.Position,victim,cr.CFrame.LookVector)*30+Vector3.new(0,28,0))
                    end
                    fx:FireAllClients("ReelEnd",{owner=p.UserId,arrived=arrived,position=cr.Position})
                    sendState(p,s)
                end
            elseif reel then s.reel=nil end
            if s.anchor and not s.reel and n>s.anchor.untilTime then
                s.anchor=nil;fx:FireAllClients("ReelEnd",{owner=p.UserId,arrived=false})
                sendState(p,s)
            end
        end
        s.energy=math.min(C.MaxEnergy,s.energy+regen*dt)
        if sync>=.15 then sendState(p,s) end
    end
    if sync>=.15 then sync=0 end
    for p,b in blues do
        if n>b.untilTime or not b.model.Parent then
            if states[p] then cancelBlue(p,states[p]) else blues[p]=nil end
        else
            for _,t in targets(b.model) do
                local delta=b.position-t.r.Position;local distance=delta.Magnitude
                if distance<C.Blue.Radius and distance>2 then
                    local step=delta.Unit*math.min(C.Blue.PullSpeed*dt,distance-2)
                    local obstacle=workspace:Raycast(t.r.Position,step,rayParams(t.m))
                    if not obstacle then t.r.CFrame+=step end
                end
            end
        end
    end
    for i=#projectiles,1,-1 do
        local shot=projectiles[i];local cfg=C[shot.kind];local step=shot.direction*cfg.Speed*dt
        local hitWorld=workspace:Spherecast(shot.position,cfg.Radius,step,rayParams(shot.model))
        local segmentLength=step.Magnitude
        if hitWorld then
            local hitModel=hitWorld.Instance:FindFirstAncestorOfClass("Model")
            if not (hitModel and hitModel:FindFirstChildOfClass("Humanoid")) then segmentLength=hitWorld.Distance end
        end
        local travel=shot.direction*segmentLength
        for _,t in targets(shot.model) do
            local projection=math.clamp((t.r.Position-shot.position):Dot(shot.direction),0,segmentLength)
            local closest=shot.position+shot.direction*projection
            if not shot.hit[t.m] and (t.r.Position-closest).Magnitude<=cfg.Radius+2 then
                shot.hit[t.m]=true;damage(shot.owner,t,cfg.Damage)
                if shot.kind=="Red" and not t.r.Anchored then t.r.AssemblyLinearVelocity+=shot.direction*34 end
            end
        end
        shot.position+=travel;shot.distance+=segmentLength
        if shot.distance>=cfg.Range or segmentLength<step.Magnitude-.001 then
            fx:FireAllClients("ProjectileEnd",{id=shot.id,position=shot.position,kind=shot.kind});table.remove(projectiles,i)
        end
    end
    -- Knocked-back training targets: ballistic arc until they land back on their starting height; walls stop drift.
    for model,f in flights do
        local root=f.t.r
        if not model.Parent or not root.Parent then
            flights[model]=nil
        else
            f.velocity-=Vector3.new(0,workspace.Gravity*dt,0)
            local step=f.velocity*dt
            local wall=workspace:Raycast(root.Position,Vector3.new(step.X,0,step.Z),rayParams(model))
            if wall then step=Vector3.new(0,step.Y,0);f.velocity=Vector3.new(0,f.velocity.Y,0) end
            local position=root.Position+step
            if position.Y<=f.ground and f.velocity.Y<0 then position=Vector3.new(position.X,f.ground,position.Z);flights[model]=nil end
            root.CFrame=CFrame.new(position)*root.CFrame.Rotation
        end
    end
    for i=#domains,1,-1 do
        local d=domains[i]
        if n>=d.expires or not d.model.Parent then
            for _,t in d.captured do
                if t.m.Parent and (t.m:GetAttribute("DomainLockedUntil") or 0)<=d.expires then t.m:SetAttribute("DomainLockedUntil",0) end
            end
            table.remove(domains,i)
        else
            for _,t in d.captured do
                if t.m.Parent and t.h.Health>0 then
                    local delta=t.r.Position-d.center
                    if delta.Magnitude>C.Domain.Radius-2 then t.r.CFrame=CFrame.new(d.center+delta.Unit*(C.Domain.Radius-2))*t.r.CFrame.Rotation end
                    if n>=d.nextTick then damage(d.owner,t,C.Domain.Damage) end
                end
            end
            if n>=d.nextTick then d.nextTick=n+C.Domain.Tick end
        end
    end
end)
local function joined(p)
    local s={energy=100,cooldowns={},blueUntil=0,busyUntil=0,lastRequest=0,generation=0,charges=0,chargesUntil=0};states[p]=s
    local function reset()
        s.generation+=1;s.energy=100;s.cooldowns={};s.busyUntil=0;s.charges=0;s.chargesUntil=0;s.hold=nil;s.anchor=nil;s.reel=nil;s.comboUntil=0;cancelBlue(p,s)
        local m=p.Character;local h=m and m:WaitForChild("Humanoid")
        if h then h.Died:Connect(function() s.generation+=1;s.hold=nil;s.anchor=nil;s.reel=nil;s.comboUntil=0;cancelBlue(p,s) end) end
    end
    p.CharacterAdded:Connect(reset);if p.Character then task.spawn(reset) end
end
Players.PlayerAdded:Connect(joined);for _,p in Players:GetPlayers() do joined(p) end
Players.PlayerRemoving:Connect(function(p) if states[p] then cancelBlue(p,states[p]) end;states[p]=nil end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="6">
      <Properties>
        <string name="Name">StoreVFX</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Optional Creator Store decoration. The game also runs when permissions prevent loading.
-- Only ParticleEmitter data is copied; imported scripts are never parented to the DataModel.
local InsertService=game:GetService("InsertService")
local RS=game:GetService("ReplicatedStorage")
local templates=Instance.new("Folder");templates.Name="StoreVFX";templates.Parent=RS
local ASSET_ID=17879749515 -- Red and Blue VFX Gojo !, @XxMurder_ProgamexX
task.spawn(function()
    local ok,model=pcall(function() return InsertService:LoadAsset(ASSET_ID) end)
    if not ok then
        templates:SetAttribute("Status","Permission unavailable; procedural fallback")
        warn("Creator Store VFX not loaded. Open this place with the account that acquired asset "..ASSET_ID)
        return
    end
    -- model remains unparented throughout inspection.
    for _,v in model:GetDescendants() do if v:IsA("LuaSourceContainer") then v:Destroy() end end
    local count=0
    for _,v in model:GetDescendants() do
        if v:IsA("ParticleEmitter") and count<8 then
            count+=1
            local copy=v:Clone()
            for _,child in copy:GetChildren() do child:Destroy() end
            copy.Name="StoreParticle"..count
            copy.Enabled=false;copy.Rate=math.min(copy.Rate,30)
            copy.Lifetime=NumberRange.new(math.min(copy.Lifetime.Min,1),math.min(copy.Lifetime.Max,1.6))
            copy.Speed=NumberRange.new(math.min(copy.Speed.Min,10),math.min(copy.Speed.Max,16))
            copy.Parent=templates
        end
    end
    model:Destroy()
    templates:SetAttribute("Status",count>0 and "Loaded" or "No particle emitters; procedural fallback")
    templates:SetAttribute("SourceAssetId",ASSET_ID)
end)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="7">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="CameraMode">1</token>
      <float name="CharacterJumpPower">45</float>
      <float name="CharacterWalkSpeed">20</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="8">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="9">
        <Properties>
          <string name="Name">Gojo</string>
          <string name="Source"><![CDATA[local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local UIS=game:GetService("UserInputService")
local Tween=game:GetService("TweenService")
local Debris=game:GetService("Debris")
local Lighting=game:GetService("Lighting")
local player=Players.LocalPlayer
local C=require(RS:WaitForChild("GojoConfig"))
local action=RS:WaitForChild("GojoAction")
local event=RS:WaitForChild("GojoFX")
local selectRemote=RS:WaitForChild("SelectCharacter")
local camera=workspace.CurrentCamera
local effects=Instance.new("Folder");effects.Name="LocalGojoFX";effects.Parent=workspace
local viewmodel=Instance.new("Model");viewmodel.Name="GojoViewmodel";viewmodel.Parent=camera
local blur=Instance.new("BlurEffect");blur.Size=0;blur.Parent=Lighting
local state={energy=100,cooldowns={},blueUntil=0,charges=0,chargesUntil=0}
local cast=nil
local holdState=nil
local slideUntil=0
local drawnUntil,fovKickUntil=0,0
local blueOrbs,shots,activeEffects={},{},{}
local reelState=nil
local wires={}
local clearWires
local function smoothstep(x) x=math.clamp(x,0,1);return x*x*(3-2*x) end
local clock=workspace.GetServerTimeNow
local function time() return clock(workspace) end
local KITS={
    Gojo={title="五条 悟  ·  고죠 사토루",energy="CURSED ENERGY",hint="Q / E 3초 대기 · 그 안에 다른 쪽 = 무라사키 · 같은 키 = 즉시 발사   /   SHIFT 대시   /   1 · 2 · 3 캐릭터",
        sleeve=Color3.fromRGB(17,21,35),handScale=1,
        slots={{"Blue","Q","아오"},{"Red","E","아카"},{"Domain","R","영역전개"},{"Dash","SHIFT","대시"}}},
    Zenitsu={title="我妻 善逸  ·  아가츠마 젠이츠",energy="BREATH",hint="Q → E  전집중 후 벽력일섬 즉시 ×3   /   SHIFT 대시   /   1 · 2 · 3 캐릭터",
        sleeve=Color3.fromRGB(240,184,40),handScale=.62,
        slots={{"Breath","Q","전집중 호흡"},{"Thunderclap","E","벽력일섬"},{"FlameGod","R","화뢰신"},{"Dash","SHIFT","대시"}}},
    Reze={title="レゼ  ·  레제",energy="GUNPOWDER",hint="R 변신(무제한) → Q 폭주대시 → 바로 E = 연계 폭발 킥 · R 다시 = 4초 뒤 대폭발   /   SHIFT 대시   /   1 · 2 · 3 캐릭터",
        sleeve=Color3.fromRGB(225,208,197),devilSleeve=Color3.fromRGB(40,36,38),handScale=1,
        slots={{"Rampage","Q","폭주대시"},{"Kick","E","폭발 킥"},{"BombDevil","R","폭탄의 악마"},{"Dash","SHIFT","대시"}}},
    Levi={title="リヴァイ  ·  리바이 아커만",energy="ODM GAS",hint="Q 앵커(십자선 조준) → E 당기기 → 날아가는 중 R 회전 베기   /   SHIFT 가스 분사 (와이어 끊고 가속)   /   1 · 2 · 3 · 4 캐릭터",
        sleeve=Color3.fromRGB(226,222,208),handScale=1,
        slots={{"Anchor","Q","앵커"},{"Reel","E","당기기"},{"Spin","R","회전 베기"},{"Burst","SHIFT","가스 분사"}}},
}
local LEVI_KINDS={Anchor=true,Reel=true,Spin=true,Burst=true}
local BOMB_KINDS={BombDevil=true,Rampage=true,Kick=true,Detonation=true}
local function current() local name=player:GetAttribute("Character");return KITS[name] and name or "Gojo" end
local function colorOf(kind) return C.Colors[kind] or (LEVI_KINDS[kind] and C.Colors.Gas) or (BOMB_KINDS[kind] and C.Colors.Bomb) or ((kind=="Thunderclap" or kind=="Breath" or kind=="FlameGod") and C.Colors.Thunder) or C.Colors.Purple end
local function part(parent,name,size,color,cf,shape)
    local p=Instance.new("Part");p.Name=name;p.Size=size;p.Color=color;p.CFrame=cf or CFrame.identity
    p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
    p.Material=Enum.Material.Neon;p.Shape=shape or Enum.PartType.Block;p.Parent=parent
    return p
end
local function tween(obj,duration,properties)
    Tween:Create(obj,TweenInfo.new(duration,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),properties):Play()
end
local function sound(id,position,volume,speed,duration)
    local holder=part(effects,"SoundPoint",Vector3.one*.1,Color3.new(1,1,1),CFrame.new(position))
    holder.Transparency=1
    local s=Instance.new("Sound");s.SoundId=type(id)=="string" and id or "rbxassetid://"..id;s.Volume=volume;s.PlaybackSpeed=speed or 1
    s.RollOffMaxDistance=90;s.RollOffMinDistance=8;s.Parent=holder;s:Play()
    Debris:AddItem(holder,duration or 3)
end
local function temporary(seconds,update,cleanup)
    table.insert(activeEffects,{start=time(),duration=seconds,update=update,cleanup=cleanup})
end
local function particles(p,color)
    local templates=RS:FindFirstChild("StoreVFX")
    if not templates then return end
    local count=0
    for _,source in templates:GetChildren() do
        if source:IsA("ParticleEmitter") and count<3 then
            count+=1;local e=source:Clone();e.Color=ColorSequence.new(color);e.Enabled=true;e.Parent=p
        end
    end
end
local function orb(position,color,radius)
    local m=Instance.new("Model");m.Name="EnergyOrb"
    local core=part(m,"Core",Vector3.one*radius*1.4,Color3.new(1,1,1),CFrame.new(position),Enum.PartType.Ball)
    m.PrimaryPart=core
    for i=1,3 do
        local shell=part(m,"Aura",Vector3.one*radius*(1.7+i*.45),color,CFrame.new(position),Enum.PartType.Ball)
        shell.Transparency=.55+i*.1
    end
    local light=Instance.new("PointLight");light.Color=color;light.Brightness=3;light.Range=radius*10;light.Parent=core
    particles(core,color)
    m.Parent=effects
    return m
end
local function burst(position,color,radius)
    local p=part(effects,"Shockwave",Vector3.one*.2,color,CFrame.new(position),Enum.PartType.Ball)
    p.Transparency=.35;tween(p,.45,{Size=Vector3.one*radius*2,Transparency=1});Debris:AddItem(p,.5)
    for i=1,18 do
        local direction=Vector3.new(math.random()-.5,math.random()-.5,math.random()-.5).Unit
        local q=part(effects,"Spark",Vector3.new(.09,.09,math.random()*1.1+.2),color,CFrame.lookAt(position,position+direction))
        tween(q,.4,{Position=position+direction*radius*1.6,Transparency=1});Debris:AddItem(q,.45)
    end
end
-- Jagged neon lightning between two points; each segment fades on its own.
local function bolt(from,to,color,width,life)
    local dir=to-from;local length=dir.Magnitude
    if length<.1 then return end
    local right=dir:Cross(Vector3.yAxis);if right.Magnitude<.01 then right=Vector3.xAxis end;right=right.Unit
    local up=dir:Cross(right).Unit
    local count=math.max(4,math.floor(length/4));local previous=from
    for i=1,count do
        local jitter=math.min(3,length*.07)
        local point=i==count and to or from+dir*(i/count)+right*(math.random()-.5)*jitter*2+up*(math.random()-.5)*jitter*2
        local segment=part(effects,"Bolt",Vector3.new(width,width,(point-previous).Magnitude),color,CFrame.lookAt((previous+point)/2,point))
        tween(segment,life,{Transparency=1});Debris:AddItem(segment,life+.05)
        previous=point
    end
end
local function skyStrike(position,big)
    local width=big and .9 or .45
    bolt(position+Vector3.new((math.random()-.5)*8,60,(math.random()-.5)*8),position,Color3.fromRGB(255,244,196),width,big and .6 or .35)
    if big then
        for _=1,2 do bolt(position+Vector3.new((math.random()-.5)*16,60,(math.random()-.5)*16),position,C.Colors.Thunder,.45,.5) end
        burst(position,C.Colors.Thunder,9)
    else
        burst(position,C.Colors.Thunder,3)
    end
end

-- Reze's explosions: the engine Explosion for the flash and debris (no pressure, no joint breaking; damage is
-- server-side), plus a neon fireball and a few smoke puffs.
local function blast(position,radius)
    local e=Instance.new("Explosion");e.Position=position;e.BlastRadius=radius;e.BlastPressure=0
    e.DestroyJointRadiusPercent=0;e.ExplosionType=Enum.ExplosionType.NoCraters;e.Parent=effects
    local core=part(effects,"Fireball",Vector3.one*radius*.5,Color3.fromRGB(255,226,160),CFrame.new(position),Enum.PartType.Ball)
    tween(core,.35,{Size=Vector3.one*radius*1.5,Transparency=1,Color=C.Colors.Bomb});Debris:AddItem(core,.4)
    for _=1,4 do
        local puff=part(effects,"Smoke",Vector3.one*radius*.5,Color3.fromRGB(52,46,46),CFrame.new(position+Vector3.new(math.random()-.5,math.random()*.5,math.random()-.5)*radius*.6),Enum.PartType.Ball)
        puff.Material=Enum.Material.SmoothPlastic;puff.Transparency=.35
        tween(puff,1.4,{Size=Vector3.one*radius*1.1,Transparency=1,Position=puff.Position+Vector3.new(0,radius*.6,0)});Debris:AddItem(puff,1.5)
    end
    burst(position,C.Colors.Bomb,radius)
end
-- Seventh form: a lightning dragon that forms along the dash path and keeps flying past the end point,
-- so the user (already at the end) sees it surge ahead. Head leads, body follows in segments.
local function dragon(from,to)
    local flat=Vector3.new(to.X-from.X,0,to.Z-from.Z)
    if flat.Magnitude<.1 then flat=Vector3.new(0,0,-1) end
    flat=flat.Unit
    local side=flat:Cross(Vector3.yAxis)
    local length=(to-from).Magnitude+34
    local count=30
    local points={}
    for i=0,count do
        local s=i/count
        points[i]=from+flat*length*s+side*(math.sin(s*math.pi*3)*4+3)+Vector3.new(0,-1.5+math.sin(s*math.pi*2)*1.5+math.max(0,s-.6)*28,0)
    end
    local grow=.3
    for i=1,count do
        local a,b=points[i-1],points[i];local thick=.5+2*(i/count)
        local body=part(effects,"DragonBody",Vector3.new(thick,thick,(b-a).Magnitude+.4),C.Colors.Thunder,CFrame.lookAt((a+b)/2,b))
        body.Transparency=1
        local core=part(effects,"DragonCore",Vector3.new(thick*.35,thick*.35,(b-a).Magnitude+.4),Color3.fromRGB(255,248,220),CFrame.lookAt((a+b)/2,b))
        core.Transparency=1
        task.delay(grow*i/count,function()
            body.Transparency=.2;core.Transparency=0
            tween(body,1.2,{Transparency=1});tween(core,1,{Transparency=1})
            if i%3==0 then bolt(b,b+Vector3.new((math.random()-.5)*8,(math.random()-.3)*6,(math.random()-.5)*8),C.Colors.Thunder,.18,.3) end
        end)
        Debris:AddItem(body,grow+1.4);Debris:AddItem(core,grow+1.4)
    end
    -- Head: skull, snout, open jaw, horns and eyes, aligned with the last body segment.
    local tip=points[count];local head=CFrame.lookAt(tip,tip+(points[count]-points[count-1]).Unit)
    local shape={
        {Vector3.new(3,2.4,3.6),CFrame.identity},
        {Vector3.new(2,1.4,3),CFrame.new(0,.1,-3)},
        {Vector3.new(1.8,.5,3),CFrame.new(0,-1,-2.6)*CFrame.Angles(-.45,0,0)},
        {Vector3.new(.35,.35,3.6),CFrame.new(-.9,1.4,1.6)*CFrame.Angles(.55,-.2,0)},
        {Vector3.new(.35,.35,3.6),CFrame.new(.9,1.4,1.6)*CFrame.Angles(.55,.2,0)},
    }
    task.delay(grow,function()
        for _,piece in shape do
            local p=part(effects,"DragonHead",piece[1],C.Colors.Thunder,head*piece[2]);p.Transparency=.1
            tween(p,1.2,{Transparency=1});Debris:AddItem(p,1.3)
        end
        for _,x in {-.8,.8} do
            local eye=part(effects,"DragonEye",Vector3.one*.45,Color3.new(1,1,1),head*CFrame.new(x,.7,-1.7),Enum.PartType.Ball)
            tween(eye,1.2,{Transparency=1});Debris:AddItem(eye,1.3)
        end
        burst(tip,C.Colors.Thunder,10)
    end)
end

-- Viewmodel pieces are posed every frame relative to the camera; sizes scale per character.
local function piece(list,name,size,offset,color,material,shape)
    local p=part(viewmodel,name,size,color,nil,shape);p.Material=material or Enum.Material.SmoothPlastic
    local entry={p=p,offset=offset,size=size};table.insert(list,entry);return entry
end
local function hand(side)
    local h={pieces={},side=side,scale=1}
    local skin=Color3.fromRGB(225,208,197)
    h.sleeve=piece(h.pieces,"Sleeve",Vector3.new(.29,.75,.32),CFrame.new(0,-.42,.12)*CFrame.Angles(-.15,0,0),Color3.fromRGB(17,21,35)).p
    piece(h.pieces,"Palm",Vector3.new(.29,.32,.12),CFrame.identity,skin)
    -- Bomb Devil: a fuse cord hangs from each wrist with a lit tip.
    piece(h.pieces,"Fuse",Vector3.new(.05,.4,.05),CFrame.new(side*.13,-.22,.16)*CFrame.Angles(.5,0,side*.5),Color3.fromRGB(84,62,44)).devilOnly=true
    piece(h.pieces,"Ember",Vector3.one*.08,CFrame.new(side*.22,-.38,.27),C.Colors.Bomb,Enum.Material.Neon,Enum.PartType.Ball).devilOnly=true
    -- Levi's blades: held in the fist and pointing forward and a little up, so they stay in view.
    local bladeFrame=CFrame.new(0,.05,-.05)*CFrame.Angles(.5,0,0)
    local steel=Color3.fromRGB(214,222,230)
    piece(h.pieces,"BladeGrip",Vector3.new(.05,.055,.26),bladeFrame*CFrame.new(0,0,.02),Color3.fromRGB(34,36,40)).leviOnly=true
    piece(h.pieces,"BladeGuard",Vector3.new(.13,.03,.04),bladeFrame*CFrame.new(0,0,-.13),Color3.fromRGB(120,128,138),Enum.Material.Metal).leviOnly=true
    piece(h.pieces,"Blade",Vector3.new(.012,.11,.55),bladeFrame*CFrame.new(0,0,-.4),steel,Enum.Material.Metal).leviOnly=true
    piece(h.pieces,"BladeEdge",Vector3.new(.016,.012,.53),bladeFrame*CFrame.new(0,-.05,-.4),C.Colors.Gas,Enum.Material.Neon).leviOnly=true
    return h
end
local left,right=hand(-1),hand(1)
-- Reze's choker, shown only during the pull. It is fixed to the body (camera position and yaw, not pitch), so
-- lowering the chin brings the band's front and its pin ring into the bottom of the view. The ring sits on her right.
local chokerParts={}
for i=0,11 do
    local a0,a1=math.rad(-100+i*200/12),math.rad(-100+(i+1)*200/12)
    local p0=Vector3.new(math.sin(a0)*.13,-.3,-.1-math.cos(a0)*.21);local p1=Vector3.new(math.sin(a1)*.13,-.3,-.1-math.cos(a1)*.21)
    local seg=part(viewmodel,"Choker",Vector3.new(.022,.024,(p1-p0).Magnitude+.006),Color3.fromRGB(13,13,16),nil);seg.Material=Enum.Material.SmoothPlastic
    table.insert(chokerParts,{p=seg,offset=CFrame.lookAt((p0+p1)/2,p1)})
end
local RING_AT=CFrame.new(math.sin(.3)*.13,-.272,-.1-math.cos(.3)*.21-.012)*CFrame.Angles(0,math.pi/2,0)
local pinPart=part(viewmodel,"Pin",Vector3.new(.012,.06,.06),Color3.fromRGB(205,210,218),nil,Enum.PartType.Cylinder);pinPart.Material=Enum.Material.Metal
local holdOrb=part(viewmodel,"HoldOrb",Vector3.one*.16,C.Colors.Blue,nil,Enum.PartType.Ball)
local boot=part(viewmodel,"Boot",Vector3.new(.2,.16,.5),Color3.fromRGB(28,26,30),nil);boot.Material=Enum.Material.SmoothPlastic;boot.Transparency=1
local socket=part(viewmodel,"Socket",Vector3.one*.03,C.Colors.Bomb,nil,Enum.PartType.Ball)
-- Where the ring sits relative to the hooking hand, and the elbow-out hooking pose.
local PIN_IN_HAND=CFrame.new(-.03,.17,-.07)*CFrame.Angles(0,math.pi/2,0)
local HOOK=CFrame.Angles(-.15,-.2,1.25)
local function scaleHand(h,s)
    if h.scale~=s then h.scale=s;for _,entry in h.pieces do entry.p.Size=entry.size*s end end
end
local function pose(h,cf)
    for _,entry in h.pieces do
        entry.p.CFrame=camera.CFrame*cf*CFrame.new(entry.offset.Position*h.scale)*entry.offset.Rotation
    end
end
-- Zenitsu's sheathed katana. In the sword frame -Z runs from the tsuba toward the pommel, +Z into the saya.
local katana={saya={},hilt={}}
local gold=Color3.fromRGB(201,162,74)
piece(katana.saya,"Saya",Vector3.new(.07,.085,1.45),CFrame.new(0,0,.76),Color3.fromRGB(43,34,51))
piece(katana.saya,"Koiguchi",Vector3.new(.08,.095,.08),CFrame.new(0,0,.06),gold,Enum.Material.Metal)
piece(katana.saya,"Kojiri",Vector3.new(.08,.095,.06),CFrame.new(0,0,1.46),gold,Enum.Material.Metal)
piece(katana.hilt,"Tsuba",Vector3.new(.026,.21,.21),CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(42,37,34),Enum.Material.Metal,Enum.PartType.Cylinder)
piece(katana.hilt,"Tsuka",Vector3.new(.055,.065,.4),CFrame.new(0,0,-.22),Color3.fromRGB(241,234,216))
piece(katana.hilt,"Kashira",Vector3.new(.065,.075,.035),CFrame.new(0,0,-.43),gold,Enum.Material.Metal)
piece(katana.hilt,"Blade",Vector3.new(.014,.075,1.48),CFrame.new(0,-.005,.77),Color3.fromRGB(227,233,240),Enum.Material.Metal).drawnOnly=true
piece(katana.hilt,"Edge",Vector3.new(.018,.02,1.44),CFrame.new(0,-.035,.77),C.Colors.Thunder,Enum.Material.Neon).drawnOnly=true
local function place(list,frame) for _,entry in list do entry.p.CFrame=camera.CFrame*frame*entry.offset end end
local GRIP,SAYA=CFrame.new(0,-.01,-.24),CFrame.new(0,-.01,.32)
local RIGHT_UP,LEFT_UP=Vector3.new(-.4,.6,-.5).Unit,Vector3.new(.5,.65,-.4).Unit
-- Camera-space frame at `position` whose +Y (palm toward fingers) points along `up`.
local function armFrame(position,up)
    local side=up:Cross(Vector3.zAxis);if side.Magnitude<.01 then side=Vector3.xAxis end
    return CFrame.fromMatrix(position,side.Unit,up)
end

-- Levi's wires: two cables from the hips to the anchor, each with a small steel head. The head flies out at WireSpeed;
-- on a miss the cables retract. Parts are created on the first frame they are needed and removed with the wire.
function clearWires(owner)
    local w=wires[owner]
    if w and w.parts then for _,p in w.parts do p:Destroy() end end
    wires[owner]=nil
end
local function wireParts(w)
    if w.parts then return w.parts end
    local steel=Color3.fromRGB(215,225,230)
    w.parts={part(effects,"Wire",Vector3.new(.03,.03,1),steel,nil),part(effects,"Wire",Vector3.new(.03,.03,1),steel,nil),part(effects,"AnchorHead",Vector3.one*.35,Color3.fromRGB(240,246,250),nil,Enum.PartType.Ball)}
    return w.parts
end

local gui=Instance.new("ScreenGui");gui.Name="InfinityHUD";gui.ResetOnSpawn=false;gui.IgnoreGuiInset=true;gui.Parent=player:WaitForChild("PlayerGui")
local function label(parent,text,size,pos,dim,color)
    local t=Instance.new("TextLabel");t.BackgroundTransparency=1;t.Text=text;t.Font=Enum.Font.GothamMedium;t.TextSize=size
    t.TextColor3=color or Color3.fromRGB(230,237,249);t.Position=pos;t.Size=dim;t.Parent=parent;return t
end
label(gui,"∞  INFINITY  /  SKILL LAB",19,UDim2.fromOffset(30,28),UDim2.fromOffset(380,32)).TextXAlignment=Enum.TextXAlignment.Left
local nameLabel=label(gui,"",13,UDim2.fromOffset(30,60),UDim2.fromOffset(380,28),Color3.fromRGB(144,169,195));nameLabel.TextXAlignment=Enum.TextXAlignment.Left
local cross=label(gui,"+",22,UDim2.fromScale(.5,.5),UDim2.fromOffset(22,22));cross.AnchorPoint=Vector2.new(.5,.5)
local title=label(gui,"",30,UDim2.fromScale(.5,.3),UDim2.fromOffset(560,45));title.AnchorPoint=Vector2.new(.5,.5)
local subtitle=label(gui,"",13,UDim2.fromScale(.5,.3)+UDim2.fromOffset(0,38),UDim2.fromOffset(560,28));subtitle.AnchorPoint=Vector2.new(.5,.5)
local health=label(gui,"",14,UDim2.new(0,30,1,-105),UDim2.fromOffset(250,30));health.TextXAlignment=Enum.TextXAlignment.Left
local energy=label(gui,"",13,UDim2.new(0,30,1,-73),UDim2.fromOffset(250,26),C.Colors.Blue);energy.TextXAlignment=Enum.TextXAlignment.Left
local panel=Instance.new("Frame");panel.Size=UDim2.fromOffset(480,70);panel.Position=UDim2.new(.5,0,1,-105);panel.AnchorPoint=Vector2.new(.5,0);panel.BackgroundTransparency=1;panel.Parent=gui
local scale=Instance.new("UIScale");scale.Parent=panel
local buttons={}
for i=1,4 do
    local b=Instance.new("TextButton");b.Position=UDim2.fromOffset((i-1)*122,0);b.Size=UDim2.fromOffset(114,70)
    b.BackgroundColor3=Color3.fromRGB(14,21,34);b.BackgroundTransparency=.12;b.TextColor3=Color3.fromRGB(236,243,255)
    b.Font=Enum.Font.GothamMedium;b.TextSize=14;b.Parent=panel
    local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(0,10);corner.Parent=b
    local stroke=Instance.new("UIStroke");stroke.Thickness=1;stroke.Parent=b
    local entry={b=b,stroke=stroke};buttons[i]=entry
    b.Activated:Connect(function() if entry.skill then action:FireServer(entry.skill,camera.CFrame.LookVector) end end)
end
local comboLabel=label(gui,"",26,UDim2.fromScale(.5,.62),UDim2.fromOffset(420,40),Color3.fromRGB(255,224,176));comboLabel.AnchorPoint=Vector2.new(.5,.5)
comboLabel.Font=Enum.Font.GothamBold;comboLabel.TextStrokeTransparency=.35;comboLabel.TextStrokeColor3=Color3.fromRGB(255,122,46)
local hint=label(gui,"",12,UDim2.new(.5,0,1,-26),UDim2.fromOffset(620,22),Color3.fromRGB(144,163,187));hint.AnchorPoint=Vector2.new(.5,0)
local blackout=Instance.new("Frame");blackout.Size=UDim2.fromScale(1,1);blackout.BackgroundColor3=Color3.new(0,0,0)
blackout.BackgroundTransparency=1;blackout.BorderSizePixel=0;blackout.ZIndex=10;blackout.Parent=gui
local picker=Instance.new("Frame");picker.Size=UDim2.fromOffset(430,34);picker.Position=UDim2.new(1,-30,0,28);picker.AnchorPoint=Vector2.new(1,0);picker.BackgroundTransparency=1;picker.Parent=gui
local pickButtons={}
local PICK_NAMES={Gojo="고죠",Zenitsu="젠이츠",Reze="레제",Levi="리바이"}
for i,name in {"Gojo","Zenitsu","Reze","Levi"} do
    local b=Instance.new("TextButton");b.Size=UDim2.fromOffset(100,34);b.Position=UDim2.fromOffset((i-1)*110,0)
    b.Font=Enum.Font.GothamMedium;b.TextSize=13;b.Text=i.."  "..PICK_NAMES[name];b.Parent=picker
    local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(0,6);corner.Parent=b
    b.Activated:Connect(function() selectRemote:FireServer(name) end)
    pickButtons[name]=b
end
local function announce(name,sub)
    title.Text=name;subtitle.Text=sub;title.TextTransparency=0;subtitle.TextTransparency=0
    task.delay(2,function() tween(title,.6,{TextTransparency=1});tween(subtitle,.6,{TextTransparency=1}) end)
end
local function applyKit()
    local name=current();local kit=KITS[name]
    nameLabel.Text=kit.title;hint.Text=kit.hint
    energy.TextColor3=name=="Zenitsu" and C.Colors.Thunder or name=="Reze" and C.Colors.Bomb or name=="Levi" and C.Colors.Gas or C.Colors.Blue
    for i,slot in kit.slots do
        local entry=buttons[i];entry.skill=slot[1];entry.key=slot[2];entry.name=slot[3]
        entry.stroke.Color=colorOf(slot[1]);if slot[1]=="Dash" then entry.stroke.Color=Color3.fromRGB(85,103,139) end
    end
    for pickName,b in pickButtons do
        local on=pickName==name
        b.BackgroundColor3=on and Color3.fromRGB(219,234,240) or Color3.fromRGB(14,21,34);b.TextColor3=on and Color3.fromRGB(16,34,54) or Color3.fromRGB(200,214,228)
    end
    for _,h in {left,right} do
        h.sleeve.Color=kit.sleeve;h.scale=kit.handScale
        for _,entry in h.pieces do entry.p.Size=entry.size*kit.handScale end
    end
    if cast then for _,o in cast.orbs do o:Destroy() end end
    cast=nil;holdState=nil;drawnUntil=0;blackout.BackgroundTransparency=1
    reelState=nil;for owner in wires do clearWires(owner) end
end
applyKit()
player:GetAttributeChangedSignal("Character"):Connect(applyKit)
UIS.InputBegan:Connect(function(input,processed)
    if processed then return end
    local pick=({[Enum.KeyCode.One]="Gojo",[Enum.KeyCode.Two]="Zenitsu",[Enum.KeyCode.Three]="Reze",[Enum.KeyCode.Four]="Levi"})[input.KeyCode]
    if pick then selectRemote:FireServer(pick);return end
    local slot=({[Enum.KeyCode.Q]=1,[Enum.KeyCode.E]=2,[Enum.KeyCode.R]=3,[Enum.KeyCode.LeftShift]=4})[input.KeyCode]
    if slot then action:FireServer(buttons[slot].skill,camera.CFrame.LookVector) end
end)
action.OnClientEvent:Connect(function(s) state=s end)

event.OnClientEvent:Connect(function(kind,data)
    if kind=="Cast" then
        if data.kind=="Blue" then task.delay(.42,function() sound(9114427347,data.position,.75,1,2) end) end
        if data.kind=="Purple" or data.kind=="Domain" then sound(9112775414,data.position,.35,.8,3) end
        if data.kind=="Detonation" then
            -- Danger zone: a ring at the blast radius that pulses faster as the fuse runs out.
            local ring=part(effects,"DetonationWarning",Vector3.new(.15,C.Detonation.Radius*2,C.Detonation.Radius*2),C.Colors.Bomb,CFrame.new(data.position-Vector3.new(0,2.85,0))*CFrame.Angles(0,0,math.pi/2),Enum.PartType.Cylinder)
            ring.Transparency=.8
            local length=data.windup
            temporary(length,function(age) ring.Transparency=.55+.35*math.sin(age*(4+age*age*3)) end,function() ring:Destroy() end)
        end
        if data.kind=="Breath" then
            -- Lightning falls around the breathing swordsman, visible to everyone.
            local look=Vector3.new(data.direction.X,0,data.direction.Z);look=look.Magnitude>.05 and look.Unit or Vector3.new(0,0,-1)
            local side=look:Cross(Vector3.yAxis)
            for _,at in {.35,.85,1.35} do
                task.delay(at,function()
                    skyStrike(data.position-Vector3.new(0,3,0)+look*(8+math.random()*10)+side*(math.random()-.5)*16,false)
                end)
            end
        end
        if data.owner==player.UserId then
            holdState=nil
            local length=data.windup or C[data.kind].Windup or .2
            cast={kind=data.kind,start=time(),length=length,orbs={},hold=data.kind=="Kick" and .2 or data.kind=="Spin" and (C.Spin.Rotation+C.Spin.Recovery) or .15}
            if data.kind=="Purple" then
                cast.orbs={orb(camera.CFrame.Position,C.Colors.Blue,.28),orb(camera.CFrame.Position,C.Colors.Red,.28)}
                announce("虚式 • 茈","아오 + 아카  /  무라사키")
            elseif data.kind=="Domain" then announce("領域展開","무량공처 · UNLIMITED VOID")
            elseif data.kind=="Blue" then announce("術式順転 • 蒼","아오 · 인력")
            elseif data.kind=="Red" then announce("術式反転 • 赫","아카 · 척력")
            elseif data.kind=="Thunderclap" then announce("雷の呼吸 • 壱ノ型",length>.1 and "벽력일섬 · 자세를 낮춘다" or "벽력일섬 · 즉시 발동")
            elseif data.kind=="Breath" then announce("全集中の呼吸","전집중 호흡 · 이후 벽력일섬 즉시 ×"..C.Breath.Charges)
            elseif data.kind=="FlameGod" then announce("雷の呼吸 • 漆ノ型","화뢰신 · 火雷神 · 벽력일섬을 초월한 발도")
            elseif data.kind=="BombDevil" then announce("レゼ","쵸커의 핀을 당긴다")
            elseif data.kind=="Kick" then announce("爆裂蹴","폭발 킥")
            elseif data.kind=="Detonation" then announce("大爆発","4초 뒤 광역 대폭발 · 체력 12% 소모")
            elseif data.kind=="Spin" then announce("回転斬り","회전 베기 · 날아가며 한 바퀴"..(C.Spin.ThirdPerson and "" or " (1인칭)")) end
            -- The wire is let go the moment the user spins or bursts away; the flight's momentum carries on.
            if data.kind=="Spin" or data.kind=="Burst" then reelState=nil end
            if data.kind=="Spin" then
                local m=player.Character;local root=m and m:FindFirstChild("HumanoidRootPart")
                if root then root.AssemblyLinearVelocity*=C.Spin.Coast end
            end
        else
            burst(data.position,colorOf(data.kind),3)
        end
    elseif kind=="Thunderclap" then
        local below=Vector3.new(0,-2.4,0)
        bolt(data.from+below,data.to+below,C.Colors.Thunder,.5,.6)
        bolt(data.from+below*.4,data.to+below*1.1,Color3.fromRGB(255,244,196),.22,.45)
        burst(data.from,C.Colors.Thunder,5);burst(data.to,C.Colors.Thunder,4)
        if data.owner==player.UserId then drawnUntil=time()+.4;fovKickUntil=time()+.25;blur.Size=18 end
    elseif kind=="Strike" then
        skyStrike(data.position,data.big)
    elseif kind=="FlameGod" then
        dragon(data.from,data.to)
        bolt(data.from-Vector3.new(0,2.4,0),data.to-Vector3.new(0,2.4,0),Color3.fromRGB(255,248,220),.6,.5)
        burst(data.from,C.Colors.Thunder,8)
        if data.owner==player.UserId then drawnUntil=time()+.7;fovKickUntil=time()+.18;blur.Size=24 end
    elseif kind=="BombDevil" then
        -- The head goes off: a huge blast for everyone; for Reze herself the world cuts to black and slowly returns.
        blast(data.position,14)
        burst(data.position-Vector3.new(0,4,0),C.Colors.Bomb,22)
        if data.owner==player.UserId then
            blackout.BackgroundTransparency=0;blur.Size=36
            task.delay(.3,function()
                Tween:Create(blackout,TweenInfo.new(data.blackout-.3,Enum.EasingStyle.Sine,Enum.EasingDirection.In),{BackgroundTransparency=1}):Play()
            end)
            task.delay(data.blackout*.6,function()
                announce("爆弾の悪魔","폭탄의 악마 · 지속 무제한"..(data.healed>0 and " · HP +"..data.healed or "").."  /  R 다시 = 대폭발")
            end)
        end
    elseif kind=="Rampage" then
        -- Blast under the feet, then a line of gunpowder along the path that chain-detonates after the delay.
        local below=Vector3.new(0,-2.8,0)
        blast(data.from+below*.7,6)
        local dir=data.to-data.from;local length=dir.Magnitude
        local grains={}
        if length>.5 then
            local unit=dir.Unit;local side=unit:Cross(Vector3.yAxis)
            for i=0,math.floor(length/2) do
                local at=data.from+below+unit*i*2+side*(math.random()-.5)*1.2
                local grain=part(effects,"Gunpowder",Vector3.new(1.1,.08,1.1)*(.6+math.random()*.6),Color3.fromRGB(32,28,26),CFrame.new(at)*CFrame.Angles(0,math.random()*6,0))
                grain.Material=Enum.Material.Sand
                local ember=part(effects,"Ember",Vector3.one*.16,C.Colors.Bomb,CFrame.new(at+Vector3.new(0,.12,0)),Enum.PartType.Ball)
                Debris:AddItem(grain,data.delay+3);Debris:AddItem(ember,data.delay+3)
                table.insert(grains,{grain,ember,at})
            end
        end
        task.delay(data.delay,function()
            for i,g in grains do
                task.delay(i*.03,function()
                    g[1]:Destroy();g[2]:Destroy()
                    if i%2==1 then blast(g[3]+Vector3.new(0,1.2,0),5) end
                end)
            end
        end)
        if data.owner==player.UserId then
            fovKickUntil=time()+.2;blur.Size=14
            if data.slide then slideUntil=time()+.55 end
            announce("連携","E 폭발 킥으로 연계! · "..C.Kick.ComboWindow.."초")
        end
    elseif kind=="Kick" then
        -- Explosive kick: a flaming streak along the combo dash, then the blast.
        if data.combo then
            bolt(data.from-Vector3.new(0,2.2,0),data.to-Vector3.new(0,2.2,0),C.Colors.Bomb,.45,.45)
            bolt(data.from-Vector3.new(0,1.2,0),data.to-Vector3.new(0,1.2,0),Color3.fromRGB(255,236,190),.18,.35)
        end
        blast(data.to,data.radius)
        -- Crescent slash sweeping right to left at hip height, drawn one segment at a time.
        do
            local forward=Vector3.new(data.to.X-data.from.X,0,data.to.Z-data.from.Z)
            forward=forward.Magnitude>.1 and forward.Unit or Vector3.new(0,0,-1)
            local radius=data.combo and 5.5 or 4.2
            local center=data.from+Vector3.new(0,-.8,0)
            local count=12;local points={}
            for i=0,count do
                local angle=math.rad(75-150*i/count)
                points[i]=center+CFrame.fromAxisAngle(Vector3.yAxis,angle):VectorToWorldSpace(forward)*radius
            end
            for i=1,count do
                task.delay(i*.012,function()
                    local a,b=points[i-1],points[i]
                    local seg=part(effects,"KickArc",Vector3.new(data.combo and .45 or .3,.16,(b-a).Magnitude+.3),C.Colors.Bomb,CFrame.lookAt((a+b)/2,b))
                    tween(seg,.3,{Transparency=1,Size=Vector3.new(.05,.05,seg.Size.Z)});Debris:AddItem(seg,.35)
                end)
            end
        end
        if data.owner==player.UserId then
            fovKickUntil=time()+(data.combo and .3 or .15);blur.Size=data.combo and 20 or 10
            if data.combo then announce("連携","폭주 연계 · 폭발 킥") end
        end
    elseif kind=="Detonation" then
        -- Everything goes off: staggered blasts across the whole radius; Reze's sight flashes white and she is human again.
        blast(data.position,data.radius*.5)
        for k=1,10 do
            task.delay(k*.04,function()
                local angle=math.random()*math.pi*2;local distance=math.random()*data.radius*.85
                blast(data.position+Vector3.new(math.cos(angle)*distance,.5,math.sin(angle)*distance),data.radius*.22)
            end)
        end
        local ring=part(effects,"BlastRing",Vector3.new(.4,.4,.4),C.Colors.Bomb,CFrame.new(data.position-Vector3.new(0,2.8,0))*CFrame.Angles(0,0,math.pi/2),Enum.PartType.Cylinder)
        tween(ring,.7,{Size=Vector3.new(.4,data.radius*2.2,data.radius*2.2),Transparency=1});Debris:AddItem(ring,.8)
        if data.owner==player.UserId then
            blackout.BackgroundColor3=Color3.new(1,1,1);blackout.BackgroundTransparency=0;blur.Size=40
            task.delay(.15,function()
                Tween:Create(blackout,TweenInfo.new(1.1,Enum.EasingStyle.Sine),{BackgroundTransparency=1}):Play()
                task.delay(1.2,function() blackout.BackgroundColor3=Color3.new(0,0,0) end)
            end)
            announce("人間に戻る","인간으로 돌아온다 · 폭탄의 악마 재사용 20초")
        end
    elseif kind=="Anchor" then
        clearWires(data.owner)
        local travel=math.max(.05,(data.point-data.from).Magnitude/data.speed)
        wires[data.owner]={from=data.from,point=data.point,hit=data.hit,fired=time(),travel=travel}
        if data.hit then
            -- The heads bite the surface: a ting and a spray of sparks.
            task.delay(travel,function()
                if wires[data.owner] then
                    sound("rbxasset://sounds/electronicpingshort.wav",data.point,.5,2.2,1);burst(data.point,C.Colors.Gas,2.5)
                end
            end)
        end
    elseif kind=="Reel" then
        if data.owner==player.UserId then
            reelState={point=data.point,speed=data.speed,ramp=data.ramp,stop=data.stop,max=data.maxTime,start=time()}
            sound("rbxasset://sounds/swordlunge.wav",data.point,.6,1.6,1.5)
        end
    elseif kind=="ReelEnd" then
        clearWires(data.owner)
        if data.owner==player.UserId then reelState=nil end
        if data.arrived then burst(data.position,C.Colors.Gas,3) end
    elseif kind=="Spin" then
        -- Two blades sweep a full circle around the user, drawn one segment at a time; each follows the user's own
        -- position so the arcs trail behind in a spiral while the momentum carries on.
        local owner=Players:GetPlayerByUserId(data.owner)
        local count=16;local reach=8
        sound("rbxasset://sounds/swordslash.wav",data.position,.9,.8,2)
        for blade=0,1 do
            for i=0,count do
                task.delay(i*data.rotation/count,function()
                    local root=owner and owner.Character and owner.Character:FindFirstChild("HumanoidRootPart")
                    local center=(root and root.Position or data.position)+Vector3.new(0,.6,0)
                    local angle=blade*math.pi+i/count*math.pi*2
                    local a=center+Vector3.new(math.cos(angle),0,math.sin(angle))*reach
                    local b=center+Vector3.new(math.cos(angle+.5),0,math.sin(angle+.5))*reach
                    local seg=part(effects,"SpinArc",Vector3.new(.34,.12,(b-a).Magnitude+.4),C.Colors.Gas,CFrame.lookAt((a+b)/2,b))
                    tween(seg,.35,{Transparency=1,Size=Vector3.new(.04,.04,seg.Size.Z)});Debris:AddItem(seg,.4)
                end)
            end
        end
    elseif kind=="SpinHit" then
        burst(data.position,C.Colors.Gas,data.radius*.45)
        if data.struck>0 then sound("rbxasset://sounds/swordslash.wav",data.position,1,1.4,1) end
        if data.owner==player.UserId then
            fovKickUntil=time()+.18;blur.Size=14
            if data.struck>0 then cross.Text="×";task.delay(.2,function() cross.Text="+" end) end
        end
    elseif kind=="Burst" then
        burst(data.position,C.Colors.Gas,5)
        sound("rbxasset://sounds/swordlunge.wav",data.position,.7,1.3,1.5)
    elseif kind=="Impulse" then
        local m=player.Character;local h=m and m:FindFirstChildOfClass("Humanoid");local root=m and m:FindFirstChild("HumanoidRootPart")
        if h and root then
            h:ChangeState(Enum.HumanoidStateType.Freefall);root.AssemblyLinearVelocity=data.velocity
            fovKickUntil=time()+.2;blur.Size=12
        end
    elseif kind=="Knockback" then
        local m=player.Character;local h=m and m:FindFirstChildOfClass("Humanoid");local root=m and m:FindFirstChild("HumanoidRootPart")
        if h and root then h:ChangeState(Enum.HumanoidStateType.FallingDown);root.AssemblyLinearVelocity=data.velocity end
    elseif kind=="Recoil" then
        announce("반동","다리가 버티지 못한다 · HP -"..data.damage.." · 이동 속도 저하 "..data.duration.."초")
    elseif kind=="Hold" then
        -- Blue or Red held with an arm raised; the server fires it (or Purple) when the hold ends.
        if data.owner==player.UserId then
            holdState={kind=data.kind,start=time(),duration=data.duration}
            local blue=data.kind=="Blue"
            announce(blue and "術式順転 • 蒼  ·  대기" or "術式反転 • 赫  ·  대기",(blue and "E 아카" or "Q 아오").." → 무라사키   /   "..(blue and "Q" or "E").." 다시 → 즉시 발사")
        else
            burst(data.position,colorOf(data.kind),2)
        end
    elseif kind=="Blue" then
        local model=orb(data.position,C.Colors.Blue,1.1)
        if blueOrbs[data.owner] then blueOrbs[data.owner]:Destroy() end
        blueOrbs[data.owner]=model
        burst(data.position,C.Colors.Blue,5)
        task.delay(data.duration,function() if blueOrbs[data.owner]==model then model:Destroy();blueOrbs[data.owner]=nil end end)
    elseif kind=="BlueEnd" then
        if blueOrbs[data.owner] then blueOrbs[data.owner]:Destroy();blueOrbs[data.owner]=nil end
    elseif kind=="Projectile" then
        local radius=data.kind=="Purple" and 3 or 1.2
        local model=orb(data.position,C.Colors[data.kind],radius)
        shots[data.id]={model=model,position=data.position,direction=data.direction,speed=data.speed,born=time(),life=data.range/data.speed,kind=data.kind}
        burst(data.position,C.Colors[data.kind],radius*2)
    elseif kind=="ProjectileEnd" then
        local shot=shots[data.id];if shot then shot.model:Destroy();shots[data.id]=nil end
        burst(data.position,C.Colors[data.kind],8)
    elseif kind=="Hit" then
        local anchor=part(effects,"DamagePoint",Vector3.one*.1,Color3.new(1,1,1),CFrame.new(data.position+Vector3.new(0,3,0)))
        anchor.Transparency=1
        local bill=Instance.new("BillboardGui");bill.Size=UDim2.fromOffset(110,50);bill.AlwaysOnTop=true;bill.Parent=anchor
        local txt=label(bill,tostring(data.damage),24,UDim2.fromScale(0,0),UDim2.fromScale(1,1))
        tween(anchor,.8,{Position=anchor.Position+Vector3.new(0,3,0)});tween(txt,.8,{TextTransparency=1});Debris:AddItem(anchor,.9)
        if data.owner==player.UserId then cross.Text="×";task.delay(.12,function() cross.Text="+" end) end
    elseif kind=="Domain" then
        local center=data.position;local r=data.radius
        local dome=part(effects,"UnlimitedVoid",Vector3.one*.1,Color3.fromRGB(9,13,33),CFrame.new(center),Enum.PartType.Ball)
        dome.Material=Enum.Material.ForceField;dome.Transparency=.25
        tween(dome,.7,{Size=Vector3.one*r*2})
        local stars={}
        for i=1,90 do
            local direction=Vector3.new(math.random()-.5,math.random()-.5,math.random()-.5).Unit
            local position=center+direction*(r-1)
            local p=part(effects,"VoidStar",Vector3.new(.08,math.random()*3+.4,.08),Color3.fromRGB(148,199,255),CFrame.new(position))
            table.insert(stars,p)
        end
        burst(center,Color3.fromRGB(187,219,255),r)
        temporary(data.duration,function(age)
            dome.CFrame=CFrame.new(center)*CFrame.Angles(0,age*.035,0)
            for i,p in stars do p.Transparency=.25+math.sin(age*2+i)*.23 end
        end,function()
            tween(dome,.6,{Transparency=1});Debris:AddItem(dome,.7)
            for _,p in stars do tween(p,.5,{Transparency=1});Debris:AddItem(p,.6) end
        end)
    end
end)

Run:BindToRenderStep("GojoView",Enum.RenderPriority.Camera.Value+1,function(dt)
    camera=workspace.CurrentCamera;viewmodel.Parent=camera
    local n=time();local bob=math.sin(n*2)*.014
    local zen=current()=="Zenitsu"
    local reze=current()=="Reze"
    local pinShown=cast and cast.kind=="BombDevil"
    local kickSwing,kickLift,kickUp,kickYaw,kickRoll=-1,0,0,0,0
    local pinGrabbed,pinHooked,chinTilt,handSize=false,false,0,KITS[current()].handScale
    local look=camera.CFrame.LookVector;local flat=Vector3.new(look.X,0,look.Z)
    local neckFrame=CFrame.lookAt(camera.CFrame.Position,camera.CFrame.Position+(flat.Magnitude>.01 and flat.Unit or Vector3.new(0,0,-1)))
    local l=CFrame.new(-.48,-.53+bob,-.88)*CFrame.Angles(.2,.15,-.3)
    local r=CFrame.new(.48,-.5-bob,-.88)*CFrame.Angles(.1,-.2,.3)
    local swordPos,swordDir=Vector3.new(-.05,-.5+bob,-1.12),Vector3.new(.8,.25,-.55).Unit
    local push,lean=0,0
    local desiredFov=72;blur.Size=math.max(0,blur.Size-dt*24)
    local m=player.Character;local h=m and m:FindFirstChildOfClass("Humanoid")
    local transformed=reze and m and (m:GetAttribute("BombDevilUntil") or 0)>n
    local levi=current()=="Levi"
    local spinPitch,spinYaw,spinRoll=0,0,0
    local thirdPerson=false
    if reze then for _,hd in {left,right} do hd.sleeve.Color=transformed and KITS.Reze.devilSleeve or KITS.Reze.sleeve end end
    if cast then
        local a=n-cast.start;local u=math.clamp(a/cast.length,0,1)
        if cast.kind=="Blue" then
            r=CFrame.new(.25,-.28,-.7)*CFrame.Angles(-.2,0,.25+math.sin(a*70)*.025)
        elseif cast.kind=="Red" then r=CFrame.new(.17,-.25,-.85)*CFrame.Angles(-.5,0,.2)
        elseif cast.kind=="Purple" then
            local angle=u*math.pi*2;local radius=.36*(1-math.clamp((u-.6)/.25,0,1))
            l=CFrame.new(-.12-math.cos(angle)*radius,-.17+math.sin(angle)*radius,-.8)*CFrame.Angles(0,0,-angle)
            r=CFrame.new(.12+math.cos(angle)*radius,-.17+math.sin(angle)*radius,-.8)*CFrame.Angles(0,0,angle)
            if cast.orbs[1] then cast.orbs[1]:PivotTo(camera.CFrame*l*CFrame.new(0,.3,0));cast.orbs[2]:PivotTo(camera.CFrame*r*CFrame.new(0,.3,0)) end
            desiredFov=66
        elseif cast.kind=="Domain" then
            l=CFrame.new(-.1,-.15+(1-u)*-.35,-.7)*CFrame.Angles(-.15,0,-.12)
            r=CFrame.new(.1,-.15+(1-u)*-.35,-.7)*CFrame.Angles(-.15,0,.12)
            blur.Size=math.sin(u*math.pi)*13;desiredFov=66
        elseif cast.kind=="Dash" then desiredFov=84
        elseif (cast.kind=="Thunderclap" or cast.kind=="FlameGod") and cast.length>.1 then
            -- Crouched draw stance with static crackling at the feet; the seventh form sinks lower and crackles harder.
            local god=cast.kind=="FlameGod"
            lean=math.clamp(a/(god and .3 or .5),0,1)*(god and 1.3 or 1);swordPos+=Vector3.new(0,-.06,.08)*lean;desiredFov=god and 62 or 68
            if m and math.random()<dt*(god and 40 or 14) then
                local root=m:FindFirstChild("HumanoidRootPart")
                if root then
                    local foot=root.Position+root.CFrame.LookVector*(2+math.random()*2)+Vector3.new((math.random()-.5)*3,-2.9,(math.random()-.5)*3)
                    bolt(foot,foot+Vector3.new((math.random()-.5)*1.2,1+math.random()*2,(math.random()-.5)*1.2),C.Colors.Thunder,.06,.12)
                end
            end
        elseif cast.kind=="BombDevil" then
            -- Beats over the windup: chin down while the right arm rises elbow-out to the choker (to .45), fingers hook
            -- the ring and hold (.45-.62), a hard yank out to the right with a metallic ting (.62-.72), the socket fizzes.
            local w=cast.length
            local function smooth(x) x=math.clamp(x,0,1);return x*x*(3-2*x) end
            local reach,pull=smooth((a-.04*w)/(w*.41)),smooth((a-w*.62)/(w*.1))
            pinHooked=a>=w*.45 and a<w*.62
            pinGrabbed=a>=w*.62
            if a<w then chinTilt=smooth(a/(w*.35)) end
            handSize=1-.38*reach
            local view=camera.CFrame*CFrame.Angles(-.5*chinTilt,0,0)
            local ringLocal=view:ToObjectSpace(neckFrame*RING_AT).Position
            local atRing=ringLocal-HOOK:VectorToWorldSpace(PIN_IN_HAND.Position*handSize)
            local jitter=pinHooked and math.sin(a*70)*.003 or 0
            local idle,out=Vector3.new(.42,-.5,-.88),Vector3.new(.56,-.2,-.62)
            local position=idle:Lerp(atRing,reach):Lerp(out,pull)+Vector3.new(jitter,jitter,0)
            local rotation=CFrame.Angles(.1,-.2,.3):Lerp(HOOK,reach):Lerp(CFrame.Angles(-.05,-.3,.7),pull)
            r=CFrame.new(position)*rotation.Rotation
            l=l*CFrame.new(0,-.35*chinTilt,0)
            if pull>0 and not cast.pinged then
                cast.pinged=true
                local root=m and m:FindFirstChild("HumanoidRootPart")
                if root then sound("rbxasset://sounds/electronicpingshort.wav",root.Position,.6,1.7,1) end
            end
            desiredFov=66-8*smooth((a-w*.42)/(w*.2))+6*pull
        elseif cast.kind=="Rampage" then
            -- Arms flung back by the blast under the feet.
            local k=math.clamp(a/math.max(cast.length,.05),0,1)
            l=CFrame.new(-.6,-.62-.2*k,-.62)*CFrame.Angles(.6*k,.2,-.4);r=CFrame.new(.6,-.62-.2*k,-.62)*CFrame.Angles(.6*k,-.2,.4)
            desiredFov=90
        elseif cast.kind=="Kick" then
            -- Roundhouse: the right foot is lifted and held for ~0.3s while the body coils right, then the leg whips
            -- across the view from right to left and the camera turns with it.
            local function smooth(x) x=math.clamp(x,0,1);return x*x*(3-2*x) end
            local lift=smooth(a/.3);local sw=smooth((a-.3)/.16);local up=math.sin(sw*math.pi)
            kickLift=lift*(1-sw);kickSwing=sw;kickUp=up
            kickYaw=(-.34*lift*(1-sw)+.46*sw)*(1-smooth((a-.55)/.3));kickRoll=-.1*up+.04*lift*(1-sw)
            lean=(.25*lift*(1-sw)+.55*up);desiredFov=78-6*lift*(1-sw)+8*up
            l=CFrame.new(-.6,-.62,-.62)*CFrame.Angles(.4,.2,-.4);r=CFrame.new(.6-.2*sw,-.62,-.62)*CFrame.Angles(.4,-.2,.4)
        elseif cast.kind=="Detonation" then
            -- Hands clenched before the face while the fuse burns; the view shudders harder every second.
            local shake=(a/cast.length)^2*.02
            l=CFrame.new(-.16,-.2,-.66)*CFrame.Angles(.1,.7,-.5);r=CFrame.new(.16,-.2,-.66)*CFrame.Angles(.1,-.7,.5)
            camera.CFrame*=CFrame.new((math.random()-.5)*shake*2,(math.random()-.5)*shake*2,0)
            desiredFov=66-8*(a/cast.length)
        elseif cast.kind=="Breath" then
            push=.05*math.clamp(a/.4,0,1);swordPos+=Vector3.new(0,math.sin(a*3.2)*.02,0);desiredFov=66
        elseif cast.kind=="Anchor" then
            -- Both fists snap forward to fire the wires from the hips, with a small recoil once they leave.
            local k=smoothstep(a/math.max(cast.length,.05))
            l=CFrame.new(-.5,-.62+.12*k,-.7)*CFrame.Angles(.5*k,.3,-.5);r=CFrame.new(.5,-.62+.12*k,-.7)*CFrame.Angles(.5*k,-.3,.5)
            spinPitch=.04*math.sin(math.clamp((a-cast.length)/.18,0,1)*math.pi);desiredFov=70
        elseif cast.kind=="Spin" then
            -- Coil (Windup): the body winds to the right, blades pulled back. Turn (Rotation): one full revolution to the
            -- left with the arms flung wide, the view banking into the turn. Recovery: planted and rooted (server).
            local w,rotation=C.Spin.Windup,C.Spin.Rotation
            local lf,sp=smoothstep(a/w),smoothstep((a-w)/rotation)
            local bank=math.sin(sp*math.pi)
            spinYaw=-.7*lf+(math.pi*2+.7)*sp;spinRoll=-.32*bank+.05*lf*(1-sp);spinPitch=-.16*bank
            desiredFov=66+20*bank-4*lf*(1-sp);blur.Size=math.max(blur.Size,bank*16);lean=.5*lf*(1-sp)
            l=(CFrame.new(-.35,-.45,-.75)*CFrame.Angles(.35,.5,-.7)):Lerp(CFrame.new(-.8,-.3,-.6)*CFrame.Angles(.1,.9,-1.2),sp)
            r=(CFrame.new(.65,-.4,-.55)*CFrame.Angles(.2,-.8,.9)):Lerp(CFrame.new(.8,-.3,-.6)*CFrame.Angles(.1,-.9,1.2),sp)
            if C.Spin.ThirdPerson then
                -- Optional: pull the camera out for the turn and spin the body instead of the view.
                thirdPerson=true
                local root=m and m:FindFirstChild("HumanoidRootPart")
                if root then
                    cast.baseRotation=cast.baseRotation or root.CFrame.Rotation
                    root.CFrame=CFrame.new(root.Position)*cast.baseRotation*CFrame.Angles(0,spinYaw,0)
                end
                camera.CFrame*=CFrame.new(0,1.2,11)
                spinPitch,spinYaw,spinRoll=0,0,0
            end
        end
        if a>=cast.length+cast.hold then for _,o in cast.orbs do o:Destroy() end;cast=nil end
    end
    if chinTilt>0 then camera.CFrame*=CFrame.Angles(-.5*chinTilt,0,0) end
    if levi then
        local anchored=(state.anchorUntil or 0)>n
        if reelState then
            -- Flying on the wire: fists taut ahead, the view tightens and streaks past.
            local age=n-reelState.start
            if not cast then
                l=CFrame.new(-.4,-.3,-.7)*CFrame.Angles(.55,.35,-.5);r=CFrame.new(.4,-.3,-.7)*CFrame.Angles(.55,-.35,.5)
            end
            desiredFov=math.max(desiredFov,86+8*smoothstep(age/.4));blur.Size=math.max(blur.Size,5)
            spinRoll+=math.sin(n*9)*.008
        elseif anchored and not cast then
            l=CFrame.new(-.45,-.42,-.78)*CFrame.Angles(.3,.3,-.4);r=CFrame.new(.45,-.42,-.78)*CFrame.Angles(.3,-.3,.4)
        end
        if spinYaw~=0 or spinRoll~=0 or spinPitch~=0 then camera.CFrame*=CFrame.Angles(spinPitch,spinYaw,spinRoll) end
        if h then h.AutoRotate=not thirdPerson end
    end
    if kickSwing>=0 then camera.CFrame*=CFrame.Angles(0,kickYaw,kickRoll) end
    -- Skid after a Rampage that hit nothing: drop low and recover.
    if n<slideUntil then lean=math.max(lean,.9*math.clamp((slideUntil-n)/.55,0,1)) end
    -- Hold: Blue raises the right arm, Red the left, with the technique gathering in the palm.
    local holdHand=nil
    if holdState then
        if n-holdState.start>holdState.duration+1 then holdState=nil
        else
            local k=math.clamp((n-holdState.start)/.25,0,1)
            if holdState.kind=="Blue" then r=CFrame.new(.3,-.42+.3*k,-.8)*CFrame.Angles(.35*k,0,.3-.22*k);holdHand=r
            else l=CFrame.new(-.3,-.42+.3*k,-.8)*CFrame.Angles(.35*k,0,-.3+.22*k);holdHand=l end
        end
    end
    if n<fovKickUntil then desiredFov=94 end
    if h then h.CameraOffset=h.CameraOffset:Lerp(Vector3.new(0,-1.3*lean,0),math.min(1,dt*10)) end
    camera.FieldOfView+=(desiredFov-camera.FieldOfView)*math.min(1,dt*8)
    local width=camera.ViewportSize.X;scale.Scale=math.min(1,(width-28)/480)
    local handScale=math.min(1,camera.ViewportSize.X/camera.ViewportSize.Y)
    local drawn=n<drawnUntil
    if zen then
        swordPos*=Vector3.new(handScale,1,1)
        local sword=CFrame.lookAt(swordPos,swordPos+swordDir)
        local hilt=sword*CFrame.new(0,0,-push)
        if drawn then
            local at=Vector3.new(.32*handScale,-.38,-.92);hilt=CFrame.lookAt(at,at-Vector3.new(-.75,.06,-.66))
        end
        place(katana.saya,sword);place(katana.hilt,hilt)
        pose(right,armFrame((hilt*GRIP).Position,RIGHT_UP))
        pose(left,armFrame((sword*SAYA).Position,LEFT_UP))
    else
        scaleHand(right,handSize)
        if holdHand then
            holdOrb.CFrame=camera.CFrame*CFrame.new(holdHand.Position*Vector3.new(handScale,1,1))*holdHand.Rotation*CFrame.new(0,.3,0)
            holdOrb.Color=C.Colors[holdState.kind];holdOrb.Size=Vector3.one*(.16+math.sin(n*14)*.015)
        end
        pose(left,CFrame.new(l.Position*Vector3.new(handScale,1,1))*l.Rotation)
        -- While pulling the pin the hand must meet the ring exactly, so the narrow-screen squeeze is skipped.
        pose(right,pinShown and r or CFrame.new(r.Position*Vector3.new(handScale,1,1))*r.Rotation)
        if pinShown then
            pinPart.CFrame=pinGrabbed and camera.CFrame*r*PIN_IN_HAND or neckFrame*RING_AT*CFrame.Angles(0,0,pinHooked and math.sin(n*50)*.15 or 0)
            socket.CFrame=neckFrame*CFrame.new(RING_AT.Position.X,-.3,RING_AT.Position.Z)
            socket.Size=Vector3.one*(.02+math.random()*.03)
        end
        for _,entry in chokerParts do entry.p.CFrame=neckFrame*entry.offset end
    end
    local pinVisible=pinShown and h and h.Health>0 and chinTilt>0
    pinPart.Transparency=pinVisible and 0 or 1
    socket.Transparency=(pinVisible and pinGrabbed) and math.random()*.4 or 1
    for _,entry in chokerParts do entry.p.Transparency=pinVisible and 0 or 1 end
    if kickSwing>=0 then
        local sw=kickSwing
        boot.CFrame=camera.CFrame*CFrame.new(1.05*(1-2*sw)*.8,-.9+.4*kickLift+.45*kickUp,-.5-.25*kickLift-.5*kickUp)*CFrame.Angles(-.3*kickLift-.5*kickUp,-1.3+2.6*sw,(.55-1.1*sw)*.6)
        boot.Transparency=(h and h.Health>0) and 0 or 1
    else boot.Transparency=1 end
    holdOrb.Transparency=(holdHand and not zen and h and h.Health>0) and .15 or 1
    for _,orbModel in blueOrbs do if orbModel.Parent then orbModel:PivotTo(orbModel:GetPivot()*CFrame.Angles(0,dt*.5,dt*.2)) end end
    for id,shot in shots do
        shot.position+=shot.direction*shot.speed*dt
        shot.model:PivotTo(CFrame.lookAt(shot.position,shot.position+shot.direction))
        if n-shot.born>shot.life then shot.model:Destroy();shots[id]=nil end
    end
    for i=#activeEffects,1,-1 do
        local e=activeEffects[i];local age=n-e.start
        if age>e.duration then e.cleanup();table.remove(activeEffects,i) else e.update(age) end
    end
    local charged=zen and (state.charges or 0)>0 and (state.chargesUntil or 0)>n
    local slowed=m and (m:GetAttribute("SlowedUntil") or 0)-n or 0
    for _,entry in buttons do
        local cooldown=(entry.skill=="Thunderclap" and charged) and 0 or math.max(0,(state.cooldowns[entry.skill] or 0)-n)
        if entry.skill=="Dash" and slowed>0 then cooldown=math.max(cooldown,slowed) end
        local text=entry.name
        local held=state.holdKind or ""
        if entry.key=="R" and reze then entry.skill=transformed and "Detonation" or "BombDevil";entry.name=transformed and "대폭발" or "폭탄의 악마";entry.stroke.Color=colorOf(entry.skill) end
        if held~="" and (entry.skill=="Blue" or entry.skill=="Red") then
            if entry.skill==held then text=entry.name.." 발사";cooldown=0 else text="무라사키" end
        end
        if entry.skill=="Thunderclap" and charged then text=string.format("벽력일섬 ×%d",state.charges) end
        if entry.skill=="Kick" then
            local ready=(state.comboUntil or 0)-n
            if transformed and ready>0 then
                text=string.format("연계 킥!  %.1f",ready);cooldown=0
                entry.stroke.Thickness=3;entry.stroke.Color=Color3.fromRGB(255,224,176)
                entry.b.BackgroundColor3=Color3.fromRGB(70,30,12)
            else
                entry.stroke.Thickness=1;entry.stroke.Color=colorOf("Kick");entry.b.BackgroundColor3=Color3.fromRGB(14,21,34)
            end
        end
        if levi then
            if entry.skill=="Spin" then
                local ready=(state.comboUntil or 0)-n
                if ready>0 and cooldown<=0 then
                    text=string.format("회전 베기!  %.1f",ready)
                    entry.stroke.Thickness=3;entry.stroke.Color=Color3.fromRGB(232,255,240);entry.b.BackgroundColor3=Color3.fromRGB(20,56,44)
                else
                    if ready<=0 then text=entry.name.." (비행 중)";cooldown=math.max(cooldown,.001) end
                    entry.stroke.Thickness=1;entry.stroke.Color=colorOf("Spin");entry.b.BackgroundColor3=Color3.fromRGB(14,21,34)
                end
            elseif entry.skill=="Reel" then
                if (state.anchorUntil or 0)<=n then text=entry.name.." (앵커 필요)";cooldown=math.max(cooldown,.001) else text=entry.name.."  ●" end
            end
        end
        if reze and not transformed and (entry.skill=="Rampage" or entry.skill=="Kick") then text=entry.name.." (변신 필요)";cooldown=math.max(cooldown,.001) end
        entry.b.Text=entry.key.."\n"..text..(cooldown>0 and string.format("  %.1f",cooldown) or "")
        entry.b.BackgroundTransparency=cooldown>0 and .5 or .12
    end
    do
        local ready=(state.comboUntil or 0)-n
        local spinReady=(state.comboUntil or 0)-n
        if current()=="Reze" and ready>0 and transformed then
            comboLabel.Text=string.format("E  연계 킥!   %.1f",ready)
            comboLabel.TextTransparency=.1+.25*math.abs(math.sin(n*9))
        elseif levi and spinReady>0 and (state.cooldowns.Spin or 0)<=n then
            comboLabel.Text=string.format("R  회전 베기!   %.1f",spinReady)
            comboLabel.TextTransparency=.1+.25*math.abs(math.sin(n*9))
        else comboLabel.Text="" end
    end
    health.Text=h and string.format("HP  %d / %d",h.Health,h.MaxHealth) or "RESPAWNING"
    local locked=m and (m:GetAttribute("DomainLockedUntil") or 0)>n
    energy.Text=locked and "영역 안 · 이동 가능 / 스킬 봉인"
        or slowed>0 and string.format("반동 · 이동 속도 저하 · 대시 불가  %.1f", slowed)
        or reze and transformed and "폭탄의 악마 · 지속 무제한 · 기본 스킬 HP 3% · R 대폭발"
        or reze and "변신 전 · R 폭탄의 악마 / SHIFT 대시만 사용 가능"
        or string.format("%s   %d%%",KITS[current()].energy,state.energy)
    local alive=h and h.Health>0
    for _,hd in {left,right} do
        for _,entry in hd.pieces do
            local shown=alive and (not entry.devilOnly or transformed) and (not entry.pinOnly or pinShown) and (not entry.leviOnly or (levi and not thirdPerson))
            entry.p.Transparency=shown and 0 or 1
        end
    end
    for owner,w in wires do
        local age=n-w.fired
        local extend=math.clamp(age/w.travel,0,1)
        if not w.hit then extend=extend*(1-math.clamp((age-w.travel)/.25,0,1)) end
        if not w.hit and age>w.travel+.3 then clearWires(owner)
        else
            local wp=wireParts(w)
            local point=w.point
            local origins
            if owner==player.UserId then
                origins={camera.CFrame*l*CFrame.new(0,.15,-.1),camera.CFrame*r*CFrame.new(0,.15,-.1)}
            else
                local other=Players:GetPlayerByUserId(owner)
                local root=other and other.Character and other.Character:FindFirstChild("HumanoidRootPart")
                origins=root and {root.CFrame*CFrame.new(-1.1,-.5,-.6),root.CFrame*CFrame.new(1.1,-.5,-.6)} or {CFrame.new(w.from),CFrame.new(w.from)}
            end
            local side=(point-origins[1].Position):Cross(Vector3.yAxis);side=side.Magnitude>.01 and side.Unit or Vector3.xAxis
            for i,sign in {-1,1} do
                local from=origins[i].Position
                local target=point+side*sign*.45
                local tip=from:Lerp(target,extend)
                local length=math.max(.05,(tip-from).Magnitude)
                if (tip-from).Magnitude>.05 then wp[i].Size=Vector3.new(.03,.03,length);wp[i].CFrame=CFrame.lookAt((from+tip)/2,tip) end
                wp[i].Transparency=(tip-from).Magnitude>.05 and 0 or 1
            end
            wp[3].Position=origins[1].Position:Lerp(point,extend)
            wp[3].Transparency=(extend>=1 and w.hit) and 0 or 1
        end
    end
    for _,entry in katana.saya do entry.p.Transparency=(alive and zen) and 0 or 1 end
    for _,entry in katana.hilt do entry.p.Transparency=(alive and zen and (drawn or not entry.drawnOnly)) and 0 or 1 end
end)
player.CharacterAdded:Connect(function()
    if cast then for _,o in cast.orbs do o:Destroy() end end
    cast=nil;blur.Size=0;drawnUntil=0;blackout.BackgroundTransparency=1
end)

-- Levi's flight. Players own their own physics, so the pull is applied here; the server decides when it starts, when
-- it ends (arrival, timeout, Spin, Burst) and who gets hurt. Streaks fly past the camera while it lasts.
Run.Heartbeat:Connect(function(dt)
    local m=player.Character;local h=m and m:FindFirstChildOfClass("Humanoid");local root=m and m:FindFirstChild("HumanoidRootPart")
    if not (h and root) then return end
    -- During the spin most of gravity is cancelled so the turn happens in the air.
    if cast and cast.kind=="Spin" then root.AssemblyLinearVelocity+=Vector3.new(0,workspace.Gravity*dt*.6,0) end
    if not reelState then return end
    local n=time()
    local to=reelState.point-root.Position
    local age=n-reelState.start
    if to.Magnitude<=reelState.stop or age>reelState.max then reelState=nil;return end
    local speed=reelState.speed*math.clamp(.25+.75*age/reelState.ramp,.25,1)
    h:ChangeState(Enum.HumanoidStateType.Freefall)
    root.AssemblyLinearVelocity=to.Unit*speed
    for _=1,2 do
        local c=camera.CFrame
        local at=c.Position+c.LookVector*(8+math.random()*8)+c.RightVector*(math.random()-.5)*14+c.UpVector*(math.random()-.5)*8
        local streak=part(effects,"Streak",Vector3.new(.05,.05,4),Color3.fromRGB(235,245,250),CFrame.lookAt(at,at+to.Unit))
        tween(streak,.2,{Transparency=1,Size=Vector3.new(.01,.01,6)});Debris:AddItem(streak,.25)
    end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="10">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <float name="Gravity">150</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>